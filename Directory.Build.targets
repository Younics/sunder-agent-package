<Project>
  <PropertyGroup Condition="'$(ContinuousIntegrationBuild)' == 'true' and '$(SunderPackageProject)' == 'true'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <Target Name="NormalizeAgentReleaseCompilerPaths" BeforeTargets="CoreCompile"
          DependsOnTargets="_SetPathMapFromSourceRoots"
          Condition="'$(ContinuousIntegrationBuild)' == 'true' and '$(SunderPackageRoleCompilationRoot)' != ''">
    <PropertyGroup>
      <PathMap>$(SunderPackageRoleCompilationRoot)=/_/generated/$(MSBuildProjectName)/$(SunderPackageCompilationRole),$(PathMap)</PathMap>
    </PropertyGroup>
  </Target>
  <PropertyGroup>
    <!-- Retain explicit historical tooling overrides, but never supply one in
         ordinary CI or a version-selected release. -->
    <Version Condition="'$(SunderAgentVersion)' != ''">$(SunderAgentVersion)</Version>
    <PackageVersion>$(Version)</PackageVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(SunderAgentCurrentPackageStorageKey)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)src/Sunder.Package.Agent.Shared/Storage/CurrentPackageStorageKey.cs"
             Link="Storage/CurrentPackageStorageKey.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)tests/Sunder.Package.Agent.TestAnalyzers/Sunder.Package.Agent.TestAnalyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <!-- A canonical package has multiple generated assembly identities. Keep the
       build dependency, but do not let editors substitute its combined source
       compilation for either role DLL. ResolveableAssembly also excludes the
       design-time BuildProjectReferences=true output from project references. -->
  <ItemGroup>
    <ProjectReference Update="@(ProjectReference->WithMetadataValue('Targets', 'GetSunderPackageRoleReference'))"
                      ReferenceOutputAssembly="false" OutputItemType="Reference" ResolveableAssembly="false" />
  </ItemGroup>

  <!-- Exact emitted-binding tests are tooling consumers. No authored package role
       receives a compile/runtime reference to the build implementation. -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true' and '$(SunderBuildToolingReference)' == 'true'">
    <PackageReference Include="Sunder.Package.Build" PrivateAssets="all" ExcludeAssets="all" GeneratePathProperty="true" />
    <Reference Include="Sunder.Package.Build">
      <HintPath>$(PkgSunder_Package_Build)/tasks/net10.0/Sunder.Package.Build.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(SunderPackageProject)' == 'true' or '$(SunderSdkReference)' == 'true'">
    <PackageReference Include="Sunder.Sdk" />
  </ItemGroup>

  <ItemGroup Condition="'$(SunderSdkStacksReference)' == 'true'">
    <PackageReference Include="Sunder.Sdk.Stacks" ExcludeAssets="buildTransitive" />
  </ItemGroup>

  <ItemGroup Condition="'$(SunderSdkAvaloniaReference)' == 'true'">
    <PackageReference Include="Sunder.Sdk.Avalonia" />
  </ItemGroup>

  <ItemGroup Condition="'$(SunderSdkWorkerReference)' == 'true'">
    <PackageReference Include="Sunder.Sdk.Worker" />
  </ItemGroup>

  <ItemGroup Condition="'$(SunderPackageProject)' == 'true' or '$(SunderPackageBuildReference)' == 'true'">
    <PackageReference Include="Sunder.Package.Build" PrivateAssets="all" />
  </ItemGroup>

  <!-- These are byte sources for existing local selections, not selection
       defaults for Add/Update/Implement commands. No private scratch cache is
       required; ordinary restore populates the normal user cache. -->
  <PropertyGroup Condition="'$(MSBuildIsRestoring)' == 'true' and '$(SunderPackageProject)' == 'true'">
    <SunderContractInputsRoot Condition="'$(SunderContractInputsRoot)' == ''">$(MSBuildThisFileDirectory).sunder/contract-inputs</SunderContractInputsRoot>
    <SunderPlatformCatalogPath Condition="'$(SunderPlatformCatalogPath)' == ''">$(SunderContractInputsRoot)/sunder-platform-contracts.v1.json</SunderPlatformCatalogPath>
  </PropertyGroup>

  <Target Name="ValidateAgentPackageRole"
          BeforeTargets="_GenerateRestoreProjectPathWalk;CollectPackageReferences;PrepareForBuild">
    <Error Condition="'$(SunderPackageRole)' != '' and '$(SunderPackageRole)' != 'test'"
           Text="SunderPackageRole must be unset for canonical package projects or 'test' for test projects, but was '$(SunderPackageRole)'." />
    <Error Condition="'$(SunderPackageRole)' != '' and '$(SunderPackageFamilyId)' == ''"
           Text="SunderPackageFamilyId is required when SunderPackageRole is set." />
  </Target>

  <!-- NuGet excludes PackageReference build imports during restore. Resolve the
       same centrally pinned tooling SDK explicitly on that cold path; ordinary
       warm builds already imported these targets from PackageReference. -->
  <Import Project="../buildTransitive/Sunder.Package.Build.targets" Sdk="Sunder.Package.Build"
          Condition="('$(SunderPackageProject)' == 'true' or '$(SunderPackageBuildReference)' == 'true') and '$(_SunderPackageBuildTargetsImported)' != 'true'" />
</Project>
