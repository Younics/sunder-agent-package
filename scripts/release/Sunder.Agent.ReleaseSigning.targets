<Project>
  <Target Name="SignSunderAgentReleaseWorkerAppHost">
    <ItemGroup>
      <_SunderAgentReleaseAppHost Include="@(SunderPackageWorkerSigningFile)"
                                  Condition="'%(SunderPackageWorkerSigningFile.RelativePath)' == '$(SunderPackageWorkerEntryPointRelativePath)'" />
    </ItemGroup>
    <PropertyGroup>
      <_SunderAgentReleaseAppHostCount>@(_SunderAgentReleaseAppHost->Count())</_SunderAgentReleaseAppHostCount>
    </PropertyGroup>
    <Error Condition="'$(_SunderAgentReleaseAppHostCount)' != '1'"
           Text="Release signing requires exactly one official worker apphost, but found $(_SunderAgentReleaseAppHostCount)." />
    <Error Condition="'$(SunderAgentReleaseSigningScript)' == '' or !Exists('$(SunderAgentReleaseSigningScript)')"
           Text="SunderAgentReleaseSigningScript must identify the checked-in release signer." />
    <Exec Command="pwsh -NoLogo -NoProfile -NonInteractive -File &quot;$(SunderAgentReleaseSigningScript)&quot; -Path &quot;%(_SunderAgentReleaseAppHost.FullPath)&quot; -Rid &quot;$(RuntimeIdentifier)&quot; -Mode Sign" />
  </Target>
</Project>
