<Project>
  <ItemGroup Condition="'$(SunderAgentNativeReleaseTestSource)' != '' and '$(MSBuildProjectName)' == 'Sunder.Runtime.Host.Tests'">
    <_AgentNativeAppHookSource Include="$([System.IO.Path]::GetDirectoryName('$(SunderAgentNativeReleaseTestSource)'))/NativeAppRpcStartupHook.cs;
                                        $([System.IO.Path]::GetDirectoryName('$(SunderAgentNativeReleaseTestSource)'))/McpAppSyntaxProbe.cs;
                                        $([System.IO.Path]::GetDirectoryName('$(SunderAgentNativeReleaseTestSource)'))/NativeAppSnapshotProbe.cs" />
    <Compile Include="$(SunderAgentNativeReleaseTestSource)"
              Link="AgentNativeReleaseSmokeTests.agent-release.cs" />
    <Compile Include="$([System.IO.Path]::GetDirectoryName('$(SunderAgentNativeReleaseTestSource)'))/AgentNativeReleaseSmokeTests.Maker.cs"
             Link="AgentNativeReleaseSmokeTests.Maker.agent-release.cs" />
    <Compile Include="$([System.IO.Path]::GetDirectoryName('$(SunderAgentNativeReleaseTestSource)'))/AgentNativeReleaseSmokeTests.Development.cs"
             Link="AgentNativeReleaseSmokeTests.Development.agent-release.cs" />
    <Compile Include="$([System.IO.Path]::GetDirectoryName('$(SunderAgentNativeReleaseTestSource)'))/AgentNativeReleaseSmokeTests.AppRpc.cs"
             Link="AgentNativeReleaseSmokeTests.AppRpc.agent-release.cs" />
    <Reference Include="Sunder.App" HintPath="$(SunderAgentNativeAppTargetPath)" Private="false"
               Condition="'$(SunderAgentNativeAppTargetPath)' != ''" />
    <_AgentNativeAppTargetPath Include="$(SunderAgentNativeAppTargetPath)" Condition="'$(SunderAgentNativeAppTargetPath)' != ''" />
  </ItemGroup>
  <Target Name="BuildAgentNativeAppRpcStartupHook" AfterTargets="Build" DependsOnTargets="ResolveReferences"
          Condition="'$(SunderAgentNativeReleaseTestSource)' != '' and '$(MSBuildProjectName)' == 'Sunder.Runtime.Host.Tests'"
          Inputs="$(MSBuildThisFileFullPath);@(_AgentNativeAppHookSource);@(_AgentNativeAppTargetPath);$(SunderAgentNativeAppLaunchPath);@(ReferencePathWithRefAssemblies)"
          Outputs="$(TargetDir)agent-native-app-hook/Sunder.App.Tests.dll">
    <Error Condition="'@(_AgentNativeAppTargetPath->Count())' != '1'" Text="Native App RPC requires one explicit Sunder.App target." />
    <MakeDir Directories="$(TargetDir)agent-native-app-hook" />
    <Csc Sources="@(_AgentNativeAppHookSource)"
         References="@(ReferencePathWithRefAssemblies)" OutputAssembly="$(TargetDir)agent-native-app-hook/Sunder.App.Tests.dll"
         TargetType="Library" TargetFramework="$(TargetFramework)" LangVersion="$(LangVersion)" Nullable="$(Nullable)"
         NoConfig="true" NoLogo="true" NoStandardLib="true" Deterministic="true" TreatWarningsAsErrors="true"
         ToolExe="$(CscToolExe)" ToolPath="$(CscToolPath)" />
  </Target>
  <Target Name="RecordNativeAppLaunchPath" AfterTargets="BuildAgentNativeAppRpcStartupHook"
          Condition="'$(SunderAgentNativeReleaseTestSource)' != '' and '$(MSBuildProjectName)' == 'Sunder.Runtime.Host.Tests'">
    <PropertyGroup>
      <SunderAgentNativeAppLaunchPath Condition="'$(SunderAgentNativeAppLaunchPath)' == ''">@(_AgentNativeAppTargetPath->'%(FullPath)')</SunderAgentNativeAppLaunchPath>
    </PropertyGroup>
    <WriteLinesToFile File="$(TargetDir)sunder-agent-native-app-target-path.txt" Lines="$(SunderAgentNativeAppLaunchPath)"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
