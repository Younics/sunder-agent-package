{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed Agent cold release inputs V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactSourceCommit", "lockSetSha256", "core", "candidates", "platformCatalog"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactSourceCommit": { "$ref": "#/$defs/commit" },
    "lockSetSha256": { "$ref": "#/$defs/sha256" },
    "core": {
      "type": "object", "additionalProperties": false,
      "required": ["artifactSourceCommit", "sdkVersion"],
      "properties": {
        "artifactSourceCommit": { "$ref": "#/$defs/commit" },
        "sdkVersion": { "const": "1.1.0" }
      }
    },
    "candidates": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["packageId", "version", "packageContentIdentity", "publicInventorySha256", "asset"],
        "properties": {
          "packageId": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
          "version": { "$ref": "#/$defs/version" },
          "packageContentIdentity": { "$ref": "#/$defs/sha256" },
          "publicInventorySha256": { "$ref": "#/$defs/sha256" },
          "asset": { "$ref": "#/$defs/asset" }
        }
      }
    },
    "platformCatalog": {
      "type": "object", "additionalProperties": false,
      "required": ["authorityId", "releaseVersion", "catalogSha256", "asset"],
      "properties": {
        "authorityId": { "const": "sunder.core" },
        "releaseVersion": { "$ref": "#/$defs/version" },
        "catalogSha256": { "$ref": "#/$defs/sha256" },
        "asset": { "$ref": "#/$defs/asset" }
      }
    }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "version": { "type": "string", "minLength": 5, "maxLength": 256 },
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "releaseId", "assetId", "name", "size", "sha256"],
      "properties": {
        "repository": { "enum": ["Younics/sunder-agent-package", "Younics/sunder-core"] },
        "releaseId": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "assetId": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,159}$" },
        "size": { "type": "integer", "minimum": 1, "maximum": 268435456 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
