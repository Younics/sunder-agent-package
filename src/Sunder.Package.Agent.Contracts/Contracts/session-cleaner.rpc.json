{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "descriptorVersion": 2,
  "schemaProfile": "sunder.rpc.values.v1",
  "contractId": "sunder.agent.session.cleaner",
  "version": "1.0.0",
  "errors": {},
  "services": {
    "session-cleaner": {
      "methods": {
        "describe": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/Unit"
          },
          "responseSchema": {
            "$ref": "#/$defs/AgentRpcIdentity"
          }
        },
        "delete-session": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/SessionIdRequest"
          },
          "responseSchema": {
            "$ref": "#/$defs/Unit"
          }
        }
      }
    }
  },
  "$defs": {
    "Unit": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "AgentRpcIdentity": {
      "type": "object",
      "properties": {
        "displayName": {
          "$ref": "#/$defs/DisplayText"
        },
        "id": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "displayName",
        "id"
      ],
      "additionalProperties": false
    },
    "EntityId": {
      "type": "string",
      "format": "uuid"
    },
    "SessionIdRequest": {
      "type": "object",
      "properties": {
        "sessionId": {
          "$ref": "#/$defs/EntityId"
        }
      },
      "required": [
        "sessionId"
      ],
      "additionalProperties": false
    },
    "Identifier": {
      "type": "string",
      "minLength": 1
    },
    "DisplayText": {
      "type": "string"
    }
  }
}
