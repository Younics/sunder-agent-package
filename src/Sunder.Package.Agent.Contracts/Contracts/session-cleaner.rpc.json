{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "descriptorVersion": 2,
  "contractId": "sunder.agent.session.cleaner",
  "version": "1.0.0",
  "errors": {},
  "services": {
    "session-cleaner": {
      "methods": {
        "describe": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/AgentRpcEmpty"
          },
          "responseSchema": {
            "$ref": "#/$defs/AgentRpcIdentity"
          }
        },
        "delete-session": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/SessionIdRequest"
          },
          "responseSchema": {
            "$ref": "#/$defs/AgentRpcEmpty"
          }
        }
      }
    }
  },
  "$defs": {
    "AgentRpcEmpty": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "String": {
      "type": "string",
      "minLength": 0,
      "maxLength": 1000000
    },
    "AgentRpcIdentity": {
      "type": "object",
      "properties": {
        "displayName": {
          "$ref": "#/$defs/String"
        },
        "id": {
          "$ref": "#/$defs/String"
        }
      },
      "required": [
        "displayName",
        "id"
      ],
      "additionalProperties": false
    },
    "Guid": {
      "type": "string",
      "logicalType": "uuid"
    },
    "SessionIdRequest": {
      "type": "object",
      "properties": {
        "sessionId": {
          "$ref": "#/$defs/Guid"
        }
      },
      "required": [
        "sessionId"
      ],
      "additionalProperties": false
    }
  }
}
