{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "descriptorVersion": 2,
  "schemaProfile": "sunder.rpc.values.v1",
  "contractId": "sunder.agent.workspace.editor",
  "version": "1.0.0",
  "errors": {},
  "services": {
    "workspace-editor": {
      "methods": {
        "describe": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/Unit"
          },
          "responseSchema": {
            "$ref": "#/$defs/AgentRpcIdentity"
          }
        },
        "can-edit": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/AgentWorkspaceEditorContext"
          },
          "responseSchema": {
            "$ref": "#/$defs/Flag"
          }
        },
        "get-sections": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/AgentWorkspaceEditorContext"
          },
          "responseSchema": {
            "$ref": "#/$defs/AgentEditorSectionCollection"
          }
        },
        "save-section": {
          "kind": "unary",
          "idempotency": "none",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/WorkspaceEditorSaveRequest"
          },
          "responseSchema": {
            "$ref": "#/$defs/AgentEditorSaveResult"
          }
        }
      }
    }
  },
  "$defs": {
    "Unit": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "TextValue": {
      "type": "string",
      "minLength": 0,
      "maxLength": 65536
    },
    "AgentRpcIdentity": {
      "type": "object",
      "properties": {
        "displayName": {
          "$ref": "#/$defs/DisplayText"
        },
        "id": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "displayName",
        "id"
      ],
      "additionalProperties": false
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "AgentWorkspaceDocumentRecord": {
      "type": "object",
      "properties": {
        "createdAtUtc": {
          "$ref": "#/$defs/Timestamp"
        },
        "documentId": {
          "$ref": "#/$defs/Identifier"
        },
        "filePath": {
          "$ref": "#/$defs/PathText"
        },
        "sortOrder": {
          "$ref": "#/$defs/SortOrder"
        },
        "updatedAtUtc": {
          "$ref": "#/$defs/Timestamp"
        },
        "workspaceId": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "createdAtUtc",
        "documentId",
        "filePath",
        "sortOrder",
        "updatedAtUtc",
        "workspaceId"
      ],
      "additionalProperties": false
    },
    "AgentWorkspaceDocumentRecordCollection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentWorkspaceDocumentRecord"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "Flag": {
      "type": "boolean"
    },
    "AgentWorkspacePathRecord": {
      "type": "object",
      "properties": {
        "createdAtUtc": {
          "$ref": "#/$defs/Timestamp"
        },
        "hostPath": {
          "$ref": "#/$defs/PathText"
        },
        "isDefault": {
          "$ref": "#/$defs/Flag"
        },
        "pathId": {
          "$ref": "#/$defs/Identifier"
        },
        "sortOrder": {
          "$ref": "#/$defs/SortOrder"
        },
        "updatedAtUtc": {
          "$ref": "#/$defs/Timestamp"
        },
        "workspaceId": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "createdAtUtc",
        "hostPath",
        "isDefault",
        "pathId",
        "sortOrder",
        "updatedAtUtc",
        "workspaceId"
      ],
      "additionalProperties": false
    },
    "AgentWorkspacePathRecordCollection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentWorkspacePathRecord"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "AgentWorkspaceRecord": {
      "type": "object",
      "properties": {
        "createdAtUtc": {
          "$ref": "#/$defs/Timestamp"
        },
        "description": {
          "$ref": "#/$defs/DisplayText"
        },
        "displayName": {
          "$ref": "#/$defs/DisplayText"
        },
        "documents": {
          "$ref": "#/$defs/AgentWorkspaceDocumentRecordCollection"
        },
        "paths": {
          "$ref": "#/$defs/AgentWorkspacePathRecordCollection"
        },
        "updatedAtUtc": {
          "$ref": "#/$defs/Timestamp"
        },
        "workspaceId": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "createdAtUtc",
        "displayName",
        "documents",
        "paths",
        "updatedAtUtc",
        "workspaceId"
      ],
      "additionalProperties": false
    },
    "AgentWorkspaceEditorContext": {
      "type": "object",
      "properties": {
        "configurationId": {
          "$ref": "#/$defs/Identifier"
        },
        "targetId": {
          "$ref": "#/$defs/Identifier"
        },
        "workspace": {
          "$ref": "#/$defs/AgentWorkspaceRecord"
        }
      },
      "required": [
        "configurationId",
        "targetId",
        "workspace"
      ],
      "additionalProperties": false
    },
    "AgentEditorActionKind": {
      "type": "string",
      "minLength": 13,
      "maxLength": 21,
      "enum": [
        "open-package-settings",
        "refresh-field"
      ]
    },
    "TextValueOrNull": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/TextValue"
        }
      ]
    },
    "EditorActionParameters": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/TextValueOrNull"
      },
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "minProperties": 0,
      "maxProperties": 256
    },
    "AgentEditorAction": {
      "type": "object",
      "properties": {
        "actionId": {
          "$ref": "#/$defs/Identifier"
        },
        "kind": {
          "$ref": "#/$defs/AgentEditorActionKind"
        },
        "label": {
          "$ref": "#/$defs/DisplayText"
        },
        "packageId": {
          "$ref": "#/$defs/Identifier"
        },
        "parameters": {
          "$ref": "#/$defs/EditorActionParameters"
        }
      },
      "required": [
        "actionId",
        "kind",
        "label"
      ],
      "additionalProperties": false
    },
    "AgentEditorActionCollection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentEditorAction"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "AgentEditorListItem": {
      "type": "object",
      "properties": {
        "isDefault": {
          "$ref": "#/$defs/Flag"
        },
        "itemId": {
          "$ref": "#/$defs/Identifier"
        },
        "secondaryValue": {
          "$ref": "#/$defs/TextValue"
        },
        "value": {
          "$ref": "#/$defs/TextValue"
        }
      },
      "required": [
        "isDefault",
        "itemId",
        "value"
      ],
      "additionalProperties": false
    },
    "AgentEditorListItemCollection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentEditorListItem"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "AgentEditorFieldKind": {
      "type": "string",
      "minLength": 4,
      "maxLength": 9,
      "enum": [
        "text",
        "select",
        "path-list"
      ]
    },
    "AgentEditorOption": {
      "type": "object",
      "properties": {
        "description": {
          "$ref": "#/$defs/DisplayText"
        },
        "label": {
          "$ref": "#/$defs/DisplayText"
        },
        "value": {
          "$ref": "#/$defs/TextValue"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "additionalProperties": false
    },
    "AgentEditorOptionCollection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentEditorOption"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "AgentEditorField": {
      "type": "object",
      "properties": {
        "actions": {
          "$ref": "#/$defs/AgentEditorActionCollection"
        },
        "addItemLabel": {
          "$ref": "#/$defs/DisplayText"
        },
        "defaultNewItemValue": {
          "$ref": "#/$defs/TextValue"
        },
        "defaultNewSecondaryItemValue": {
          "$ref": "#/$defs/TextValue"
        },
        "description": {
          "$ref": "#/$defs/DisplayText"
        },
        "fieldId": {
          "$ref": "#/$defs/Identifier"
        },
        "itemValueLabel": {
          "$ref": "#/$defs/DisplayText"
        },
        "items": {
          "$ref": "#/$defs/AgentEditorListItemCollection"
        },
        "kind": {
          "$ref": "#/$defs/AgentEditorFieldKind"
        },
        "label": {
          "$ref": "#/$defs/DisplayText"
        },
        "options": {
          "$ref": "#/$defs/AgentEditorOptionCollection"
        },
        "secondaryItemValueLabel": {
          "$ref": "#/$defs/DisplayText"
        },
        "useFolderPicker": {
          "$ref": "#/$defs/Flag"
        },
        "useSecondaryFolderPicker": {
          "$ref": "#/$defs/Flag"
        },
        "value": {
          "$ref": "#/$defs/TextValue"
        }
      },
      "required": [
        "fieldId",
        "kind",
        "label",
        "useFolderPicker",
        "useSecondaryFolderPicker"
      ],
      "additionalProperties": false
    },
    "AgentEditorFieldCollection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentEditorField"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "AgentEditorSection": {
      "type": "object",
      "properties": {
        "description": {
          "$ref": "#/$defs/DisplayText"
        },
        "fields": {
          "$ref": "#/$defs/AgentEditorFieldCollection"
        },
        "sectionId": {
          "$ref": "#/$defs/Identifier"
        },
        "title": {
          "$ref": "#/$defs/DisplayText"
        }
      },
      "required": [
        "fields",
        "sectionId",
        "title"
      ],
      "additionalProperties": false
    },
    "AgentEditorSectionCollection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentEditorSection"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "AgentEditorFieldValue": {
      "type": "object",
      "properties": {
        "items": {
          "$ref": "#/$defs/AgentEditorListItemCollection"
        },
        "value": {
          "$ref": "#/$defs/TextValue"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "EditorFieldValues": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/AgentEditorFieldValue"
      },
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "minProperties": 0,
      "maxProperties": 256
    },
    "AgentEditorSaveRequest": {
      "type": "object",
      "properties": {
        "fields": {
          "$ref": "#/$defs/EditorFieldValues"
        },
        "sectionId": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "fields",
        "sectionId"
      ],
      "additionalProperties": false
    },
    "WorkspaceEditorSaveRequest": {
      "type": "object",
      "properties": {
        "context": {
          "$ref": "#/$defs/AgentWorkspaceEditorContext"
        },
        "request": {
          "$ref": "#/$defs/AgentEditorSaveRequest"
        }
      },
      "required": [
        "context",
        "request"
      ],
      "additionalProperties": false
    },
    "AgentEditorSaveResult": {
      "type": "object",
      "properties": {
        "message": {
          "$ref": "#/$defs/DisplayText"
        },
        "success": {
          "$ref": "#/$defs/Flag"
        }
      },
      "required": [
        "message",
        "success"
      ],
      "additionalProperties": false
    },
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "PathText": {
      "type": "string",
      "minLength": 0,
      "maxLength": 4096
    },
    "DisplayText": {
      "type": "string",
      "minLength": 0,
      "maxLength": 8192
    },
    "SortOrder": {
      "type": "integer",
      "minimum": -100000,
      "maximum": 100000
    }
  }
}
