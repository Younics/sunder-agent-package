{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "descriptorVersion": 2,
  "schemaProfile": "sunder.rpc.values.v1",
  "contractId": "sunder.agent.workspace.path.migrator",
  "version": "1.0.0",
  "errors": {},
  "services": {
    "workspace-path-migrator": {
      "methods": {
        "describe": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/Unit"
          },
          "responseSchema": {
            "$ref": "#/$defs/AgentRpcIdentity"
          }
        },
        "can-migrate": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/AgentWorkspacePathMigrationContext"
          },
          "responseSchema": {
            "$ref": "#/$defs/Flag"
          }
        },
        "list-legacy-paths": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/AgentWorkspacePathMigrationContext"
          },
          "responseSchema": {
            "$ref": "#/$defs/AgentWorkspacePathMigrationItemCollection"
          }
        },
        "complete": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/AgentWorkspacePathMigrationContext"
          },
          "responseSchema": {
            "$ref": "#/$defs/Unit"
          }
        }
      }
    }
  },
  "$defs": {
    "Unit": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "AgentRpcIdentity": {
      "type": "object",
      "properties": {
        "displayName": {
          "$ref": "#/$defs/DisplayText"
        },
        "id": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "displayName",
        "id"
      ],
      "additionalProperties": false
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "Flag": {
      "type": "boolean"
    },
    "AgentWorkspaceBindingRecord": {
      "type": "object",
      "properties": {
        "bindingId": {
          "$ref": "#/$defs/Identifier"
        },
        "contributionId": {
          "$ref": "#/$defs/Identifier"
        },
        "createdAtUtc": {
          "$ref": "#/$defs/Timestamp"
        },
        "extensionPointId": {
          "$ref": "#/$defs/Identifier"
        },
        "isEnabled": {
          "$ref": "#/$defs/Flag"
        },
        "role": {
          "$ref": "#/$defs/Identifier"
        },
        "sortOrder": {
          "$ref": "#/$defs/SortOrder"
        },
        "updatedAtUtc": {
          "$ref": "#/$defs/Timestamp"
        },
        "workspaceId": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "bindingId",
        "contributionId",
        "createdAtUtc",
        "extensionPointId",
        "isEnabled",
        "role",
        "sortOrder",
        "updatedAtUtc",
        "workspaceId"
      ],
      "additionalProperties": false
    },
    "AgentWorkspaceDocumentRecord": {
      "type": "object",
      "properties": {
        "createdAtUtc": {
          "$ref": "#/$defs/Timestamp"
        },
        "documentId": {
          "$ref": "#/$defs/Identifier"
        },
        "filePath": {
          "$ref": "#/$defs/PathText"
        },
        "sortOrder": {
          "$ref": "#/$defs/SortOrder"
        },
        "updatedAtUtc": {
          "$ref": "#/$defs/Timestamp"
        },
        "workspaceId": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "createdAtUtc",
        "documentId",
        "filePath",
        "sortOrder",
        "updatedAtUtc",
        "workspaceId"
      ],
      "additionalProperties": false
    },
    "AgentWorkspaceDocumentRecordCollection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentWorkspaceDocumentRecord"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "AgentWorkspacePathRecord": {
      "type": "object",
      "properties": {
        "createdAtUtc": {
          "$ref": "#/$defs/Timestamp"
        },
        "hostPath": {
          "$ref": "#/$defs/PathText"
        },
        "isDefault": {
          "$ref": "#/$defs/Flag"
        },
        "pathId": {
          "$ref": "#/$defs/Identifier"
        },
        "sortOrder": {
          "$ref": "#/$defs/SortOrder"
        },
        "updatedAtUtc": {
          "$ref": "#/$defs/Timestamp"
        },
        "workspaceId": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "createdAtUtc",
        "hostPath",
        "isDefault",
        "pathId",
        "sortOrder",
        "updatedAtUtc",
        "workspaceId"
      ],
      "additionalProperties": false
    },
    "AgentWorkspacePathRecordCollection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentWorkspacePathRecord"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "AgentWorkspaceRecord": {
      "type": "object",
      "properties": {
        "createdAtUtc": {
          "$ref": "#/$defs/Timestamp"
        },
        "description": {
          "$ref": "#/$defs/DisplayText"
        },
        "displayName": {
          "$ref": "#/$defs/DisplayText"
        },
        "documents": {
          "$ref": "#/$defs/AgentWorkspaceDocumentRecordCollection"
        },
        "paths": {
          "$ref": "#/$defs/AgentWorkspacePathRecordCollection"
        },
        "updatedAtUtc": {
          "$ref": "#/$defs/Timestamp"
        },
        "workspaceId": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "createdAtUtc",
        "displayName",
        "documents",
        "paths",
        "updatedAtUtc",
        "workspaceId"
      ],
      "additionalProperties": false
    },
    "AgentWorkspacePathMigrationContext": {
      "type": "object",
      "properties": {
        "binding": {
          "$ref": "#/$defs/AgentWorkspaceBindingRecord"
        },
        "workspace": {
          "$ref": "#/$defs/AgentWorkspaceRecord"
        }
      },
      "required": [
        "binding",
        "workspace"
      ],
      "additionalProperties": false
    },
    "AgentWorkspacePathMigrationItem": {
      "type": "object",
      "properties": {
        "hostPath": {
          "$ref": "#/$defs/PathText"
        },
        "isDefault": {
          "$ref": "#/$defs/Flag"
        },
        "sortOrder": {
          "$ref": "#/$defs/SortOrder"
        }
      },
      "required": [
        "hostPath",
        "isDefault",
        "sortOrder"
      ],
      "additionalProperties": false
    },
    "AgentWorkspacePathMigrationItemCollection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentWorkspacePathMigrationItem"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "PathText": {
      "type": "string",
      "minLength": 0,
      "maxLength": 4096
    },
    "DisplayText": {
      "type": "string",
      "minLength": 0,
      "maxLength": 8192
    },
    "SortOrder": {
      "type": "integer",
      "minimum": -100000,
      "maximum": 100000
    }
  }
}
