{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "descriptorVersion": 2,
  "schemaProfile": "sunder.rpc.values.v1",
  "contractId": "sunder.agent.child.run.executor",
  "version": "1.0.0",
  "errors": {},
  "services": {
    "child-run-executor": {
      "methods": {
        "run-child": {
          "kind": "unary",
          "idempotency": "none",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/AgentChildRunRequest"
          },
          "responseSchema": {
            "$ref": "#/$defs/AgentChildRunResult"
          }
        }
      }
    }
  },
  "$defs": {
    "TextValue": {
      "type": "string",
      "minLength": 0,
      "maxLength": 65536
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "Flag": {
      "type": "boolean"
    },
    "AgentProfileModelBindingRecord": {
      "type": "object",
      "properties": {
        "capabilityKind": {
          "$ref": "#/$defs/TextValue"
        },
        "modelId": {
          "$ref": "#/$defs/Identifier"
        },
        "profileId": {
          "$ref": "#/$defs/Identifier"
        },
        "providerId": {
          "$ref": "#/$defs/Identifier"
        },
        "settingsJson": {
          "$ref": "#/$defs/JsonText"
        },
        "updatedAtUtc": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "capabilityKind",
        "profileId",
        "updatedAtUtc"
      ],
      "additionalProperties": false
    },
    "AgentProfileModelBindingRecordCollection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentProfileModelBindingRecord"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "AgentProfileSelectableCapabilityAssignmentRecord": {
      "type": "object",
      "properties": {
        "capabilityId": {
          "$ref": "#/$defs/Identifier"
        },
        "kind": {
          "$ref": "#/$defs/Identifier"
        },
        "sourceId": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "capabilityId",
        "kind"
      ],
      "additionalProperties": false
    },
    "AgentProfileSelectableCapabilityAssignmentRecordCollection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentProfileSelectableCapabilityAssignmentRecord"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "AgentProfileRecord": {
      "type": "object",
      "properties": {
        "behaviorLoopId": {
          "$ref": "#/$defs/Identifier"
        },
        "behaviorLoopSettingsJson": {
          "$ref": "#/$defs/JsonText"
        },
        "behaviorLoopSourceId": {
          "$ref": "#/$defs/Identifier"
        },
        "chatModelId": {
          "$ref": "#/$defs/Identifier"
        },
        "chatProviderId": {
          "$ref": "#/$defs/Identifier"
        },
        "createdAtUtc": {
          "$ref": "#/$defs/Timestamp"
        },
        "description": {
          "$ref": "#/$defs/DisplayText"
        },
        "displayName": {
          "$ref": "#/$defs/DisplayText"
        },
        "embeddingModelId": {
          "$ref": "#/$defs/Identifier"
        },
        "embeddingProviderId": {
          "$ref": "#/$defs/Identifier"
        },
        "instructions": {
          "$ref": "#/$defs/ContentText"
        },
        "isInternal": {
          "$ref": "#/$defs/Flag"
        },
        "modelBindings": {
          "$ref": "#/$defs/AgentProfileModelBindingRecordCollection"
        },
        "profileId": {
          "$ref": "#/$defs/Identifier"
        },
        "selectableCapabilityAssignments": {
          "$ref": "#/$defs/AgentProfileSelectableCapabilityAssignmentRecordCollection"
        },
        "updatedAtUtc": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "createdAtUtc",
        "displayName",
        "isInternal",
        "profileId",
        "updatedAtUtc"
      ],
      "additionalProperties": false
    },
    "EntityId": {
      "type": "string",
      "format": "uuid"
    },
    "AgentChildRunRequest": {
      "type": "object",
      "properties": {
        "agentKind": {
          "$ref": "#/$defs/TextValue"
        },
        "childProfile": {
          "$ref": "#/$defs/AgentProfileRecord"
        },
        "parentRunId": {
          "$ref": "#/$defs/EntityId"
        },
        "parentRunRevision": {
          "$ref": "#/$defs/Revision"
        },
        "parentSessionId": {
          "$ref": "#/$defs/EntityId"
        },
        "parentToolCallId": {
          "$ref": "#/$defs/Identifier"
        },
        "taskId": {
          "$ref": "#/$defs/Identifier"
        },
        "title": {
          "$ref": "#/$defs/DisplayText"
        },
        "userMessage": {
          "$ref": "#/$defs/ContentText"
        },
        "workspaceId": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "agentKind",
        "childProfile",
        "parentRunId",
        "parentRunRevision",
        "parentSessionId",
        "parentToolCallId",
        "title",
        "userMessage",
        "workspaceId"
      ],
      "additionalProperties": false
    },
    "AgentRunStatus": {
      "type": "string",
      "minLength": 4,
      "maxLength": 20,
      "enum": [
        "idle",
        "running",
        "interrupted",
        "stopped",
        "completed",
        "failed",
        "waiting-for-approval"
      ]
    },
    "AgentChildRunResult": {
      "type": "object",
      "properties": {
        "content": {
          "$ref": "#/$defs/ContentText"
        },
        "sessionId": {
          "$ref": "#/$defs/EntityId"
        },
        "status": {
          "$ref": "#/$defs/AgentRunStatus"
        },
        "summary": {
          "$ref": "#/$defs/DisplayText"
        },
        "title": {
          "$ref": "#/$defs/DisplayText"
        }
      },
      "required": [
        "sessionId",
        "status",
        "summary"
      ],
      "additionalProperties": false
    },
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "DisplayText": {
      "type": "string",
      "minLength": 0,
      "maxLength": 8192
    },
    "ContentText": {
      "type": "string",
      "minLength": 0,
      "maxLength": 900000
    },
    "JsonText": {
      "type": "string",
      "minLength": 0,
      "maxLength": 900000,
      "description": "Bounded opaque JSON text that may be malformed, truncated, or interpreted by an extension-owned schema."
    },
    "Revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
