{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "descriptorVersion": 2,
  "schemaProfile": "sunder.rpc.values.v1",
  "contractId": "sunder.agent.profile.capability.consumer",
  "version": "1.0.0",
  "errors": {},
  "services": {
    "profile-capability-consumer": {
      "methods": {
        "describe": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/Unit"
          },
          "responseSchema": {
            "$ref": "#/$defs/ProfileCapabilityConsumerSnapshot"
          }
        }
      }
    }
  },
  "$defs": {
    "Unit": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "TextValue": {
      "type": "string",
      "minLength": 0,
      "maxLength": 65536
    },
    "AgentProfileCapabilityConsumerDescriptor": {
      "type": "object",
      "properties": {
        "capabilityKind": {
          "$ref": "#/$defs/TextValue"
        },
        "description": {
          "$ref": "#/$defs/DisplayText"
        },
        "displayName": {
          "$ref": "#/$defs/DisplayText"
        }
      },
      "required": [
        "capabilityKind",
        "description",
        "displayName"
      ],
      "additionalProperties": false
    },
    "AgentProfileCapabilityConsumerDescriptorCollection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentProfileCapabilityConsumerDescriptor"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "ProfileCapabilityConsumerSnapshot": {
      "type": "object",
      "properties": {
        "capabilities": {
          "$ref": "#/$defs/AgentProfileCapabilityConsumerDescriptorCollection"
        },
        "consumerId": {
          "$ref": "#/$defs/Identifier"
        },
        "displayName": {
          "$ref": "#/$defs/DisplayText"
        }
      },
      "required": [
        "capabilities",
        "consumerId",
        "displayName"
      ],
      "additionalProperties": false
    },
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "DisplayText": {
      "type": "string",
      "minLength": 0,
      "maxLength": 8192
    }
  }
}
