{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "descriptorVersion": 2,
  "schemaProfile": "sunder.rpc.values.v1",
  "contractId": "sunder.agent.workspace.execution.resolver",
  "version": "1.0.0",
  "errors": {},
  "services": {
    "workspace-execution-resolver": {
      "methods": {
        "list-workspaces": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/Unit"
          },
          "responseSchema": {
            "$ref": "#/$defs/AgentWorkspaceRecordCollection"
          }
        },
        "resolve": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/StringRequest"
          },
          "responseSchema": {
            "$ref": "#/$defs/AgentWorkspaceExecutionResolutionWire"
          }
        }
      }
    }
  },
  "$defs": {
    "Unit": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "TextValue": {
      "type": "string"
    },
    "AgentWorkspaceDocumentRecord": {
      "type": "object",
      "properties": {
        "createdAtUtc": {
          "$ref": "#/$defs/Timestamp"
        },
        "documentId": {
          "$ref": "#/$defs/Identifier"
        },
        "filePath": {
          "$ref": "#/$defs/PathText"
        },
        "sortOrder": {
          "$ref": "#/$defs/SortOrder"
        },
        "updatedAtUtc": {
          "$ref": "#/$defs/Timestamp"
        },
        "workspaceId": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "createdAtUtc",
        "documentId",
        "filePath",
        "sortOrder",
        "updatedAtUtc",
        "workspaceId"
      ],
      "additionalProperties": false
    },
    "AgentWorkspaceDocumentRecordCollection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentWorkspaceDocumentRecord"
      }
    },
    "Flag": {
      "type": "boolean"
    },
    "AgentWorkspacePathRecord": {
      "type": "object",
      "properties": {
        "createdAtUtc": {
          "$ref": "#/$defs/Timestamp"
        },
        "hostPath": {
          "$ref": "#/$defs/PathText"
        },
        "isDefault": {
          "$ref": "#/$defs/Flag"
        },
        "pathId": {
          "$ref": "#/$defs/Identifier"
        },
        "sortOrder": {
          "$ref": "#/$defs/SortOrder"
        },
        "updatedAtUtc": {
          "$ref": "#/$defs/Timestamp"
        },
        "workspaceId": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "createdAtUtc",
        "hostPath",
        "isDefault",
        "pathId",
        "sortOrder",
        "updatedAtUtc",
        "workspaceId"
      ],
      "additionalProperties": false
    },
    "AgentWorkspacePathRecordCollection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentWorkspacePathRecord"
      }
    },
    "AgentWorkspaceRecord": {
      "type": "object",
      "properties": {
        "createdAtUtc": {
          "$ref": "#/$defs/Timestamp"
        },
        "description": {
          "$ref": "#/$defs/DisplayText"
        },
        "displayName": {
          "$ref": "#/$defs/DisplayText"
        },
        "documents": {
          "$ref": "#/$defs/AgentWorkspaceDocumentRecordCollection"
        },
        "paths": {
          "$ref": "#/$defs/AgentWorkspacePathRecordCollection"
        },
        "updatedAtUtc": {
          "$ref": "#/$defs/Timestamp"
        },
        "workspaceId": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "createdAtUtc",
        "displayName",
        "documents",
        "paths",
        "updatedAtUtc",
        "workspaceId"
      ],
      "additionalProperties": false
    },
    "AgentWorkspaceRecordCollection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentWorkspaceRecord"
      }
    },
    "StringRequest": {
      "type": "object",
      "properties": {
        "value": {
          "$ref": "#/$defs/TextValue"
        }
      },
      "required": [
        "value"
      ],
      "additionalProperties": false
    },
    "AgentWorkspaceBindingRecord": {
      "type": "object",
      "properties": {
        "bindingId": {
          "$ref": "#/$defs/Identifier"
        },
        "contributionId": {
          "$ref": "#/$defs/Identifier"
        },
        "createdAtUtc": {
          "$ref": "#/$defs/Timestamp"
        },
        "extensionPointId": {
          "$ref": "#/$defs/Identifier"
        },
        "isEnabled": {
          "$ref": "#/$defs/Flag"
        },
        "role": {
          "$ref": "#/$defs/Identifier"
        },
        "sortOrder": {
          "$ref": "#/$defs/SortOrder"
        },
        "updatedAtUtc": {
          "$ref": "#/$defs/Timestamp"
        },
        "workspaceId": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "bindingId",
        "contributionId",
        "createdAtUtc",
        "extensionPointId",
        "isEnabled",
        "role",
        "sortOrder",
        "updatedAtUtc",
        "workspaceId"
      ],
      "additionalProperties": false
    },
    "EntityId": {
      "type": "string",
      "format": "uuid"
    },
    "AgentRpcProviderHandle": {
      "type": "object",
      "properties": {
        "abiSha256": {
          "$ref": "#/$defs/Sha256Text"
        },
        "activationEpoch": {
          "$ref": "#/$defs/Revision"
        },
        "activationId": {
          "$ref": "#/$defs/EntityId"
        },
        "contractId": {
          "$ref": "#/$defs/Identifier"
        },
        "contractVersion": {
          "$ref": "#/$defs/VersionText"
        },
        "descriptorSha256": {
          "$ref": "#/$defs/Sha256Text"
        },
        "endpointReference": {
          "$ref": "#/$defs/TextValue"
        },
        "packageId": {
          "$ref": "#/$defs/Identifier"
        },
        "packageVersion": {
          "$ref": "#/$defs/VersionText"
        },
        "providerId": {
          "$ref": "#/$defs/Identifier"
        },
        "sessionGeneration": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "abiSha256",
        "activationEpoch",
        "activationId",
        "contractId",
        "contractVersion",
        "descriptorSha256",
        "endpointReference",
        "packageId",
        "packageVersion",
        "providerId",
        "sessionGeneration"
      ],
      "additionalProperties": false
    },
    "TextValues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TextValue"
      }
    },
    "AgentExecutionScopeDescriptor": {
      "type": "object",
      "properties": {
        "defaultWorkingDirectory": {
          "$ref": "#/$defs/PathText"
        },
        "displayName": {
          "$ref": "#/$defs/DisplayText"
        },
        "pathStyleDescription": {
          "$ref": "#/$defs/PathText"
        },
        "workspacePaths": {
          "$ref": "#/$defs/TextValues"
        }
      },
      "required": [
        "displayName",
        "workspacePaths"
      ],
      "additionalProperties": false
    },
    "AgentExecutionTargetDescriptor": {
      "type": "object",
      "properties": {
        "description": {
          "$ref": "#/$defs/DisplayText"
        },
        "displayName": {
          "$ref": "#/$defs/DisplayText"
        },
        "facets": {
          "$ref": "#/$defs/TextValues"
        },
        "supportsFiles": {
          "$ref": "#/$defs/Flag"
        },
        "supportsShell": {
          "$ref": "#/$defs/Flag"
        },
        "targetId": {
          "$ref": "#/$defs/Identifier"
        },
        "targetKind": {
          "$ref": "#/$defs/TextValue"
        }
      },
      "required": [
        "displayName",
        "facets",
        "supportsFiles",
        "supportsShell",
        "targetId",
        "targetKind"
      ],
      "additionalProperties": false
    },
    "AgentWorkspaceExecutionResolutionWire": {
      "type": "object",
      "properties": {
        "binding": {
          "$ref": "#/$defs/AgentWorkspaceBindingRecord"
        },
        "executionTarget": {
          "$ref": "#/$defs/AgentRpcProviderHandle"
        },
        "scope": {
          "$ref": "#/$defs/AgentExecutionScopeDescriptor"
        },
        "target": {
          "$ref": "#/$defs/AgentExecutionTargetDescriptor"
        },
        "workspace": {
          "$ref": "#/$defs/AgentWorkspaceRecord"
        }
      },
      "required": [
        "binding",
        "executionTarget",
        "scope",
        "target",
        "workspace"
      ],
      "additionalProperties": false
    },
    "Identifier": {
      "type": "string",
      "minLength": 1
    },
    "VersionText": {
      "type": "string",
      "minLength": 1
    },
    "PathText": {
      "type": "string"
    },
    "DisplayText": {
      "type": "string"
    },
    "Sha256Text": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "SortOrder": {
      "type": "integer"
    },
    "Revision": {
      "type": "integer",
      "minimum": 0
    }
  }
}
