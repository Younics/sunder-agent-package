{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "descriptorVersion": 2,
  "contractId": "sunder.agent.selectable.capability.provider",
  "version": "1.0.0",
  "errors": {},
  "services": {
    "selectable-capability-provider": {
      "methods": {
        "describe": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/AgentRpcEmpty"
          },
          "responseSchema": {
            "$ref": "#/$defs/AgentRpcIdentity"
          }
        },
        "list": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/AgentProfileSelectableCapabilityRequest"
          },
          "responseSchema": {
            "$ref": "#/$defs/ListOfAgentProfileSelectableCapabilityDescriptor"
          }
        },
        "watch": {
          "kind": "server-stream",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/AgentRpcEmpty"
          },
          "eventSchema": {
            "$ref": "#/$defs/AgentRpcChange"
          }
        }
      }
    }
  },
  "$defs": {
    "AgentRpcEmpty": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "String": {
      "type": "string",
      "minLength": 0,
      "maxLength": 1000000
    },
    "AgentRpcIdentity": {
      "type": "object",
      "properties": {
        "displayName": {
          "$ref": "#/$defs/String"
        },
        "id": {
          "$ref": "#/$defs/String"
        }
      },
      "required": [
        "displayName",
        "id"
      ],
      "additionalProperties": false
    },
    "DateTimeOffset": {
      "type": "string",
      "logicalType": "utc-date-time"
    },
    "Boolean": {
      "type": "boolean"
    },
    "AgentProfileModelBindingRecord": {
      "type": "object",
      "properties": {
        "capabilityKind": {
          "$ref": "#/$defs/String"
        },
        "modelId": {
          "$ref": "#/$defs/String"
        },
        "profileId": {
          "$ref": "#/$defs/String"
        },
        "providerId": {
          "$ref": "#/$defs/String"
        },
        "settingsJson": {
          "$ref": "#/$defs/String"
        },
        "updatedAtUtc": {
          "$ref": "#/$defs/DateTimeOffset"
        }
      },
      "required": [
        "capabilityKind",
        "profileId",
        "updatedAtUtc"
      ],
      "additionalProperties": false
    },
    "ListOfAgentProfileModelBindingRecord": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentProfileModelBindingRecord"
      },
      "minItems": 0,
      "maxItems": 1000000
    },
    "AgentProfileSelectableCapabilityAssignmentRecord": {
      "type": "object",
      "properties": {
        "capabilityId": {
          "$ref": "#/$defs/String"
        },
        "kind": {
          "$ref": "#/$defs/String"
        },
        "sourceId": {
          "$ref": "#/$defs/String"
        }
      },
      "required": [
        "capabilityId",
        "kind"
      ],
      "additionalProperties": false
    },
    "ListOfAgentProfileSelectableCapabilityAssignmentRecord": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentProfileSelectableCapabilityAssignmentRecord"
      },
      "minItems": 0,
      "maxItems": 1000000
    },
    "AgentProfileRecord": {
      "type": "object",
      "properties": {
        "behaviorLoopId": {
          "$ref": "#/$defs/String"
        },
        "behaviorLoopSettingsJson": {
          "$ref": "#/$defs/String"
        },
        "behaviorLoopSourceId": {
          "$ref": "#/$defs/String"
        },
        "chatModelId": {
          "$ref": "#/$defs/String"
        },
        "chatProviderId": {
          "$ref": "#/$defs/String"
        },
        "createdAtUtc": {
          "$ref": "#/$defs/DateTimeOffset"
        },
        "description": {
          "$ref": "#/$defs/String"
        },
        "displayName": {
          "$ref": "#/$defs/String"
        },
        "embeddingModelId": {
          "$ref": "#/$defs/String"
        },
        "embeddingProviderId": {
          "$ref": "#/$defs/String"
        },
        "instructions": {
          "$ref": "#/$defs/String"
        },
        "isInternal": {
          "$ref": "#/$defs/Boolean"
        },
        "modelBindings": {
          "$ref": "#/$defs/ListOfAgentProfileModelBindingRecord"
        },
        "profileId": {
          "$ref": "#/$defs/String"
        },
        "selectableCapabilityAssignments": {
          "$ref": "#/$defs/ListOfAgentProfileSelectableCapabilityAssignmentRecord"
        },
        "updatedAtUtc": {
          "$ref": "#/$defs/DateTimeOffset"
        }
      },
      "required": [
        "createdAtUtc",
        "displayName",
        "isInternal",
        "profileId",
        "updatedAtUtc"
      ],
      "additionalProperties": false
    },
    "AgentProfileSelectableCapabilityRequest": {
      "type": "object",
      "properties": {
        "profile": {
          "$ref": "#/$defs/AgentProfileRecord"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "Int32": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647
    },
    "AgentProfileSelectableCapabilityDescriptor": {
      "type": "object",
      "properties": {
        "capabilityId": {
          "$ref": "#/$defs/String"
        },
        "description": {
          "$ref": "#/$defs/String"
        },
        "displayName": {
          "$ref": "#/$defs/String"
        },
        "groupDescription": {
          "$ref": "#/$defs/String"
        },
        "groupDisplayName": {
          "$ref": "#/$defs/String"
        },
        "groupId": {
          "$ref": "#/$defs/String"
        },
        "groupSortOrder": {
          "$ref": "#/$defs/Int32"
        },
        "isSelectable": {
          "$ref": "#/$defs/Boolean"
        },
        "kind": {
          "$ref": "#/$defs/String"
        },
        "sourceDisplayName": {
          "$ref": "#/$defs/String"
        },
        "sourceId": {
          "$ref": "#/$defs/String"
        },
        "statusText": {
          "$ref": "#/$defs/String"
        }
      },
      "required": [
        "capabilityId",
        "displayName",
        "groupSortOrder",
        "isSelectable",
        "kind"
      ],
      "additionalProperties": false
    },
    "ListOfAgentProfileSelectableCapabilityDescriptor": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentProfileSelectableCapabilityDescriptor"
      },
      "minItems": 0,
      "maxItems": 1000000
    },
    "Int64": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "AgentRpcChange": {
      "type": "object",
      "properties": {
        "revision": {
          "$ref": "#/$defs/Int64"
        }
      },
      "required": [
        "revision"
      ],
      "additionalProperties": false
    }
  }
}
