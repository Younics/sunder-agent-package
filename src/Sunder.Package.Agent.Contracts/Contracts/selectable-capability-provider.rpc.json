{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "descriptorVersion": 2,
  "schemaProfile": "sunder.rpc.values.v1",
  "contractId": "sunder.agent.selectable.capability.provider",
  "version": "1.0.0",
  "errors": {},
  "services": {
    "selectable-capability-provider": {
      "methods": {
        "describe": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/Unit"
          },
          "responseSchema": {
            "$ref": "#/$defs/AgentRpcIdentity"
          }
        },
        "list": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/AgentProfileSelectableCapabilityRequest"
          },
          "responseSchema": {
            "$ref": "#/$defs/AgentProfileSelectableCapabilityDescriptorCollection"
          }
        },
        "watch": {
          "kind": "server-stream",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/Unit"
          },
          "eventSchema": {
            "$ref": "#/$defs/AgentRpcChange"
          }
        }
      }
    }
  },
  "$defs": {
    "Unit": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "TextValue": {
      "type": "string",
      "minLength": 0,
      "maxLength": 65536
    },
    "AgentRpcIdentity": {
      "type": "object",
      "properties": {
        "displayName": {
          "$ref": "#/$defs/DisplayText"
        },
        "id": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "displayName",
        "id"
      ],
      "additionalProperties": false
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "Flag": {
      "type": "boolean"
    },
    "AgentProfileModelBindingRecord": {
      "type": "object",
      "properties": {
        "capabilityKind": {
          "$ref": "#/$defs/TextValue"
        },
        "modelId": {
          "$ref": "#/$defs/Identifier"
        },
        "profileId": {
          "$ref": "#/$defs/Identifier"
        },
        "providerId": {
          "$ref": "#/$defs/Identifier"
        },
        "settingsJson": {
          "$ref": "#/$defs/JsonText"
        },
        "updatedAtUtc": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "capabilityKind",
        "profileId",
        "updatedAtUtc"
      ],
      "additionalProperties": false
    },
    "AgentProfileModelBindingRecordCollection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentProfileModelBindingRecord"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "AgentProfileSelectableCapabilityAssignmentRecord": {
      "type": "object",
      "properties": {
        "capabilityId": {
          "$ref": "#/$defs/Identifier"
        },
        "kind": {
          "$ref": "#/$defs/Identifier"
        },
        "sourceId": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "capabilityId",
        "kind"
      ],
      "additionalProperties": false
    },
    "AgentProfileSelectableCapabilityAssignmentRecordCollection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentProfileSelectableCapabilityAssignmentRecord"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "AgentProfileRecord": {
      "type": "object",
      "properties": {
        "behaviorLoopId": {
          "$ref": "#/$defs/Identifier"
        },
        "behaviorLoopSettingsJson": {
          "$ref": "#/$defs/JsonText"
        },
        "behaviorLoopSourceId": {
          "$ref": "#/$defs/Identifier"
        },
        "chatModelId": {
          "$ref": "#/$defs/Identifier"
        },
        "chatProviderId": {
          "$ref": "#/$defs/Identifier"
        },
        "createdAtUtc": {
          "$ref": "#/$defs/Timestamp"
        },
        "description": {
          "$ref": "#/$defs/DisplayText"
        },
        "displayName": {
          "$ref": "#/$defs/DisplayText"
        },
        "embeddingModelId": {
          "$ref": "#/$defs/Identifier"
        },
        "embeddingProviderId": {
          "$ref": "#/$defs/Identifier"
        },
        "instructions": {
          "$ref": "#/$defs/ContentText"
        },
        "isInternal": {
          "$ref": "#/$defs/Flag"
        },
        "modelBindings": {
          "$ref": "#/$defs/AgentProfileModelBindingRecordCollection"
        },
        "profileId": {
          "$ref": "#/$defs/Identifier"
        },
        "selectableCapabilityAssignments": {
          "$ref": "#/$defs/AgentProfileSelectableCapabilityAssignmentRecordCollection"
        },
        "updatedAtUtc": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "createdAtUtc",
        "displayName",
        "isInternal",
        "profileId",
        "updatedAtUtc"
      ],
      "additionalProperties": false
    },
    "AgentProfileSelectableCapabilityRequest": {
      "type": "object",
      "properties": {
        "profile": {
          "$ref": "#/$defs/AgentProfileRecord"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "AgentProfileSelectableCapabilityDescriptor": {
      "type": "object",
      "properties": {
        "capabilityId": {
          "$ref": "#/$defs/Identifier"
        },
        "description": {
          "$ref": "#/$defs/DisplayText"
        },
        "displayName": {
          "$ref": "#/$defs/DisplayText"
        },
        "groupDescription": {
          "$ref": "#/$defs/DisplayText"
        },
        "groupDisplayName": {
          "$ref": "#/$defs/DisplayText"
        },
        "groupId": {
          "$ref": "#/$defs/Identifier"
        },
        "groupSortOrder": {
          "$ref": "#/$defs/SortOrder"
        },
        "isSelectable": {
          "$ref": "#/$defs/Flag"
        },
        "kind": {
          "$ref": "#/$defs/Identifier"
        },
        "sourceDisplayName": {
          "$ref": "#/$defs/DisplayText"
        },
        "sourceId": {
          "$ref": "#/$defs/Identifier"
        },
        "statusText": {
          "$ref": "#/$defs/DisplayText"
        }
      },
      "required": [
        "capabilityId",
        "displayName",
        "groupSortOrder",
        "isSelectable",
        "kind"
      ],
      "additionalProperties": false
    },
    "AgentProfileSelectableCapabilityDescriptorCollection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentProfileSelectableCapabilityDescriptor"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "AgentRpcChange": {
      "type": "object",
      "properties": {
        "revision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "revision"
      ],
      "additionalProperties": false
    },
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "DisplayText": {
      "type": "string",
      "minLength": 0,
      "maxLength": 8192
    },
    "ContentText": {
      "type": "string",
      "minLength": 0,
      "maxLength": 900000
    },
    "JsonText": {
      "type": "string",
      "minLength": 0,
      "maxLength": 900000,
      "description": "Bounded opaque JSON text that may be malformed, truncated, or interpreted by an extension-owned schema."
    },
    "SortOrder": {
      "type": "integer",
      "minimum": -100000,
      "maximum": 100000
    },
    "Revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
