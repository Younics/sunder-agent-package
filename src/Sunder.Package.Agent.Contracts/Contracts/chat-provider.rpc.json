{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "descriptorVersion": 2,
  "schemaProfile": "sunder.rpc.values.v1",
  "contractId": "sunder.agent.chat.provider",
  "version": "1.0.0",
  "errors": {},
  "services": {
    "chat-provider": {
      "methods": {
        "describe": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/Unit"
          },
          "responseSchema": {
            "$ref": "#/$defs/AgentProviderDescriptor"
          }
        },
        "list-models": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/Unit"
          },
          "responseSchema": {
            "$ref": "#/$defs/ChatModels"
          }
        },
        "get-readiness": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/Unit"
          },
          "responseSchema": {
            "$ref": "#/$defs/AgentProviderReadiness"
          }
        },
        "get-capabilities": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/ChatCapabilitiesRequest"
          },
          "responseSchema": {
            "$ref": "#/$defs/AgentProviderRunCapabilities"
          }
        },
        "resolve-utility-model": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/Unit"
          },
          "responseSchema": {
            "$ref": "#/$defs/UtilityModelResolution"
          }
        },
        "stream-chat": {
          "kind": "server-stream",
          "idempotency": "none",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/AgentChatStreamRequest"
          },
          "eventSchema": {
            "$ref": "#/$defs/AgentChatStreamEvent"
          }
        }
      }
    }
  },
  "$defs": {
    "Unit": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "TextValue": {
      "type": "string"
    },
    "ShortText": {
      "type": "string"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "CalendarDate": {
      "type": "string",
      "format": "date"
    },
    "SafeInteger": {
      "type": "integer"
    },
    "ChatOptionValue": {
      "type": "number",
      "format": "float32",
      "description": "A finite IEEE 754 binary32 Microsoft.Extensions.AI chat option."
    },
    "AgentAuthMode": {
      "type": "string",
      "enum": [
        "api-key",
        "codex-connected"
      ]
    },
    "SupportedAuthModes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentAuthMode"
      }
    },
    "AgentProviderDescriptor": {
      "type": "object",
      "properties": {
        "providerId": {
          "$ref": "#/$defs/Identifier"
        },
        "displayName": {
          "$ref": "#/$defs/DisplayText"
        },
        "supportedAuthModes": {
          "$ref": "#/$defs/SupportedAuthModes"
        },
        "supportsStreaming": {
          "type": "boolean"
        },
        "supportsInterruptibleRuns": {
          "type": "boolean"
        },
        "packageId": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "providerId",
        "displayName",
        "supportedAuthModes",
        "supportsStreaming",
        "supportsInterruptibleRuns"
      ],
      "additionalProperties": false
    },
    "AgentReasoningEffort": {
      "type": "string",
      "enum": [
        "none",
        "low",
        "medium",
        "high",
        "extra-high"
      ]
    },
    "AgentModelVariantDescriptor": {
      "type": "object",
      "properties": {
        "variantId": {
          "$ref": "#/$defs/Identifier"
        },
        "displayName": {
          "$ref": "#/$defs/DisplayText"
        },
        "description": {
          "$ref": "#/$defs/DisplayText"
        },
        "reasoningEffort": {
          "$ref": "#/$defs/AgentReasoningEffort"
        }
      },
      "required": [
        "variantId",
        "displayName"
      ],
      "additionalProperties": false
    },
    "ModelVariants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentModelVariantDescriptor"
      }
    },
    "AgentModelSpeedOptionDescriptor": {
      "type": "object",
      "properties": {
        "speedOptionId": {
          "$ref": "#/$defs/Identifier"
        },
        "displayName": {
          "$ref": "#/$defs/DisplayText"
        },
        "description": {
          "$ref": "#/$defs/DisplayText"
        }
      },
      "required": [
        "speedOptionId",
        "displayName"
      ],
      "additionalProperties": false
    },
    "ModelSpeedOptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentModelSpeedOptionDescriptor"
      }
    },
    "AgentModelModeOptionDescriptor": {
      "type": "object",
      "properties": {
        "modeOptionId": {
          "$ref": "#/$defs/Identifier"
        },
        "displayName": {
          "$ref": "#/$defs/DisplayText"
        },
        "description": {
          "$ref": "#/$defs/DisplayText"
        },
        "disablesReasoning": {
          "type": "boolean"
        }
      },
      "required": [
        "modeOptionId",
        "displayName",
        "disablesReasoning"
      ],
      "additionalProperties": false
    },
    "ModelModeOptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentModelModeOptionDescriptor"
      }
    },
    "AgentModelDescriptor": {
      "type": "object",
      "properties": {
        "modelId": {
          "$ref": "#/$defs/Identifier"
        },
        "displayName": {
          "$ref": "#/$defs/DisplayText"
        },
        "contextWindow": {
          "$ref": "#/$defs/TokenCount"
        },
        "maxOutputTokens": {
          "$ref": "#/$defs/TokenCount"
        },
        "isRecommended": {
          "type": "boolean"
        },
        "variants": {
          "$ref": "#/$defs/ModelVariants"
        },
        "speedOptions": {
          "$ref": "#/$defs/ModelSpeedOptions"
        },
        "modeOptions": {
          "$ref": "#/$defs/ModelModeOptions"
        },
        "releaseDate": {
          "$ref": "#/$defs/CalendarDate"
        }
      },
      "required": [
        "modelId",
        "displayName",
        "contextWindow",
        "maxOutputTokens",
        "isRecommended"
      ],
      "additionalProperties": false
    },
    "ChatModels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentModelDescriptor"
      }
    },
    "AgentProviderReadinessStatus": {
      "type": "string",
      "enum": [
        "ready",
        "needs-configuration",
        "failed"
      ]
    },
    "AgentProviderReadiness": {
      "type": "object",
      "properties": {
        "providerId": {
          "$ref": "#/$defs/Identifier"
        },
        "status": {
          "$ref": "#/$defs/AgentProviderReadinessStatus"
        },
        "message": {
          "$ref": "#/$defs/DisplayText"
        }
      },
      "required": [
        "providerId",
        "status",
        "message"
      ],
      "additionalProperties": false
    },
    "ChatCapabilitiesRequest": {
      "type": "object",
      "properties": {
        "modelId": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "AgentProviderRunCapabilities": {
      "type": "object",
      "properties": {
        "supportsNativeToolCalling": {
          "type": "boolean"
        },
        "supportsStreamingToolCalls": {
          "type": "boolean"
        },
        "supportsMultipleToolCalls": {
          "type": "boolean"
        },
        "summary": {
          "$ref": "#/$defs/DisplayText"
        },
        "supportsImageInput": {
          "type": "boolean"
        },
        "supportsPdfInput": {
          "type": "boolean"
        },
        "supportsAudioInput": {
          "type": "boolean"
        },
        "supportsVideoInput": {
          "type": "boolean"
        },
        "contextWindowTokens": {
          "$ref": "#/$defs/TokenCount"
        },
        "maxOutputTokens": {
          "$ref": "#/$defs/TokenCount"
        }
      },
      "required": [
        "supportsNativeToolCalling",
        "supportsStreamingToolCalls",
        "supportsMultipleToolCalls",
        "summary",
        "supportsImageInput",
        "supportsPdfInput",
        "supportsAudioInput",
        "supportsVideoInput"
      ],
      "additionalProperties": false
    },
    "UtilityModelResolution": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/ShortText"
        }
      ]
    },
    "ContentReference": {
      "type": "object",
      "logicalType": "content-reference"
    },
    "AgentChatMessage": {
      "type": "object",
      "properties": {
        "role": {
          "$ref": "#/$defs/Identifier"
        },
        "messageId": {
          "$ref": "#/$defs/Identifier"
        },
        "authorName": {
          "$ref": "#/$defs/TextValue"
        },
        "contents": {
          "$ref": "#/$defs/ChatContents"
        }
      },
      "required": [
        "role",
        "contents"
      ],
      "additionalProperties": false
    },
    "ChatMessages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentChatMessage"
      }
    },
    "AgentChatTool": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/TextValue"
        },
        "description": {
          "$ref": "#/$defs/DisplayText"
        },
        "jsonSchema": {
          "$ref": "#/$defs/JSONObject"
        }
      },
      "required": [
        "name",
        "jsonSchema"
      ],
      "additionalProperties": false
    },
    "ChatTools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentChatTool"
      }
    },
    "AgentChatOptions": {
      "type": "object",
      "properties": {
        "instructions": {
          "$ref": "#/$defs/ContentText"
        },
        "conversationId": {
          "$ref": "#/$defs/Identifier"
        },
        "modelId": {
          "$ref": "#/$defs/Identifier"
        },
        "temperature": {
          "$ref": "#/$defs/ChatOptionValue"
        },
        "maxOutputTokens": {
          "$ref": "#/$defs/TokenCount"
        },
        "topP": {
          "$ref": "#/$defs/ChatOptionValue"
        },
        "topK": {
          "$ref": "#/$defs/TopK"
        },
        "frequencyPenalty": {
          "$ref": "#/$defs/ChatOptionValue"
        },
        "presencePenalty": {
          "$ref": "#/$defs/ChatOptionValue"
        },
        "seed": {
          "$ref": "#/$defs/SafeInteger"
        },
        "allowMultipleToolCalls": {
          "type": "boolean"
        },
        "reasoningEffort": {
          "$ref": "#/$defs/ChatReasoningEffort"
        },
        "tools": {
          "$ref": "#/$defs/ChatTools"
        },
        "additionalProperties": {
          "$ref": "#/$defs/JsonValues"
        },
        "continuationHandle": {
          "$ref": "#/$defs/InlineContinuationBytes"
        }
      },
      "required": [
        "tools"
      ],
      "additionalProperties": false
    },
    "AgentChatStreamRequest": {
      "type": "object",
      "properties": {
        "providerId": {
          "$ref": "#/$defs/Identifier"
        },
        "modelId": {
          "$ref": "#/$defs/Identifier"
        },
        "messages": {
          "$ref": "#/$defs/ChatMessages"
        },
        "options": {
          "$ref": "#/$defs/AgentChatOptions"
        }
      },
      "required": [
        "providerId",
        "modelId",
        "messages",
        "options"
      ],
      "additionalProperties": false
    },
    "AgentChatUsage": {
      "type": "object",
      "properties": {
        "inputTokens": {
          "$ref": "#/$defs/TokenCount"
        },
        "outputTokens": {
          "$ref": "#/$defs/TokenCount"
        },
        "totalTokens": {
          "$ref": "#/$defs/TokenCount"
        },
        "cachedInputTokens": {
          "$ref": "#/$defs/TokenCount"
        },
        "reasoningTokens": {
          "$ref": "#/$defs/TokenCount"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "AgentChatContent": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "reasoning",
            "text",
            "tool-call",
            "tool-result",
            "usage",
            "content-reference",
            "error"
          ]
        },
        "text": {
          "$ref": "#/$defs/ContentText"
        },
        "protectedData": {
          "$ref": "#/$defs/ContentText"
        },
        "callId": {
          "$ref": "#/$defs/Identifier"
        },
        "name": {
          "$ref": "#/$defs/TextValue"
        },
        "json": {
          "$ref": "#/$defs/JSON"
        },
        "informationalOnly": {
          "type": "boolean"
        },
        "mediaType": {
          "$ref": "#/$defs/MediaType"
        },
        "contentUri": {
          "$ref": "#/$defs/AbsoluteUri"
        },
        "contentReference": {
          "$ref": "#/$defs/ContentReference"
        },
        "usage": {
          "$ref": "#/$defs/AgentChatUsage"
        },
        "errorCode": {
          "$ref": "#/$defs/TextValue"
        },
        "errorMessage": {
          "$ref": "#/$defs/DisplayText"
        }
      },
      "required": [
        "kind",
        "informationalOnly"
      ],
      "additionalProperties": false
    },
    "ChatContents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentChatContent"
      }
    },
    "AgentChatStreamEvent": {
      "oneOf": [
        {
          "$ref": "#/$defs/AgentChatUpdateEvent"
        },
        {
          "$ref": "#/$defs/AgentChatErrorEvent"
        }
      ]
    },
    "Identifier": {
      "type": "string",
      "minLength": 1
    },
    "MediaType": {
      "type": "string",
      "minLength": 1
    },
    "DisplayText": {
      "type": "string"
    },
    "ContentText": {
      "type": "string"
    },
    "AbsoluteUri": {
      "type": "string",
      "format": "uri"
    },
    "InlineContinuationBytes": {
      "type": "string",
      "contentEncoding": "base64"
    },
    "JSON": {},
    "JSONObject": {
      "type": "object"
    },
    "TopK": {
      "type": "integer",
      "minimum": 0
    },
    "TokenCount": {
      "type": "integer",
      "minimum": 0
    },
    "JsonValues": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/JSON"
      },
      "propertyNames": {
        "type": "string",
        "minLength": 1
      }
    },
    "AgentChatUpdateEvent": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "update"
        },
        "role": {
          "$ref": "#/$defs/Identifier"
        },
        "responseId": {
          "$ref": "#/$defs/Identifier"
        },
        "messageId": {
          "$ref": "#/$defs/Identifier"
        },
        "conversationId": {
          "$ref": "#/$defs/Identifier"
        },
        "modelId": {
          "$ref": "#/$defs/Identifier"
        },
        "finishReason": {
          "$ref": "#/$defs/DisplayText"
        },
        "createdAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "contentItems": {
          "$ref": "#/$defs/ChatContents"
        },
        "continuationHandle": {
          "$ref": "#/$defs/InlineContinuationBytes"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "AgentChatErrorEvent": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "error"
        },
        "errorCode": {
          "$ref": "#/$defs/TextValue"
        },
        "errorMessage": {
          "$ref": "#/$defs/DisplayText"
        },
        "errorContent": {
          "$ref": "#/$defs/ContentText"
        },
        "errorFailureKind": {
          "$ref": "#/$defs/AgentChatProviderFailureKind"
        }
      },
      "required": [
        "kind",
        "errorCode",
        "errorMessage",
        "errorContent",
        "errorFailureKind"
      ],
      "additionalProperties": false
    },
    "ChatReasoningEffort": {
      "type": "string",
      "enum": [
        "none",
        "low",
        "medium",
        "high",
        "extra-high"
      ]
    },
    "AgentChatProviderFailureKind": {
      "type": "string",
      "enum": [
        "unknown",
        "context-window-exceeded"
      ]
    }
  }
}
