{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "descriptorVersion": 2,
  "contractId": "sunder.agent.chat.provider",
  "version": "1.0.0",
  "errors": {
    "agent.chat.option-not-representable": {
      "description": "A numeric chat option cannot be represented losslessly by the provider-facing Microsoft.Extensions.AI ChatOptions binary32 field."
    }
  },
  "services": {
    "chat-provider": {
      "methods": {
        "describe": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/AgentRpcEmpty"
          },
          "responseSchema": {
            "$ref": "#/$defs/AgentProviderDescriptor"
          }
        },
        "list-models": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/AgentRpcEmpty"
          },
          "responseSchema": {
            "$ref": "#/$defs/AgentModelDescriptorList"
          }
        },
        "get-readiness": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/AgentRpcEmpty"
          },
          "responseSchema": {
            "$ref": "#/$defs/AgentProviderReadiness"
          }
        },
        "get-capabilities": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/ChatCapabilitiesRequest"
          },
          "responseSchema": {
            "$ref": "#/$defs/AgentProviderRunCapabilities"
          }
        },
        "resolve-utility-model": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/AgentRpcEmpty"
          },
          "responseSchema": {
            "$ref": "#/$defs/AgentRpcOptionalString"
          }
        },
        "stream-chat": {
          "kind": "server-stream",
          "idempotency": "none",
          "errors": [
            "agent.chat.option-not-representable"
          ],
          "requestSchema": {
            "$ref": "#/$defs/AgentChatStreamRequest"
          },
          "eventSchema": {
            "$ref": "#/$defs/AgentChatStreamEvent"
          }
        }
      }
    }
  },
  "$defs": {
    "AgentRpcEmpty": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "Text": {
      "type": "string",
      "minLength": 0,
      "maxLength": 1000000
    },
    "ShortText": {
      "type": "string",
      "minLength": 0,
      "maxLength": 2048
    },
    "Timestamp": {
      "type": "string",
      "logicalType": "utc-date-time"
    },
    "Date": {
      "type": "string",
      "minLength": 10,
      "maxLength": 10
    },
    "Int32": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647
    },
    "NonNegativeInt32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "SafeInteger": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "OptionNumber": {
      "type": "number",
      "minimum": -1000000,
      "maximum": 1000000,
      "description": "A finite binary64 wire value produced by losslessly widening a finite IEEE 754 binary32 chat option; other values fail with agent.chat.option-not-representable."
    },
    "AgentAuthMode": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1,
      "enum": [
        0,
        1
      ]
    },
    "AgentAuthModeList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentAuthMode"
      },
      "minItems": 0,
      "maxItems": 16
    },
    "AgentProviderDescriptor": {
      "type": "object",
      "properties": {
        "providerId": {
          "$ref": "#/$defs/ShortText"
        },
        "displayName": {
          "$ref": "#/$defs/ShortText"
        },
        "supportedAuthModes": {
          "$ref": "#/$defs/AgentAuthModeList"
        },
        "supportsStreaming": {
          "type": "boolean"
        },
        "supportsInterruptibleRuns": {
          "type": "boolean"
        },
        "packageId": {
          "$ref": "#/$defs/ShortText"
        }
      },
      "required": [
        "providerId",
        "displayName",
        "supportedAuthModes",
        "supportsStreaming",
        "supportsInterruptibleRuns"
      ],
      "additionalProperties": false
    },
    "AgentReasoningEffort": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4,
      "enum": [
        0,
        1,
        2,
        3,
        4
      ]
    },
    "AgentModelVariantDescriptor": {
      "type": "object",
      "properties": {
        "variantId": {
          "$ref": "#/$defs/ShortText"
        },
        "displayName": {
          "$ref": "#/$defs/ShortText"
        },
        "description": {
          "$ref": "#/$defs/Text"
        },
        "reasoningEffort": {
          "$ref": "#/$defs/AgentReasoningEffort"
        }
      },
      "required": [
        "variantId",
        "displayName"
      ],
      "additionalProperties": false
    },
    "AgentModelVariantDescriptorList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentModelVariantDescriptor"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "AgentModelSpeedOptionDescriptor": {
      "type": "object",
      "properties": {
        "speedOptionId": {
          "$ref": "#/$defs/ShortText"
        },
        "displayName": {
          "$ref": "#/$defs/ShortText"
        },
        "description": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "speedOptionId",
        "displayName"
      ],
      "additionalProperties": false
    },
    "AgentModelSpeedOptionDescriptorList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentModelSpeedOptionDescriptor"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "AgentModelModeOptionDescriptor": {
      "type": "object",
      "properties": {
        "modeOptionId": {
          "$ref": "#/$defs/ShortText"
        },
        "displayName": {
          "$ref": "#/$defs/ShortText"
        },
        "description": {
          "$ref": "#/$defs/Text"
        },
        "disablesReasoning": {
          "type": "boolean"
        }
      },
      "required": [
        "modeOptionId",
        "displayName",
        "disablesReasoning"
      ],
      "additionalProperties": false
    },
    "AgentModelModeOptionDescriptorList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentModelModeOptionDescriptor"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "AgentModelDescriptor": {
      "type": "object",
      "properties": {
        "modelId": {
          "$ref": "#/$defs/ShortText"
        },
        "displayName": {
          "$ref": "#/$defs/ShortText"
        },
        "contextWindow": {
          "$ref": "#/$defs/NonNegativeInt32"
        },
        "maxOutputTokens": {
          "$ref": "#/$defs/NonNegativeInt32"
        },
        "isRecommended": {
          "type": "boolean"
        },
        "variants": {
          "$ref": "#/$defs/AgentModelVariantDescriptorList"
        },
        "speedOptions": {
          "$ref": "#/$defs/AgentModelSpeedOptionDescriptorList"
        },
        "modeOptions": {
          "$ref": "#/$defs/AgentModelModeOptionDescriptorList"
        },
        "releaseDate": {
          "$ref": "#/$defs/Date"
        }
      },
      "required": [
        "modelId",
        "displayName",
        "contextWindow",
        "maxOutputTokens",
        "isRecommended"
      ],
      "additionalProperties": false
    },
    "AgentModelDescriptorList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentModelDescriptor"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "AgentProviderReadinessStatus": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2,
      "enum": [
        0,
        1,
        2
      ]
    },
    "AgentProviderReadiness": {
      "type": "object",
      "properties": {
        "providerId": {
          "$ref": "#/$defs/ShortText"
        },
        "status": {
          "$ref": "#/$defs/AgentProviderReadinessStatus"
        },
        "message": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "providerId",
        "status",
        "message"
      ],
      "additionalProperties": false
    },
    "ChatCapabilitiesRequest": {
      "type": "object",
      "properties": {
        "modelId": {
          "$ref": "#/$defs/ShortText"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "AgentProviderRunCapabilities": {
      "type": "object",
      "properties": {
        "supportsNativeToolCalling": {
          "type": "boolean"
        },
        "supportsStreamingToolCalls": {
          "type": "boolean"
        },
        "supportsMultipleToolCalls": {
          "type": "boolean"
        },
        "summary": {
          "$ref": "#/$defs/Text"
        },
        "supportsImageInput": {
          "type": "boolean"
        },
        "supportsPdfInput": {
          "type": "boolean"
        },
        "supportsAudioInput": {
          "type": "boolean"
        },
        "supportsVideoInput": {
          "type": "boolean"
        },
        "contextWindowTokens": {
          "$ref": "#/$defs/NonNegativeInt32"
        },
        "maxOutputTokens": {
          "$ref": "#/$defs/NonNegativeInt32"
        }
      },
      "required": [
        "supportsNativeToolCalling",
        "supportsStreamingToolCalls",
        "supportsMultipleToolCalls",
        "summary",
        "supportsImageInput",
        "supportsPdfInput",
        "supportsAudioInput",
        "supportsVideoInput"
      ],
      "additionalProperties": false
    },
    "AgentRpcOptionalString": {
      "type": "object",
      "properties": {
        "hasValue": {
          "type": "boolean"
        },
        "value": {
          "$ref": "#/$defs/ShortText"
        }
      },
      "required": [
        "hasValue"
      ],
      "additionalProperties": false
    },
    "SunderRpcContentRepeatability": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1,
      "enum": [
        0,
        1
      ]
    },
    "SunderRpcContentReference": {
      "type": "object",
      "logicalType": "content-reference"
    },
    "AgentChatMessage": {
      "type": "object",
      "properties": {
        "role": {
          "$ref": "#/$defs/ShortText"
        },
        "messageId": {
          "$ref": "#/$defs/ShortText"
        },
        "authorName": {
          "$ref": "#/$defs/ShortText"
        },
        "contents": {
          "$ref": "#/$defs/AgentChatContentList"
        }
      },
      "required": [
        "role",
        "contents"
      ],
      "additionalProperties": false
    },
    "AgentChatMessageList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentChatMessage"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "AgentChatTool": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/ShortText"
        },
        "description": {
          "$ref": "#/$defs/Text"
        },
        "jsonSchema": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "name",
        "jsonSchema"
      ],
      "additionalProperties": false
    },
    "AgentChatToolList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentChatTool"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "StringMap": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Text"
      },
      "propertyNames": {
        "type": "string",
        "minLength": 0,
        "maxLength": 2048
      },
      "minProperties": 0,
      "maxProperties": 10000
    },
    "AgentChatOptions": {
      "type": "object",
      "properties": {
        "instructions": {
          "$ref": "#/$defs/Text"
        },
        "conversationId": {
          "$ref": "#/$defs/ShortText"
        },
        "modelId": {
          "$ref": "#/$defs/ShortText"
        },
        "temperature": {
          "$ref": "#/$defs/OptionNumber"
        },
        "maxOutputTokens": {
          "$ref": "#/$defs/NonNegativeInt32"
        },
        "topP": {
          "$ref": "#/$defs/OptionNumber"
        },
        "topK": {
          "$ref": "#/$defs/Int32"
        },
        "frequencyPenalty": {
          "$ref": "#/$defs/OptionNumber"
        },
        "presencePenalty": {
          "$ref": "#/$defs/OptionNumber"
        },
        "seed": {
          "$ref": "#/$defs/SafeInteger"
        },
        "allowMultipleToolCalls": {
          "type": "boolean"
        },
        "reasoningEffort": {
          "$ref": "#/$defs/ShortText"
        },
        "tools": {
          "$ref": "#/$defs/AgentChatToolList"
        },
        "additionalProperties": {
          "$ref": "#/$defs/StringMap"
        },
        "continuationHandle": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "tools"
      ],
      "additionalProperties": false
    },
    "AgentChatStreamRequest": {
      "type": "object",
      "properties": {
        "providerId": {
          "$ref": "#/$defs/ShortText"
        },
        "modelId": {
          "$ref": "#/$defs/ShortText"
        },
        "messages": {
          "$ref": "#/$defs/AgentChatMessageList"
        },
        "options": {
          "$ref": "#/$defs/AgentChatOptions"
        }
      },
      "required": [
        "providerId",
        "modelId",
        "messages",
        "options"
      ],
      "additionalProperties": false
    },
    "AgentChatUsage": {
      "type": "object",
      "properties": {
        "inputTokens": {
          "$ref": "#/$defs/SafeInteger"
        },
        "outputTokens": {
          "$ref": "#/$defs/SafeInteger"
        },
        "totalTokens": {
          "$ref": "#/$defs/SafeInteger"
        },
        "cachedInputTokens": {
          "$ref": "#/$defs/SafeInteger"
        },
        "reasoningTokens": {
          "$ref": "#/$defs/SafeInteger"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "AgentChatContent": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 4,
          "maxLength": 17,
          "enum": [
            "reasoning",
            "text",
            "tool-call",
            "tool-result",
            "usage",
            "content-reference",
            "error"
          ]
        },
        "text": {
          "$ref": "#/$defs/Text"
        },
        "protectedData": {
          "$ref": "#/$defs/Text"
        },
        "callId": {
          "$ref": "#/$defs/ShortText"
        },
        "name": {
          "$ref": "#/$defs/ShortText"
        },
        "json": {
          "$ref": "#/$defs/Text"
        },
        "informationalOnly": {
          "type": "boolean"
        },
        "mediaType": {
          "$ref": "#/$defs/ShortText"
        },
        "contentUri": {
          "$ref": "#/$defs/Text"
        },
        "contentReference": {
          "$ref": "#/$defs/SunderRpcContentReference"
        },
        "usage": {
          "$ref": "#/$defs/AgentChatUsage"
        },
        "errorCode": {
          "$ref": "#/$defs/ShortText"
        },
        "errorMessage": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "kind",
        "informationalOnly"
      ],
      "additionalProperties": false
    },
    "AgentChatContentList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentChatContent"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "AgentChatStreamEvent": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 5,
          "maxLength": 6,
          "enum": [
            "update",
            "error"
          ]
        },
        "role": {
          "$ref": "#/$defs/ShortText"
        },
        "responseId": {
          "$ref": "#/$defs/ShortText"
        },
        "messageId": {
          "$ref": "#/$defs/ShortText"
        },
        "conversationId": {
          "$ref": "#/$defs/ShortText"
        },
        "modelId": {
          "$ref": "#/$defs/ShortText"
        },
        "finishReason": {
          "$ref": "#/$defs/ShortText"
        },
        "createdAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "contentItems": {
          "$ref": "#/$defs/AgentChatContentList"
        },
        "continuationHandle": {
          "$ref": "#/$defs/Text"
        },
        "errorCode": {
          "$ref": "#/$defs/ShortText"
        },
        "errorMessage": {
          "$ref": "#/$defs/Text"
        },
        "errorContent": {
          "$ref": "#/$defs/Text"
        },
        "errorFailureKind": {
          "$ref": "#/$defs/ShortText"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    }
  }
}
