            "$ref": "#/$defs/ExecutionShellRequest"
          },
          "responseSchema": {
            "$ref": "#/$defs/AgentShellCommandResult"
          }
        },
        "read-file": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/ExecutionFileReadRequest"
          },
          "responseSchema": {
            "$ref": "#/$defs/AgentFileReadResult"
          }
        },
        "write-file": {
          "kind": "unary",
          "idempotency": "none",
          "errors": [],
