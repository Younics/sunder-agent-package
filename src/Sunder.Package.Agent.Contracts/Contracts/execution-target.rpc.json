{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "descriptorVersion": 2,
  "schemaProfile": "sunder.rpc.values.v1",
  "contractId": "sunder.agent.execution.target",
  "version": "1.0.0",
