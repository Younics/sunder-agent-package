          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [
            "agent.execution.facet-unavailable"
          ],
          "requestSchema": {
            "$ref": "#/$defs/AgentExecutionTargetContextWire"
          },
          "responseSchema": {
            "$ref": "#/$defs/TextValues"
          }
        },
        "add-path": {
          "kind": "unary",
          "idempotency": "none",
          "errors": [
            "agent.execution.facet-unavailable"
          ],
          "requestSchema": {
            "$ref": "#/$defs/ExecutionPathRequest"
          },
          "responseSchema": {
            "$ref": "#/$defs/Unit"
          }
        },
        "legacy-file-search": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [
            "agent.execution.facet-unavailable"
          ],
          "requestSchema": {
            "$ref": "#/$defs/ExecutionFileSearchProcessRequest"
          },
          "responseSchema": {
            "$ref": "#/$defs/AgentFileSearchProcessResult"
          }
        },
        "structured-file-search": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [
            "agent.execution.facet-unavailable"
          ],
          "requestSchema": {
            "$ref": "#/$defs/ExecutionFileSearchRequest"
          },
          "responseSchema": {
            "$ref": "#/$defs/AgentFileSearchResult"
          }
        },
        "discover-instructions": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [
            "agent.execution.facet-unavailable"
          ],
          "requestSchema": {
            "$ref": "#/$defs/ExecutionInstructionDiscoveryRequest"
          },
          "responseSchema": {
            "$ref": "#/$defs/AgentScopedInstructionDiscoveryResult"
          }
        }
      }
    }
  },
