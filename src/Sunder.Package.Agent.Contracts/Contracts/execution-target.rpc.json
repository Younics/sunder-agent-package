          },
          "responseSchema": {
            "$ref": "#/$defs/AgentExecutionTargetDescriptor"
          }
        },
        "configuration-generation": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/AgentExecutionTargetContextWire"
          },
          "responseSchema": {
            "$ref": "#/$defs/ConfigurationGenerationResolution"
          }
        },
        "readiness": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/AgentExecutionTargetContextWire"
          },
          "responseSchema": {
            "$ref": "#/$defs/AgentExecutionTargetReadiness"
          }
        },
        "shell": {
          "kind": "unary",
          "idempotency": "idempotent",
