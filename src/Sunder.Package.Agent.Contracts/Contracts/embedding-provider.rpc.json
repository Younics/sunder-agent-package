{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "descriptorVersion": 2,
  "schemaProfile": "sunder.rpc.values.v1",
  "contractId": "sunder.agent.embedding.provider",
  "version": "1.0.0",
  "errors": {},
  "services": {
    "embedding-provider": {
      "methods": {
        "describe": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/Unit"
          },
          "responseSchema": {
            "$ref": "#/$defs/AgentEmbeddingProviderDescriptor"
          }
        },
        "list-models": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/Unit"
          },
          "responseSchema": {
            "$ref": "#/$defs/AgentEmbeddingModelDescriptorCollection"
          }
        },
        "get-readiness": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/Unit"
          },
          "responseSchema": {
            "$ref": "#/$defs/AgentEmbeddingProviderReadiness"
          }
        },
        "space-identity": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/StringRequest"
          },
          "responseSchema": {
            "$ref": "#/$defs/TextValue"
          }
        },
        "generate": {
          "kind": "unary",
          "idempotency": "none",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/EmbeddingRequest"
          },
          "responseSchema": {
            "$ref": "#/$defs/EmbeddingGenerationResult"
          }
        },
        "generate-batch": {
          "kind": "unary",
          "idempotency": "none",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/EmbeddingBatchRequest"
          },
          "responseSchema": {
            "$ref": "#/$defs/EmbeddingBatchResults"
          }
        }
      }
    }
  },
  "$defs": {
    "Unit": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "TextValue": {
      "type": "string"
    },
    "AgentAuthMode": {
      "type": "string",
      "enum": [
        "api-key",
        "codex-connected"
      ]
    },
    "AgentAuthModeCollection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentAuthMode"
      }
    },
    "AgentEmbeddingProviderDescriptor": {
      "type": "object",
      "properties": {
        "displayName": {
          "$ref": "#/$defs/DisplayText"
        },
        "packageId": {
          "$ref": "#/$defs/Identifier"
        },
        "providerId": {
          "$ref": "#/$defs/Identifier"
        },
        "supportedAuthModes": {
          "$ref": "#/$defs/AgentAuthModeCollection"
        }
      },
      "required": [
        "displayName",
        "providerId",
        "supportedAuthModes"
      ],
      "additionalProperties": false
    },
    "Flag": {
      "type": "boolean"
    },
    "AgentEmbeddingModelDescriptor": {
      "type": "object",
      "properties": {
        "dimensions": {
          "$ref": "#/$defs/EmbeddingDimensions"
        },
        "displayName": {
          "$ref": "#/$defs/DisplayText"
        },
        "isRecommended": {
          "$ref": "#/$defs/Flag"
        },
        "modelId": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "displayName",
        "isRecommended",
        "modelId"
      ],
      "additionalProperties": false
    },
    "AgentEmbeddingModelDescriptorCollection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentEmbeddingModelDescriptor"
      }
    },
    "AgentProviderReadinessStatus": {
      "type": "string",
      "enum": [
        "ready",
        "needs-configuration",
        "failed"
      ]
    },
    "AgentEmbeddingProviderReadiness": {
      "type": "object",
      "properties": {
        "message": {
          "$ref": "#/$defs/DisplayText"
        },
        "providerId": {
          "$ref": "#/$defs/Identifier"
        },
        "status": {
          "$ref": "#/$defs/AgentProviderReadinessStatus"
        }
      },
      "required": [
        "message",
        "providerId",
        "status"
      ],
      "additionalProperties": false
    },
    "StringRequest": {
      "type": "object",
      "properties": {
        "value": {
          "$ref": "#/$defs/TextValue"
        }
      },
      "required": [
        "value"
      ],
      "additionalProperties": false
    },
    "EmbeddingRequest": {
      "type": "object",
      "properties": {
        "modelId": {
          "$ref": "#/$defs/Identifier"
        },
        "text": {
          "$ref": "#/$defs/TextValue"
        }
      },
      "required": [
        "modelId",
        "text"
      ],
      "additionalProperties": false
    },
    "EmbeddingValue": {
      "type": "number",
      "format": "float64"
    },
    "EmbeddingVector": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EmbeddingValue"
      }
    },
    "AgentEmbeddingGenerationResult": {
      "type": "object",
      "properties": {
        "dimensions": {
          "$ref": "#/$defs/EmbeddingDimensions"
        },
        "modelId": {
          "$ref": "#/$defs/Identifier"
        },
        "values": {
          "$ref": "#/$defs/EmbeddingVector"
        }
      },
      "required": [
        "dimensions",
        "modelId",
        "values"
      ],
      "additionalProperties": false
    },
    "EmbeddingGenerationResult": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/AgentEmbeddingGenerationResult"
        }
      ]
    },
    "TextValues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TextValue"
      }
    },
    "EmbeddingBatchRequest": {
      "type": "object",
      "properties": {
        "modelId": {
          "$ref": "#/$defs/Identifier"
        },
        "texts": {
          "$ref": "#/$defs/TextValues"
        }
      },
      "required": [
        "modelId",
        "texts"
      ],
      "additionalProperties": false
    },
    "EmbeddingGenerationResultOrNull": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/AgentEmbeddingGenerationResult"
        }
      ]
    },
    "EmbeddingBatchResults": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EmbeddingGenerationResultOrNull"
      }
    },
    "Identifier": {
      "type": "string",
      "minLength": 1
    },
    "DisplayText": {
      "type": "string"
    },
    "EmbeddingDimensions": {
      "type": "integer",
      "minimum": 1
    }
  }
}
