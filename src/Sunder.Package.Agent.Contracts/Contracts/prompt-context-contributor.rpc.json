      "minLength": 4,
      "maxLength": 18,
      "enum": [
        "unknown",
        "user",
        "transcript-summary",
        "assistant",
        "tool",
        "extension",
        "durable-memory"
      ]
    },
    "AgentPromptContextScope": {
      "type": "object",
      "properties": {
