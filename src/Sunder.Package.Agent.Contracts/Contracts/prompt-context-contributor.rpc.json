      "type": "string",
      "minLength": 9,
      "maxLength": 13,
      "enum": [
        "untrusted",
        "user-provided"
      ]
    },
    "AgentPromptContextUsage": {
      "type": "string",
      "minLength": 9,
      "maxLength": 20,
      "enum": [
        "reference",
        "scoped-instruction",
