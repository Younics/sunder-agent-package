      "type": "string",
      "minLength": 0,
      "maxLength": 8192
    },
    "ContentText": {
      "type": "string",
      "minLength": 0,
      "maxLength": 900000
    },
    "JsonText": {
      "type": "string",
      "minLength": 0,
      "maxLength": 900000,
      "description": "Bounded opaque JSON text that may be malformed, truncated, or interpreted by an extension-owned schema."
    },
    "Sha256Text": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "CharacterCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 900000
    },
    "SortOrder": {
      "type": "integer",
      "minimum": -100000,
      "maximum": 100000
    },
    "CollectionIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "Revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "Count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
