        },
        "hostIdentity": {
          "$ref": "#/$defs/TextValue"
        },
        "priority": {
          "$ref": "#/$defs/SortOrder"
        },
        "provenance": {
          "$ref": "#/$defs/AgentContextProvenance"
        },
        "scope": {
          "$ref": "#/$defs/AgentPromptContextScope"
        },
        "sourceId": {
          "$ref": "#/$defs/Identifier"
        },
        "title": {
          "$ref": "#/$defs/DisplayText"
        },
        "trust": {
          "$ref": "#/$defs/AgentContextTrust"
        },
        "usage": {
          "$ref": "#/$defs/AgentPromptContextUsage"
        }
      },
      "required": [
        "authority",
        "content",
        "priority",
        "provenance",
        "title",
        "trust",
        "usage"
      ],
      "additionalProperties": false
    },
    "AgentPromptContextBlockCollection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentPromptContextBlock"
      },
      "minItems": 0,
      "maxItems": 4096
    },
    "AgentPromptContextContribution": {
      "type": "object",
      "properties": {
        "blocks": {
          "$ref": "#/$defs/AgentPromptContextBlockCollection"
        }
      },
      "required": [
        "blocks"
      ],
      "additionalProperties": false
    },
    "PromptContextContributionResult": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/AgentPromptContextContribution"
        }
      ]
    },
    "AgentPromptContextReceiptBlock": {
      "type": "object",
      "properties": {
        "contentHash": {
          "$ref": "#/$defs/Sha256Text"
        },
        "contextIdentity": {
          "$ref": "#/$defs/TextValue"
        },
        "documentPath": {
          "$ref": "#/$defs/PathText"
        },
        "hostIdentity": {
          "$ref": "#/$defs/TextValue"
        }
      },
      "required": [
        "contentHash",
        "contextIdentity",
        "documentPath",
        "hostIdentity"
      ],
      "additionalProperties": false
    },
    "AgentPromptContextReceiptBlockCollection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentPromptContextReceiptBlock"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "AgentPromptContextReceipt": {
      "type": "object",
      "properties": {
        "blocks": {
          "$ref": "#/$defs/AgentPromptContextReceiptBlockCollection"
        },
        "runId": {
          "$ref": "#/$defs/EntityId"
        },
        "sessionId": {
          "$ref": "#/$defs/EntityId"
        },
        "transcriptEpoch": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "blocks",
        "runId",
        "sessionId",
        "transcriptEpoch"
