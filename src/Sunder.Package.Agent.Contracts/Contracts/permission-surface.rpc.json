{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "descriptorVersion": 2,
  "schemaProfile": "sunder.rpc.values.v1",
  "contractId": "sunder.agent.permission.surface",
  "version": "1.0.0",
  "errors": {},
  "services": {
    "permission-surface": {
      "methods": {
        "describe": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/Unit"
          },
          "responseSchema": {
            "$ref": "#/$defs/PermissionSurfaceSnapshot"
          }
        }
      }
    }
  },
  "$defs": {
    "Unit": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "AgentPermissionDecision": {
      "type": "string",
      "minLength": 3,
      "maxLength": 5,
      "enum": [
        "allow",
        "ask",
        "deny"
      ]
    },
    "AgentPermissionBoundaryDescriptor": {
      "type": "object",
      "properties": {
        "boundaryId": {
          "$ref": "#/$defs/Identifier"
        },
        "defaultDecision": {
          "$ref": "#/$defs/AgentPermissionDecision"
        },
        "description": {
          "$ref": "#/$defs/DisplayText"
        },
        "displayName": {
          "$ref": "#/$defs/DisplayText"
        }
      },
      "required": [
        "boundaryId",
        "defaultDecision",
        "description",
        "displayName"
      ],
      "additionalProperties": false
    },
    "AgentPermissionBoundaryDescriptorCollection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentPermissionBoundaryDescriptor"
      },
      "minItems": 0,
      "maxItems": 4096
    },
    "AgentPermissionActionDescriptor": {
      "type": "object",
      "properties": {
        "actionId": {
          "$ref": "#/$defs/Identifier"
        },
        "boundaries": {
          "$ref": "#/$defs/AgentPermissionBoundaryDescriptorCollection"
        },
        "description": {
          "$ref": "#/$defs/DisplayText"
        },
        "displayName": {
          "$ref": "#/$defs/DisplayText"
        }
      },
      "required": [
        "actionId",
        "boundaries",
        "description",
        "displayName"
      ],
      "additionalProperties": false
    },
    "AgentPermissionActionDescriptorCollection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentPermissionActionDescriptor"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "PermissionSurfaceSnapshot": {
      "type": "object",
      "properties": {
        "actions": {
          "$ref": "#/$defs/AgentPermissionActionDescriptorCollection"
        },
        "displayName": {
          "$ref": "#/$defs/DisplayText"
        },
        "surfaceId": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "actions",
        "displayName",
        "surfaceId"
      ],
      "additionalProperties": false
    },
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "DisplayText": {
      "type": "string",
      "minLength": 0,
      "maxLength": 8192
    }
  }
}
