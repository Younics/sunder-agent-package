{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "descriptorVersion": 2,
  "schemaProfile": "sunder.rpc.values.v1",
  "contractId": "sunder.agent.durable.lifecycle.observer",
  "version": "1.0.0",
  "errors": {},
  "services": {
    "durable-lifecycle-observer": {
      "methods": {
        "describe": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/Unit"
          },
          "responseSchema": {
            "$ref": "#/$defs/AgentRpcIdentity"
          }
        },
        "handle": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/AgentDurableLifecycleEventEnvelope"
          },
          "responseSchema": {
            "$ref": "#/$defs/Unit"
          }
        }
      }
    }
  },
  "$defs": {
    "Unit": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "TextValue": {
      "type": "string"
    },
    "AgentRpcIdentity": {
      "type": "object",
      "properties": {
        "displayName": {
          "$ref": "#/$defs/DisplayText"
        },
        "id": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "displayName",
        "id"
      ],
      "additionalProperties": false
    },
    "AgentLifecycleEventKind": {
      "type": "string",
      "enum": [
        "user-turn-added",
        "assistant-turn-completed",
        "tool-result-recorded",
        "run-interrupted",
        "run-stopped",
        "run-failed",
        "transcript-rolled-back",
        "session-deleted",
        "workspace-deleted"
      ]
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "EntityId": {
      "type": "string",
      "format": "uuid"
    },
    "AgentRunStatus": {
      "type": "string",
      "enum": [
        "idle",
        "running",
        "interrupted",
        "stopped",
        "completed",
        "failed",
        "waiting-for-approval"
      ]
    },
    "AgentRunCheckpointRecord": {
      "type": "object",
      "properties": {
        "checkpointId": {
          "$ref": "#/$defs/EntityId"
        },
        "createdAtUtc": {
          "$ref": "#/$defs/Timestamp"
        },
        "runRevision": {
          "$ref": "#/$defs/Revision"
        },
        "sessionId": {
          "$ref": "#/$defs/EntityId"
        },
        "status": {
          "$ref": "#/$defs/AgentRunStatus"
        },
        "summary": {
          "$ref": "#/$defs/DisplayText"
        }
      },
      "required": [
        "checkpointId",
        "createdAtUtc",
        "runRevision",
        "sessionId",
        "status"
      ],
      "additionalProperties": false
    },
    "Flag": {
      "type": "boolean"
    },
    "EntityIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EntityId"
      }
    },
    "AgentMemoryConsistencyBarrier": {
      "type": "object",
      "properties": {
        "eventId": {
          "$ref": "#/$defs/Identifier"
        },
        "payloadHash": {
          "$ref": "#/$defs/Sha256Text"
        }
      },
      "required": [
        "eventId",
        "payloadHash"
      ],
      "additionalProperties": false
    },
    "AgentMemoryConsistencyBarrierCollection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentMemoryConsistencyBarrier"
      }
    },
    "AgentTurnItemKind": {
      "type": "string",
      "enum": [
        "text",
        "tool-call",
        "tool-result",
        "attachment"
      ]
    },
    "AgentToolExecutionStatus": {
      "type": "string",
      "enum": [
        "prepared",
        "started",
        "completed",
        "failed",
        "ambiguous"
      ]
    },
    "AgentTurnItemRecord": {
      "type": "object",
      "properties": {
        "argumentsJson": {
          "$ref": "#/$defs/JsonText"
        },
        "backendId": {
          "$ref": "#/$defs/Identifier"
        },
        "callId": {
          "$ref": "#/$defs/Identifier"
        },
        "errorCode": {
          "$ref": "#/$defs/TextValue"
        },
        "isError": {
          "$ref": "#/$defs/Flag"
        },
        "isToolHeaderProjection": {
          "$ref": "#/$defs/Flag"
        },
        "itemId": {
          "$ref": "#/$defs/EntityId"
        },
        "kind": {
          "$ref": "#/$defs/AgentTurnItemKind"
        },
        "presentationPayloadJson": {
          "$ref": "#/$defs/JsonText"
        },
        "resultSummary": {
          "$ref": "#/$defs/DisplayText"
        },
        "sequenceNumber": {
          "$ref": "#/$defs/CollectionIndex"
        },
        "sourcesJson": {
          "$ref": "#/$defs/JsonText"
        },
        "structuredPayloadJson": {
          "$ref": "#/$defs/JsonText"
        },
        "textContent": {
          "$ref": "#/$defs/ContentText"
        },
        "toolDetailRevision": {
          "$ref": "#/$defs/Revision"
        },
        "toolErrorSummary": {
          "$ref": "#/$defs/DisplayText"
        },
        "toolExecutionId": {
          "$ref": "#/$defs/EntityId"
        },
        "toolExecutionStatus": {
          "$ref": "#/$defs/AgentToolExecutionStatus"
        },
        "toolHasDetails": {
          "$ref": "#/$defs/Flag"
        },
        "toolHeaderHint": {
          "$ref": "#/$defs/DisplayText"
        },
        "toolId": {
          "$ref": "#/$defs/Identifier"
        },
        "toolOwnerPackageId": {
          "$ref": "#/$defs/Identifier"
        },
        "toolSchemaId": {
          "$ref": "#/$defs/Identifier"
        },
        "toolSchemaVersion": {
          "$ref": "#/$defs/VersionText"
        },
        "turnId": {
          "$ref": "#/$defs/EntityId"
        },
        "wasTruncated": {
          "$ref": "#/$defs/Flag"
        }
      },
      "required": [
        "isError",
        "isToolHeaderProjection",
        "itemId",
        "kind",
        "sequenceNumber",
        "toolDetailRevision",
        "turnId",
        "wasTruncated"
      ],
      "additionalProperties": false
    },
    "AgentTurnItemRecordCollection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentTurnItemRecord"
      }
    },
    "AgentTurnKind": {
      "type": "string",
      "enum": [
        "message",
        "tool-call",
        "tool-result"
      ]
    },
    "AgentMessageRole": {
      "type": "string",
      "enum": [
        "system",
        "user",
        "assistant",
        "tool"
      ]
    },
    "AgentTurnRecord": {
      "type": "object",
      "properties": {
        "contentRevision": {
          "$ref": "#/$defs/Revision"
        },
        "createdAtUtc": {
          "$ref": "#/$defs/Timestamp"
        },
        "isStreaming": {
          "$ref": "#/$defs/Flag"
        },
        "items": {
          "$ref": "#/$defs/AgentTurnItemRecordCollection"
        },
        "kind": {
          "$ref": "#/$defs/AgentTurnKind"
        },
        "role": {
          "$ref": "#/$defs/AgentMessageRole"
        },
        "runId": {
          "$ref": "#/$defs/EntityId"
        },
        "runRevision": {
          "$ref": "#/$defs/Revision"
        },
        "sessionId": {
          "$ref": "#/$defs/EntityId"
        },
        "turnId": {
          "$ref": "#/$defs/EntityId"
        },
        "updatedAtUtc": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "contentRevision",
        "createdAtUtc",
        "isStreaming",
        "items",
        "kind",
        "role",
        "sessionId",
        "turnId",
        "updatedAtUtc"
      ],
      "additionalProperties": false
    },
    "AgentTurnRecordCollection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentTurnRecord"
      }
    },
    "AgentRunContextRecord": {
      "type": "object",
      "properties": {
        "isInterrupted": {
          "$ref": "#/$defs/Flag"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "runId": {
          "$ref": "#/$defs/EntityId"
        },
        "startedAtUtc": {
          "$ref": "#/$defs/Timestamp"
        },
        "status": {
          "$ref": "#/$defs/AgentRunStatus"
        }
      },
      "required": [
        "isInterrupted",
        "revision",
        "runId",
        "startedAtUtc",
        "status"
      ],
      "additionalProperties": false
    },
    "AgentSessionState": {
      "type": "string",
      "enum": [
        "active",
        "interrupted",
        "stopped",
        "completed",
        "failed"
      ]
    },
    "AgentSessionContextRecord": {
      "type": "object",
      "properties": {
        "profileDisplayName": {
          "$ref": "#/$defs/DisplayText"
        },
        "profileId": {
          "$ref": "#/$defs/Identifier"
        },
        "sessionId": {
          "$ref": "#/$defs/EntityId"
        },
        "sessionState": {
          "$ref": "#/$defs/AgentSessionState"
        },
        "sessionTitle": {
          "$ref": "#/$defs/DisplayText"
        },
        "workingSummary": {
          "$ref": "#/$defs/DisplayText"
        }
      },
      "required": [
        "profileDisplayName",
        "profileId",
        "sessionId",
        "sessionState",
        "sessionTitle"
      ],
      "additionalProperties": false
    },
    "AgentDurableLifecycleEventPayload": {
      "type": "object",
      "properties": {
        "checkpoint": {
          "$ref": "#/$defs/AgentRunCheckpointRecord"
        },
        "contentErased": {
          "$ref": "#/$defs/Flag"
        },
        "deletedChildSessionCount": {
          "$ref": "#/$defs/Count"
        },
        "deletedChildSessionIds": {
          "$ref": "#/$defs/EntityIds"
        },
        "deletedSessionCount": {
          "$ref": "#/$defs/Count"
        },
        "deletedSessionIds": {
          "$ref": "#/$defs/EntityIds"
        },
        "deletedTurnCount": {
          "$ref": "#/$defs/Count"
        },
        "deletedTurnIds": {
          "$ref": "#/$defs/EntityIds"
        },
        "deletionBatchId": {
          "$ref": "#/$defs/Identifier"
        },
        "deletionChunkCount": {
          "$ref": "#/$defs/Count"
        },
        "deletionChunkIndex": {
          "$ref": "#/$defs/CollectionIndex"
        },
        "deletionChunkReceipts": {
          "$ref": "#/$defs/AgentMemoryConsistencyBarrierCollection"
        },
        "recentLiveBufferTurns": {
          "$ref": "#/$defs/AgentTurnRecordCollection"
        },
        "rootSessionId": {
          "$ref": "#/$defs/EntityId"
        },
        "run": {
          "$ref": "#/$defs/AgentRunContextRecord"
        },
        "session": {
          "$ref": "#/$defs/AgentSessionContextRecord"
        },
        "sessionId": {
          "$ref": "#/$defs/EntityId"
        },
        "triggerTurn": {
          "$ref": "#/$defs/AgentTurnRecord"
        },
        "turns": {
          "$ref": "#/$defs/AgentTurnRecordCollection"
        },
        "userMessage": {
          "$ref": "#/$defs/ContentText"
        },
        "workingSummary": {
          "$ref": "#/$defs/DisplayText"
        },
        "workspaceId": {
          "$ref": "#/$defs/Identifier"
        },
        "workspaceIncarnationId": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "contentErased",
        "deletedChildSessionCount",
        "deletedChildSessionIds",
        "deletedSessionCount",
        "deletedSessionIds",
        "deletedTurnCount",
        "deletedTurnIds",
        "deletionChunkReceipts",
        "recentLiveBufferTurns",
        "turns"
      ],
      "additionalProperties": false
    },
    "AgentDurableLifecycleEventEnvelope": {
      "type": "object",
      "properties": {
        "eventId": {
          "$ref": "#/$defs/Identifier"
        },
        "kind": {
          "$ref": "#/$defs/AgentLifecycleEventKind"
        },
        "occurredAtUtc": {
          "$ref": "#/$defs/Timestamp"
        },
        "orderingKey": {
          "$ref": "#/$defs/TextValue"
        },
        "originalPayloadHash": {
          "$ref": "#/$defs/Sha256Text"
        },
        "payload": {
          "$ref": "#/$defs/AgentDurableLifecycleEventPayload"
        },
        "payloadHash": {
          "$ref": "#/$defs/Sha256Text"
        },
        "payloadJson": {
          "$ref": "#/$defs/JsonText"
        },
        "sequence": {
          "$ref": "#/$defs/Revision"
        },
        "sourceKey": {
          "$ref": "#/$defs/TextValue"
        }
      },
      "required": [
        "eventId",
        "kind",
        "occurredAtUtc",
        "orderingKey",
        "payload",
        "payloadHash",
        "payloadJson",
        "sequence",
        "sourceKey"
      ],
      "additionalProperties": false
    },
    "Identifier": {
      "type": "string",
      "minLength": 1
    },
    "VersionText": {
      "type": "string",
      "minLength": 1
    },
    "DisplayText": {
      "type": "string"
    },
    "ContentText": {
      "type": "string"
    },
    "JsonText": {
      "type": "string",
      "description": "Opaque JSON text that may be malformed, truncated, or interpreted by an extension-owned schema."
    },
    "Sha256Text": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "CollectionIndex": {
      "type": "integer",
      "minimum": 0
    },
    "Revision": {
      "type": "integer",
      "minimum": 0
    },
    "Count": {
      "type": "integer",
      "minimum": 0
    }
  }
}
