<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <SunderSdkReference>true</SunderSdkReference>
    <IsPackable>true</IsPackable>
    <PackageId>Sunder.Package.Agent.Contracts</PackageId>
    <Title>Sunder Package Agent Contracts</Title>
    <Description>Public contracts for extending the Sunder Agent package family with providers, tools, execution targets, memory, skills, and subagents.</Description>
    <PackageTags>$(PackageTags);contracts;extensions;providers;tools</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
