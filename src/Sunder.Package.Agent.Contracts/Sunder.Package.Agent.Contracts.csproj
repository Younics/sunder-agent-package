<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <SunderPackageFamilyId>sunder.package.agent</SunderPackageFamilyId>
    <SunderPackageRole>protocol</SunderPackageRole>
    <SunderSdkReference>true</SunderSdkReference>
    <SunderPackageBuildReference>true</SunderPackageBuildReference>
    <SunderPackageProject>false</SunderPackageProject>
    <IsPackable>true</IsPackable>
    <AssemblyName>Sunder.Package.Agent.Protocol</AssemblyName>
    <PackageId>Sunder.Package.Agent.Protocol</PackageId>
    <Title>Sunder Package Agent Protocol</Title>
    <Description>Language-neutral Sunder RPC descriptors and deterministic C# bindings for the Sunder Agent package family.</Description>
    <PackageTags>$(PackageTags);protocol;rpc;schemas;providers;tools</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <SunderRpcBinding Include="Contracts\behavior-loop.rpc.json"
                      Namespace="Sunder.Package.Agent.Protocol.Generated.BehaviorLoop"
                      Accessibility="Public"
                      OutputFile="BehaviorLoop.g.cs" />
    <SunderRpcBinding Include="Contracts\chat-provider.rpc.json"
                      Namespace="Sunder.Package.Agent.Protocol.Generated.ChatProvider"
                      Accessibility="Public"
                      OutputFile="ChatProvider.g.cs" />
    <SunderRpcBinding Include="Contracts\child-run-executor.rpc.json"
                      Namespace="Sunder.Package.Agent.Protocol.Generated.ChildRunExecutor"
                      Accessibility="Public"
                      OutputFile="ChildRunExecutor.g.cs" />
    <SunderRpcBinding Include="Contracts\durable-lifecycle-observer.rpc.json"
                      Namespace="Sunder.Package.Agent.Protocol.Generated.DurableLifecycleObserver"
                      Accessibility="Public"
                      OutputFile="DurableLifecycleObserver.g.cs" />
    <SunderRpcBinding Include="Contracts\embedding-provider.rpc.json"
                      Namespace="Sunder.Package.Agent.Protocol.Generated.EmbeddingProvider"
                      Accessibility="Public"
                      OutputFile="EmbeddingProvider.g.cs" />
    <SunderRpcBinding Include="Contracts\execution-target.rpc.json"
                      Namespace="Sunder.Package.Agent.Protocol.Generated.ExecutionTarget"
                      Accessibility="Public"
                      OutputFile="ExecutionTarget.g.cs" />
    <SunderRpcBinding Include="Contracts\permission-surface.rpc.json"
                      Namespace="Sunder.Package.Agent.Protocol.Generated.PermissionSurface"
                      Accessibility="Public"
                      OutputFile="PermissionSurface.g.cs" />
    <SunderRpcBinding Include="Contracts\profile-capability-consumer.rpc.json"
                      Namespace="Sunder.Package.Agent.Protocol.Generated.ProfileCapabilityConsumer"
                      Accessibility="Public"
                      OutputFile="ProfileCapabilityConsumer.g.cs" />
    <SunderRpcBinding Include="Contracts\prompt-context-contributor.rpc.json"
                      Namespace="Sunder.Package.Agent.Protocol.Generated.PromptContextContributor"
                      Accessibility="Public"
                      OutputFile="PromptContextContributor.g.cs" />
    <SunderRpcBinding Include="Contracts\run-control.rpc.json"
                      Namespace="Sunder.Package.Agent.Protocol.Generated.RunControl"
                      Accessibility="Public"
                      OutputFile="RunControl.g.cs" />
    <SunderRpcBinding Include="Contracts\runtime-catalog.rpc.json"
                      Namespace="Sunder.Package.Agent.Protocol.Generated.RuntimeCatalog"
                      Accessibility="Public"
                      OutputFile="RuntimeCatalog.g.cs" />
    <SunderRpcBinding Include="Contracts\selectable-capability-provider.rpc.json"
                      Namespace="Sunder.Package.Agent.Protocol.Generated.SelectableCapabilityProvider"
                      Accessibility="Public"
                      OutputFile="SelectableCapabilityProvider.g.cs" />
    <SunderRpcBinding Include="Contracts\session-cleaner.rpc.json"
                      Namespace="Sunder.Package.Agent.Protocol.Generated.SessionCleaner"
                      Accessibility="Public"
                      OutputFile="SessionCleaner.g.cs" />
    <SunderRpcBinding Include="Contracts\system-prompt-contributor.rpc.json"
                      Namespace="Sunder.Package.Agent.Protocol.Generated.SystemPromptContributor"
                      Accessibility="Public"
                      OutputFile="SystemPromptContributor.g.cs" />
    <SunderRpcBinding Include="Contracts\tool-source.rpc.json"
                      Namespace="Sunder.Package.Agent.Protocol.Generated.ToolSource"
                      Accessibility="Public"
                      OutputFile="ToolSource.g.cs" />
    <SunderRpcBinding Include="Contracts\tool-execution-observed.rpc.json"
                      Namespace="Sunder.Package.Agent.Protocol.Generated.ToolExecutionObserved"
                      Accessibility="Public"
                      OutputFile="ToolExecutionObserved.g.cs" />
    <SunderRpcBinding Include="Contracts\workspace-editor.rpc.json"
                      Namespace="Sunder.Package.Agent.Protocol.Generated.WorkspaceEditor"
                      Accessibility="Public"
                      OutputFile="WorkspaceEditor.g.cs" />
    <SunderRpcBinding Include="Contracts\workspace-execution-resolver.rpc.json"
                      Namespace="Sunder.Package.Agent.Protocol.Generated.WorkspaceExecutionResolver"
                      Accessibility="Public"
                      OutputFile="WorkspaceExecutionResolver.g.cs" />
    <SunderRpcBinding Include="Contracts\workspace-path-migrator.rpc.json"
                      Namespace="Sunder.Package.Agent.Protocol.Generated.WorkspacePathMigrator"
                      Accessibility="Public"
                      OutputFile="WorkspacePathMigrator.g.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="Contracts\**\*.rpc.json" Pack="true" PackagePath="contracts" />
    <None Include="buildTransitive\Sunder.Package.Agent.Protocol.props"
          Pack="true"
          PackagePath="buildTransitive" />
    <EmbeddedResource Include="Contracts\**\*.rpc.json"
                      LogicalName="Sunder.Package.Agent.Protocol.Contracts.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
