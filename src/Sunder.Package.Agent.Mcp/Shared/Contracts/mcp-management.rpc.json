{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "descriptorVersion": 2,
  "schemaProfile": "sunder.rpc.values.v1",
  "contractId": "sunder.package.agent.mcp.management",
  "version": "1.0.0",
  "errors": {
    "mcp.management.failed": {
      "description": "The MCP management request failed."
    }
  },
  "services": {
    "management": {
      "methods": {
        "query": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [
            "mcp.management.failed"
          ],
          "requestSchema": {
            "$ref": "#/$defs/ManagementContent"
          },
          "responseSchema": {
            "$ref": "#/$defs/ManagementContent"
          }
        },
        "command": {
          "kind": "unary",
          "idempotency": "none",
          "errors": [
            "mcp.management.failed"
          ],
          "requestSchema": {
            "$ref": "#/$defs/ManagementContent"
          },
          "responseSchema": {
            "$ref": "#/$defs/ManagementContent"
          }
        },
        "changes": {
          "kind": "server-stream",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/ChangeSubscription"
          },
          "eventSchema": {
            "$ref": "#/$defs/ManagementChange"
          }
        }
      }
    }
  },
  "$defs": {
    "ContentReference": {
      "type": "object",
      "logicalType": "content-reference"
    },
    "ManagementContent": {
      "type": "object",
      "properties": {
        "content": {
          "$ref": "#/$defs/ContentReference"
        }
      },
      "required": [
        "content"
      ],
      "additionalProperties": false
    },
    "ChangeSubscription": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "ManagementChangeKind": {
      "type": "string",
      "enum": [
        "servers",
        "status"
      ]
    },
    "ManagementChange": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ManagementChangeKind"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    }
  }
}
