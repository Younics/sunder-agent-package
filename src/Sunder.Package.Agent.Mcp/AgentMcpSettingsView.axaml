<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Sunder.Package.Agent.Mcp"
             xmlns:p="using:Sunder.Package.Agent.Shared.Presentation"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             x:Class="Sunder.Package.Agent.Mcp.AgentMcpSettingsView"
             x:DataType="vm:AgentMcpSettingsViewModel"
             mc:Ignorable="d" Classes="agent-page">
  <UserControl.Styles>
    <StyleInclude Source="/Presentation/PresentationStyles.axaml" />
    <Style Selector="Border.mcp-list-pane">
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>

    <Style Selector="Border.mcp-editor-pane">
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="Border.mcp-pane.compact">
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="Border.mcp-pane-header">
      <Setter Property="Padding" Value="{DynamicResource Sunder.Padding.Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style Selector="Border.mcp-list-body">
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="Border.mcp-editor-body">
      <Setter Property="Padding" Value="{DynamicResource Sunder.Padding.Panel}" />
    </Style>

    <Style Selector="Border.mcp-actions">
      <Setter Property="Padding" Value="{DynamicResource Sunder.Padding.Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

    <Style Selector="TextBlock.mcp-title">
      <Setter Property="FontSize" Value="{DynamicResource Sunder.FontSize.PageTitle}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Primary}" />
    </Style>

    <Style Selector="TextBlock.mcp-caption">
      <Setter Property="FontSize" Value="{DynamicResource Sunder.FontSize.Caption}" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Secondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.mcp-field-label">
      <Setter Property="FontSize" Value="{DynamicResource Sunder.FontSize.Body}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Primary}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style Selector="TextBlock.mcp-field-help">
      <Setter Property="FontSize" Value="{DynamicResource Sunder.FontSize.Caption}" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Muted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="ListBox.mcp-list">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Transparent}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="ListBox.mcp-list ListBoxItem">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Base}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Small}" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style Selector="ListBox.mcp-list ListBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Hover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Strong}" />
    </Style>

    <Style Selector="ListBox.mcp-list ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Info.Soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Accent}" />
    </Style>

    <Style Selector="TextBlock.mcp-status-message">
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Secondary}" />
      <Setter Property="FontSize" Value="{DynamicResource Sunder.FontSize.Caption}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.mcp-status-message.warning">
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Warning}" />
    </Style>

    <Style Selector="TextBlock.mcp-status-message.success">
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Success}" />
    </Style>

    <Style Selector="TextBlock.mcp-status-message.error">
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Danger}" />
    </Style>

    <Style Selector="Button.mcp-add-action">
      <Setter Property="Width" Value="36" />
      <Setter Property="MinWidth" Value="36" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="{DynamicResource Sunder.FontSize.PageTitle}" />
      <Setter Property="FontWeight" Value="Regular" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto" RowSpacing="12" ClipToBounds="True">
    <Grid x:Name="McpAdaptiveLayout"
          ColumnDefinitions="320,*"
          ColumnSpacing="4">
      <Border x:Name="McpListPane"
               Classes="mcp-pane mcp-list-pane"
               Classes.compact="{Binding IsCompactLayout}"
              IsVisible="{Binding ShowListPane}">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0"
                  Classes="mcp-pane-header">
            <Grid ColumnDefinitions="*,Auto"
                  RowDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="8">
              <p:SectionHeader Title="MCP servers" IsPageTitle="True" HelpText="Configure a server here, then enable it on the agents that should use it." />
              <Button Grid.Column="1"
                      Classes="secondary-action compact-action mcp-add-action"
                      Content="+"
                      Command="{Binding CreateServerCommand}"
                      ToolTip.Tip="New server" />
              <WrapPanel Grid.Row="2" Grid.ColumnSpan="2">
                <Button x:Name="ImportCommonConfigsButton" Content="Import Common Configs"
                        Classes="secondary-action compact-action" Margin="0,0,8,8"
                        Command="{Binding ImportCommonConfigurationsCommand}" />
                <Button x:Name="ImportConfigFileButton" Content="Import Config File"
                        Classes="secondary-action compact-action" Margin="0,0,8,8"
                        IsEnabled="{Binding CanStartOperation}" Click="OnImportConfigFileClick" />
              </WrapPanel>
            </Grid>
          </Border>

          <Border Grid.Row="1"
                  Classes="mcp-list-body">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          MinHeight="0"
                          VerticalScrollBarVisibility="Auto">
              <ListBox Classes="mcp-list" Margin="{DynamicResource Sunder.Padding.Panel}"
                       IsEnabled="{Binding CanNavigateServers}"
                       ItemsSource="{Binding Servers}"
                       SelectedItem="{Binding SelectedServer, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ConfiguredMcpServerRecord">
                    <Grid RowDefinitions="Auto,Auto"
                          RowSpacing="3"
                          MinWidth="0"
                          Tapped="OnServerItemTapped">
                      <TextBlock Text="{Binding DisplayName}"
                                 FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Row="1"
                                 Classes="mcp-field-help"
                                 Text="{Binding Name}"
                                 TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </ScrollViewer>
          </Border>
        </Grid>
      </Border>

      <Border x:Name="McpEditorPane"
              Grid.Column="1"
              Classes="mcp-pane mcp-editor-pane"
              Classes.compact="{Binding IsCompactLayout}"
              IsVisible="{Binding ShowEditorPane}">
        <Grid RowDefinitions="Auto,*,Auto">
          <Border Grid.Row="0"
                  Classes="mcp-pane-header">
            <StackPanel Spacing="8">
              <p:SectionHeader Title="Configuration" HelpText="Paste a local or remote MCP configuration object. Comments and trailing commas are accepted. Saving reformats the JSON." />
            </StackPanel>
          </Border>

          <ScrollViewer Grid.Row="1"
                        MinHeight="0"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <Border Classes="mcp-editor-body">
              <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                    RowSpacing="14">
                  <StackPanel Spacing="6">
                    <p:SectionHeader Title="Machine name" HelpText="A stable identifier used by agent assignments and saved connections." />
                    <TextBox Text="{Binding Name, Mode=TwoWay}"
                             IsEnabled="{Binding IsDocumentReady}"
                             PlaceholderText="context7" />
                  </StackPanel>

                  <StackPanel Grid.Row="1" Spacing="10">
                    <StackPanel Spacing="4">
                    <p:SectionHeader Title="Configuration tools" HelpText="Templates provide a starting configuration. Timeouts use milliseconds: discoveryTimeout defaults to 15 seconds and is capped at 120 seconds; zero uses the default. toolTimeout may cap a call at up to 30 minutes; zero disables that local timer. Stop and the global 30-minute run safety limit still apply." />
                    </StackPanel>
                    <WrapPanel Orientation="Horizontal">
                      <Button Content="Local Template" Classes="secondary-action"
                              Margin="0,0,10,10"
                              Command="{Binding LoadLocalTemplateCommand}" />
                      <Button Content="Remote Template" Classes="secondary-action"
                              Margin="0,0,10,10"
                              Command="{Binding LoadRemoteTemplateCommand}" />
                      <Button Content="Format" Classes="secondary-action"
                               Margin="0,0,10,10"
                               Command="{Binding FormatCommand}" />
                    </WrapPanel>
                  </StackPanel>

                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource Sunder.Brush.Border.Subtle}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Sunder.Radius.Small}"
                        Padding="6"
                        MinWidth="0"
                        MinHeight="240"
                        ClipToBounds="True">
                  <ae:TextEditor x:Name="ConfigEditor"
                                 IsReadOnly="{Binding IsEditorReadOnly}"
                                 ShowLineNumbers="True"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto"
                                  Background="{DynamicResource Sunder.Brush.Surface.Code}"
                                  Foreground="{DynamicResource Sunder.Brush.Foreground.Code}"
                                  FontFamily="{DynamicResource Sunder.Agent.FontFamily.Code}"
                                  FontSize="{DynamicResource Sunder.FontSize.Body}"
                                  MinWidth="0"
                                  MinHeight="0"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  WordWrap="False" />
                </Border>

                  <StackPanel Grid.Row="3" Spacing="6">
                    <p:SectionHeader Title="Connection" HelpText="Discover tools checks the server's available tools. Reconnect restarts the connection. OAuth authorization is separate from the server connection." />
                    <TextBlock Classes="mcp-status-message"
                               Classes.success="{Binding IsConnectionStatusSuccess}"
                               Classes.warning="{Binding IsConnectionStatusWarning}"
                               Classes.error="{Binding IsConnectionStatusError}"
                               Text="{Binding ConnectionStatusText}" />
                    <TextBlock Classes="mcp-field-help"
                               Text="{Binding ConnectionStatusDetail}"
                               IsVisible="{Binding HasConnectionStatusDetail}" />
                    <WrapPanel Orientation="Horizontal">
                      <Button Content="Discover Tools" Classes="secondary-action"
                              Margin="0,6,10,0"
                              Command="{Binding DiscoverToolsCommand}" />
                      <Button Content="Cancel Discovery" Classes="secondary-action"
                              Margin="0,6,10,0"
                              Command="{Binding CancelDiscoveryCommand}" />
                      <Button Content="Disconnect" Classes="secondary-action"
                              Margin="0,6,10,0"
                              Command="{Binding DisconnectMcpServerCommand}" />
                      <Button Content="Reconnect" Classes="secondary-action"
                               Margin="0,6,10,0"
                               Command="{Binding ReconnectMcpServerCommand}" />
                      <Button Content="Authorize OAuth" Classes="secondary-action"
                              Margin="0,6,10,0"
                              Command="{Binding AuthorizeMcpServerCommand}"
                              IsVisible="{Binding HasSelectedOAuthServer}" />
                      <Button Content="Disconnect OAuth" Classes="secondary-action"
                              Margin="0,6,10,0"
                              Command="{Binding DisconnectMcpServerOAuthCommand}"
                              IsVisible="{Binding HasSelectedOAuthServer}" />
                    </WrapPanel>
                  </StackPanel>

                  <Expander Grid.Row="4" Header="Diagnostics" IsVisible="{Binding HasSelectedServer}">
                  <Grid RowDefinitions="Auto,*"
                        RowSpacing="8">
                    <Border Grid.Row="1"
                            Background="{DynamicResource Sunder.Brush.Surface.Code}"
                            BorderBrush="{DynamicResource Sunder.Brush.Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Sunder.Radius.Small}"
                            Padding="10"
                            MaxHeight="240"
                            ClipToBounds="True">
                      <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                    VerticalScrollBarVisibility="Auto">
                        <SelectableTextBlock Text="{Binding ConnectionDiagnosticsText}"
                                   Foreground="{DynamicResource Sunder.Brush.Foreground.Code}"
                                   FontFamily="{DynamicResource Sunder.Agent.FontFamily.Code}"
                                   FontSize="{DynamicResource Sunder.FontSize.Caption}"
                                   TextWrapping="NoWrap" />
                      </ScrollViewer>
                    </Border>
                  </Grid>
                  </Expander>
              </Grid>
            </Border>
          </ScrollViewer>

          <Border Grid.Row="2"
                  Classes="mcp-actions">
            <p:EditorFooter>
              <Button Grid.Column="0"
                      Classes="secondary-action compact-action danger-action"
                      Content="Delete"
                      Command="{Binding DeleteCommand}" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{DynamicResource Sunder.Spacing.Small}">
              <Button
                      Classes="secondary-action compact-action"
                      Content="Back"
                      Command="{Binding BackToServerListCommand}"
                      IsVisible="{Binding IsCompactLayout}" />
              <Button
                      Classes="primary-action"
                      Content="Save"
                      Command="{Binding SaveCommand}" />
              </StackPanel>
            </p:EditorFooter>
          </Border>
        </Grid>
      </Border>
    </Grid>
    <StackPanel Grid.Row="1" Spacing="8">
      <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Height="3" />
      <TextBlock x:Name="McpOperationStatus" Classes="mcp-status-message" Margin="{DynamicResource Sunder.Padding.Panel}"
                 Classes.success="{Binding IsStatusSuccess}" Classes.warning="{Binding IsStatusWarning}"
                 Classes.error="{Binding IsStatusError}" Text="{Binding StatusText}"
                 IsVisible="{Binding HasStatus}" />
    </StackPanel>
  </Grid>
</UserControl>
