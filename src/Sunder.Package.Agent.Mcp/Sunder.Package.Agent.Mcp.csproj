<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Sunder.Package.Agent.Mcp</AssemblyName>
    <RootNamespace>Sunder.Package.Agent.Mcp</RootNamespace>
    <SunderPackageFamilyId>sunder.package.agent.mcp</SunderPackageFamilyId>
    <SunderSdkAvaloniaReference>true</SunderSdkAvaloniaReference>
    <SunderSdkStacksReference>true</SunderSdkStacksReference>
    <SunderAgentSharedCallbackFlow>true</SunderAgentSharedCallbackFlow>
    <SunderAgentCurrentPackageStorageKey>true</SunderAgentCurrentPackageStorageKey>
    <SunderPackageAssetsDirectory>$(MSBuildProjectDirectory)\Assets</SunderPackageAssetsDirectory>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\Sunder.Agent.Worker.props" />
  <Import Project="..\Sunder.Package.Agent\Models\AgentExtensionSources.props" />

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="ModelContextProtocol.Core" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="AvaloniaEdit.TextMate" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <Compile Include="@(SunderAgentMcpSource->Distinct())" LinkBase="Domain" />
  </ItemGroup>

  <ItemGroup>
    <SunderSdkCapability Include="rpc.extended-deadline.v1" />
  </ItemGroup>

  <Import Project="..\Sunder.Package.Agent.Shared\Sunder.Package.Agent.Shared.props" />
  <Import Project="..\Sunder.Package.Agent.Shared\Importing\Sunder.Package.Agent.Importing.props" />

</Project>
