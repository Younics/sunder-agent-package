<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Sunder.Package.Agent.Skills.PackageViews"
             xmlns:p="using:Sunder.Package.Agent.Shared.Presentation"
             x:Class="Sunder.Package.Agent.Skills.PackageViews.SkillSettingsView"
             x:DataType="vm:SkillSettingsViewModel"
             mc:Ignorable="d" Classes="agent-page">
  <UserControl.Styles>
    <StyleInclude Source="/Presentation/PresentationStyles.axaml" />
    <Style Selector="Border.skill-list-pane">
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>

    <Style Selector="Border.skill-detail-pane">
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="Border.skill-pane.compact">
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="Border.skill-pane-header">
      <Setter Property="Padding" Value="{DynamicResource Sunder.Padding.Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style Selector="Border.skill-list-body">
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="Border.skill-detail-body">
      <Setter Property="Padding" Value="{DynamicResource Sunder.Padding.Panel}" />
    </Style>

    <Style Selector="Border.skill-actions">
      <Setter Property="Padding" Value="{DynamicResource Sunder.Padding.Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

    <Style Selector="TextBlock.skill-title">
      <Setter Property="FontSize" Value="{DynamicResource Sunder.FontSize.PageTitle}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Primary}" />
    </Style>

    <Style Selector="TextBlock.skill-caption">
      <Setter Property="FontSize" Value="{DynamicResource Sunder.FontSize.Caption}" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Secondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.skill-field-label">
      <Setter Property="FontSize" Value="{DynamicResource Sunder.FontSize.Body}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Primary}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style Selector="TextBlock.skill-field-help">
      <Setter Property="FontSize" Value="{DynamicResource Sunder.FontSize.Caption}" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Muted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="ListBox.skill-list">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Transparent}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="ListBox.skill-list ListBoxItem">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Base}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Small}" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style Selector="ListBox.skill-list ListBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Hover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Strong}" />
    </Style>

    <Style Selector="ListBox.skill-list ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Info.Soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Accent}" />
    </Style>

    <Style Selector="TextBlock.skill-status-message">
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Secondary}" />
      <Setter Property="FontSize" Value="{DynamicResource Sunder.FontSize.Caption}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.skill-status-message.warning">
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Warning}" />
    </Style>

    <Style Selector="TextBlock.skill-status-message.success">
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Success}" />
    </Style>

    <Style Selector="TextBlock.skill-status-message.error">
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Danger}" />
    </Style>

    <Style Selector="Button.skill-add-action">
      <Setter Property="Width" Value="36" />
      <Setter Property="MinWidth" Value="36" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="{DynamicResource Sunder.FontSize.PageTitle}" />
      <Setter Property="FontWeight" Value="Regular" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto" RowSpacing="12" ClipToBounds="True">
    <Grid x:Name="SkillAdaptiveLayout"
          ColumnDefinitions="320,*"
          ColumnSpacing="4">
      <Border x:Name="SkillListPane"
              Classes="skill-pane skill-list-pane"
              Classes.compact="{Binding IsCompactLayout}"
              IsVisible="{Binding ShowListPane}">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0"
                  Classes="skill-pane-header">
            <Grid ColumnDefinitions="*,Auto"
                  RowDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="8">
              <p:SectionHeader Title="Skills" IsPageTitle="True" HelpText="Import a folder containing SKILL.md, then enable the skill on an agent." />
              <Button Grid.Column="1"
                      Classes="secondary-action compact-action skill-add-action"
                      Content="+"
                      Command="{Binding NewSkillCommand}"
                      ToolTip.Tip="New skill" />
              <Button x:Name="ImportCommonFoldersButton" Grid.Row="2" Grid.ColumnSpan="2"
                      Content="Import Common Folders" Classes="secondary-action compact-action"
                      HorizontalAlignment="Left" Command="{Binding ImportCommonSkillFoldersCommand}" />
            </Grid>
          </Border>

          <Border Grid.Row="1"
                  Classes="skill-list-body">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <ListBox Classes="skill-list" Margin="{DynamicResource Sunder.Padding.Panel}"
                       ItemsSource="{Binding Skills}"
                       SelectedItem="{Binding SelectedSkill, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:InstalledSkillItemViewModel">
                    <Grid RowDefinitions="Auto,Auto"
                          RowSpacing="3"
                          MinWidth="0"
                          Tapped="OnSkillItemTapped">
                      <TextBlock Text="{Binding DisplayName}"
                                 FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Row="1"
                                 Text="{Binding Description}"
                                 Foreground="{DynamicResource Sunder.Brush.Foreground.Muted}"
                                 FontSize="{DynamicResource Sunder.FontSize.Caption}"
                                 TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </ScrollViewer>
          </Border>

        </Grid>
      </Border>

      <Border x:Name="SkillDetailPane"
              Grid.Column="1"
              Classes="skill-pane skill-detail-pane"
              Classes.compact="{Binding IsCompactLayout}"
              IsVisible="{Binding ShowDetailPane}">
        <Grid RowDefinitions="Auto,*,Auto">
          <Border Grid.Row="0"
                  Classes="skill-pane-header">
            <StackPanel Spacing="8">
              <TextBlock Classes="skill-title"
                          Text="{Binding DetailTitle}" />
            </StackPanel>
          </Border>

          <ScrollViewer Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <Border Classes="skill-detail-body">
              <StackPanel Spacing="18">
                <StackPanel x:Name="SkillImportForm" Spacing="14" IsVisible="{Binding !HasSelectedSkill}">
                  <StackPanel Orientation="Horizontal" Spacing="20">
                    <RadioButton x:Name="GitHubSourceButton" Content="GitHub"
                                 IsChecked="{Binding IsGitHubSource, Mode=TwoWay}" />
                    <RadioButton x:Name="LocalFolderSourceButton" Content="Local folder"
                                 IsChecked="{Binding IsLocalSource, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel x:Name="GitHubImportForm" Spacing="14" IsVisible="{Binding IsGitHubSource}">
                    <p:SectionHeader Title="GitHub URL" HelpText="Use a GitHub folder, file, or raw URL pointing to a skill folder or SKILL.md." />
                    <TextBox Text="{Binding GithubUrl, Mode=TwoWay}"
                             PlaceholderText="https://github.com/owner/repo/tree/main/skills/my-skill" />
                      <Button Content="Import GitHub Skill"
                              Classes="primary-action" HorizontalAlignment="Left"
                              Command="{Binding ImportGitHubCommand}" />
                  </StackPanel>
                  <StackPanel x:Name="LocalFolderImportForm" Spacing="10" IsVisible="{Binding IsLocalSource}">
                    <p:SectionHeader Title="Local folder" HelpText="Choose a folder containing SKILL.md." />
                    <Button Content="Import Local Folder"
                            Classes="primary-action" HorizontalAlignment="Left"
                            Click="OnAddLocalFolderClick" />
                  </StackPanel>
                </StackPanel>

                  <StackPanel Spacing="14" IsVisible="{Binding HasSelectedSkill}">
                    <StackPanel Spacing="8">
                      <p:SectionHeader Title="Description" HelpText="The skill's instructions are made available when an agent loads this skill. This description is supplied by the imported skill." />
                      <SelectableTextBlock Text="{Binding SelectedSkill.Description}" TextWrapping="Wrap" />
                      <TextBlock Classes="skill-field-label" Text="Version" />
                      <SelectableTextBlock Text="{Binding SelectedSkill.Version}" />
                      <TextBlock Classes="skill-field-label" Text="Author" />
                      <SelectableTextBlock Text="{Binding SelectedSkill.Author}" TextWrapping="Wrap" />
                      <TextBlock Classes="skill-field-label" Text="Source" />
                      <SelectableTextBlock Text="{Binding SelectedSkill.Source}" TextWrapping="Wrap" />
                      <Expander Header="Installation details">
                      <StackPanel Spacing="{DynamicResource Sunder.Spacing.Small}">
                      <TextBlock Classes="skill-field-label" Text="Skill ID" />
                      <SelectableTextBlock Text="{Binding SelectedSkill.SkillId}" TextWrapping="Wrap" />
                      <TextBlock Classes="skill-field-label" Text="Resolved commit" />
                      <SelectableTextBlock Text="{Binding SelectedSkill.ResolvedCommitSha}" TextWrapping="Wrap" />
                      <TextBlock Classes="skill-field-label" Text="Installed folder" />
                      <SelectableTextBlock Text="{Binding SelectedSkill.RootPath}" TextWrapping="Wrap" />
                      <TextBlock Classes="skill-field-label" Text="Metadata" />
                      <SelectableTextBlock Text="{Binding SelectedSkill.MetadataText}" TextWrapping="Wrap" />
                      </StackPanel>
                      </Expander>
                      <StackPanel Spacing="{DynamicResource Sunder.Spacing.Small}" IsVisible="{Binding SelectedSkill.WarningsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Classes="skill-field-label" Text="Warnings" />
                        <SelectableTextBlock Text="{Binding SelectedSkill.WarningsText}" Foreground="{DynamicResource Sunder.Brush.Warning}" TextWrapping="Wrap" />
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
              </StackPanel>
            </Border>
          </ScrollViewer>

          <Border Grid.Row="2"
                  Classes="skill-actions">
            <p:EditorFooter>
              <Button Grid.Column="0"
                      Classes="secondary-action compact-action danger-action"
                      Content="Delete"
                      Command="{Binding DeleteSelectedSkillCommand}" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
              <Button
                      Classes="secondary-action compact-action"
                      Content="Back"
                      Command="{Binding BackToSkillListCommand}"
                      IsVisible="{Binding IsCompactLayout}" />
              </StackPanel>
            </p:EditorFooter>
          </Border>
        </Grid>
      </Border>
    </Grid>
    <StackPanel Grid.Row="1" Spacing="8">
      <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Height="3" />
      <TextBlock x:Name="SkillOperationStatus" Classes="skill-status-message" Margin="{DynamicResource Sunder.Padding.Panel}"
                 Classes.success="{Binding IsStatusSuccess}" Classes.warning="{Binding IsStatusWarning}"
                 Classes.error="{Binding IsStatusError}" Text="{Binding StatusText}"
                 IsVisible="{Binding HasStatus}" />
    </StackPanel>
  </Grid>
</UserControl>
