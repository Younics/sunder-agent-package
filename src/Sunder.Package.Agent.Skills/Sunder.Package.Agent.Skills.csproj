<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <SunderPackageFamilyId>sunder.package.agent.skills</SunderPackageFamilyId>
    <SunderPackageRole>worker</SunderPackageRole>
    <SunderPackageProject>true</SunderPackageProject>
    <SunderPackagePrimaryProject>true</SunderPackagePrimaryProject>
    <SunderPackageAppProject>App\SkillsApp.csproj</SunderPackageAppProject>
    <SunderSdkWorkerReference>true</SunderSdkWorkerReference>
    <SunderSdkStacksReference>true</SunderSdkStacksReference>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <UseAppHost>true</UseAppHost>
    <PublishSingleFile>false</PublishSingleFile>
    <SunderGeneratedPackageManifest>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\sunder-package.json'))</SunderGeneratedPackageManifest>
    <DefineConstants>$(DefineConstants);SUNDER_SKILLS_WORKER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Octokit" />
    <ProjectReference Include="..\Sunder.Package.Agent.Contracts\Sunder.Package.Agent.Contracts.csproj" />
    <ProjectReference Include="Protocol\SkillsProtocol.csproj" PrivateAssets="all" />
    <Compile Include="..\Sunder.Package.Agent.Shared\Importing\BoundedImportIO.cs"
             Link="Importing\BoundedImportIO.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="App\**\*" />
    <Compile Remove="PackageViews\**\*" />
    <Compile Remove="Protocol\**\*" />
    <None Remove="App\**\*" />
    <None Remove="Protocol\**\*" />
  </ItemGroup>

  <ItemGroup>
    <SunderContractBundle Include="Protocol\Contracts\skills-owner.rpc.json"
                          ContractId="sunder.package.agent.skills.owner"
                            Version="1.0.0"
                          DescriptorPath="contracts/skills-owner.rpc.json"
                          Exposure="package" />
    <SunderRpcProvider Include="skills.management"
                       ContractId="sunder.package.agent.skills.owner"
                        ContractVersion="1.0.0"
                       Role="runtime"
                       Audience="owner" />
    <SunderPackageTarget Include="runtime/$(RuntimeIdentifier)"
                         Role="runtime"
                         Rid="$(RuntimeIdentifier)"
                         Kind="worker" />
  </ItemGroup>

</Project>
