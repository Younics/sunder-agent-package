{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "descriptorVersion": 2,
  "contractId": "sunder.package.agent.skills.owner",
  "version": "2.0.0",
  "errors": {
    "skills.owner.operation-failed": {
      "description": "The requested Skills operation could not be completed."
    }
  },
  "services": {
    "skills-management": {
      "methods": {
        "query": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": ["skills.owner.operation-failed"],
          "requestSchema": { "$ref": "#/$defs/OwnerEmpty" },
          "responseSchema": { "$ref": "#/$defs/OwnerContent" }
        },
        "command": {
          "kind": "unary",
          "idempotency": "none",
          "errors": ["skills.owner.operation-failed"],
          "requestSchema": { "$ref": "#/$defs/OwnerContent" },
          "responseSchema": { "$ref": "#/$defs/OwnerContent" }
        },
        "changes": {
          "kind": "server-stream",
          "idempotency": "idempotent",
          "errors": ["skills.owner.operation-failed"],
          "requestSchema": { "$ref": "#/$defs/OwnerEmpty" },
          "eventSchema": { "$ref": "#/$defs/OwnerEmpty" }
        }
      }
    }
  },
  "$defs": {
    "SunderRpcContentReference": {
      "type": "object",
      "logicalType": "content-reference"
    },
    "OwnerEmpty": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "OwnerContent": {
      "type": "object",
      "properties": {
        "content": { "$ref": "#/$defs/SunderRpcContentReference" }
      },
      "required": ["content"],
      "additionalProperties": false
    }
  }
}
