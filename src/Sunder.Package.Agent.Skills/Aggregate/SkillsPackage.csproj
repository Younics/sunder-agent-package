<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <SunderPackageFamilyId>sunder.package.agent.skills</SunderPackageFamilyId>
    <SunderPackageRole>aggregate</SunderPackageRole>
    <SunderPackageAggregateProject>true</SunderPackageAggregateProject>
    <SunderPackageWorkerProject>..\Sunder.Package.Agent.Skills.csproj</SunderPackageWorkerProject>
    <SunderPackageWorkerDirectory>..</SunderPackageWorkerDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\App\SkillsApp.csproj" ReferenceOutputAssembly="false" />
    <SunderPackageTargetLeaf Include="..\App\bin\$(Configuration)\$(TargetFramework)\sunder-dev"
                             DiscoveryRoot="..\App\bin\$(Configuration)\$(TargetFramework)" />
  </ItemGroup>

</Project>
