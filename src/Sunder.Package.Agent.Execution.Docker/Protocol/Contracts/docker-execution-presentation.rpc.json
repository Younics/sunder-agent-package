{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "descriptorVersion": 2,
  "schemaProfile": "sunder.rpc.values.v1",
  "contractId": "sunder.package.agent.execution.docker.presentation",
  "version": "2.0.0",
  "errors": {},
  "services": {
    "presentation": {
      "methods": {
        "execute": {
          "kind": "unary",
          "idempotency": "none",
          "errors": [],
          "requestSchema": { "$ref": "#/$defs/DockerExecutionOperationRequest" },
          "responseSchema": { "$ref": "#/$defs/DockerExecutionOperationResponse" }
        }
      }
    }
  },
  "$defs": {
    "DockerOperation": {
      "type": "string",
      "minLength": 9,
      "maxLength": 14,
      "enum": [
        "get-settings",
        "save-settings",
        "add-image",
        "delete-image",
        "refresh-image",
        "refresh-images",
        "pull-image",
        "test-docker"
      ]
    },
    "TimeoutText": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16
    },
    "ExecutablePath": {
      "type": "string",
      "minLength": 0,
      "maxLength": 1024
    },
    "ImageReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "OperationMessage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "DiagnosticCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "CatalogRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ContentReference": {
      "type": "object",
      "logicalType": "content-reference"
    },
    "DockerExecutionOperationError": {
      "type": "object",
      "properties": {
        "code": { "$ref": "#/$defs/DiagnosticCode" },
        "message": { "$ref": "#/$defs/OperationMessage" },
        "isTransient": { "type": "boolean" },
        "correlationId": { "$ref": "#/$defs/DiagnosticCode" }
      },
      "required": ["code", "message", "isTransient", "correlationId"],
      "additionalProperties": false
    },
    "DockerExecutionOperationRequest": {
      "type": "object",
      "properties": {
        "kind": { "$ref": "#/$defs/DockerOperation" },
        "timeoutSeconds": { "$ref": "#/$defs/TimeoutText" },
        "dockerCliPath": { "$ref": "#/$defs/ExecutablePath" },
        "imageReference": { "$ref": "#/$defs/ImageReference" }
      },
      "required": ["kind"],
      "additionalProperties": false
    },
    "DockerExecutionOperationResponse": {
      "type": "object",
      "properties": {
        "timeoutSeconds": { "$ref": "#/$defs/TimeoutText" },
        "dockerCliPath": { "$ref": "#/$defs/ExecutablePath" },
        "imageCatalog": { "$ref": "#/$defs/ContentReference" },
        "success": { "type": "boolean" },
        "message": { "$ref": "#/$defs/OperationMessage" },
        "catalogRevision": { "$ref": "#/$defs/CatalogRevision" },
        "error": { "$ref": "#/$defs/DockerExecutionOperationError" }
      },
      "required": ["success"],
      "additionalProperties": false
    }
  }
}
