{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "descriptorVersion": 2,
  "schemaProfile": "sunder.rpc.values.v1",
  "contractId": "sunder.package.agent.execution.docker.presentation",
  "version": "1.0.0",
  "errors": {},
  "services": {
    "presentation": {
      "methods": {
        "execute": {
          "kind": "unary",
          "idempotency": "none",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/DockerExecutionOperationRequest"
          },
          "responseSchema": {
            "$ref": "#/$defs/DockerExecutionOperationResponse"
          }
        }
      }
    }
  },
  "$defs": {
    "DockerOperation": {
      "type": "string",
      "enum": [
        "get-settings",
        "save-settings",
        "add-image",
        "delete-image",
        "refresh-image",
        "refresh-images",
        "pull-image",
        "test-docker"
      ]
    },
    "TimeoutText": {
      "type": "string"
    },
    "ExecutablePath": {
      "type": "string"
    },
    "ImageReference": {
      "type": "string",
      "minLength": 1
    },
    "OperationMessage": {
      "type": "string",
      "minLength": 1
    },
    "DiagnosticCode": {
      "type": "string",
      "minLength": 1
    },
    "CatalogRevision": {
      "type": "integer",
      "minimum": 0
    },
    "ContentReference": {
      "type": "object",
      "logicalType": "content-reference"
    },
    "DockerExecutionOperationError": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/DiagnosticCode"
        },
        "message": {
          "$ref": "#/$defs/OperationMessage"
        },
        "isTransient": {
          "type": "boolean"
        },
        "correlationId": {
          "$ref": "#/$defs/DiagnosticCode"
        }
      },
      "required": [
        "code",
        "message",
        "isTransient",
        "correlationId"
      ],
      "additionalProperties": false
    },
    "DockerExecutionOperationRequest": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/DockerOperation"
        },
        "timeoutSeconds": {
          "$ref": "#/$defs/TimeoutText"
        },
        "dockerCliPath": {
          "$ref": "#/$defs/ExecutablePath"
        },
        "imageReference": {
          "$ref": "#/$defs/ImageReference"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "DockerExecutionOperationResponse": {
      "type": "object",
      "properties": {
        "timeoutSeconds": {
          "$ref": "#/$defs/TimeoutText"
        },
        "dockerCliPath": {
          "$ref": "#/$defs/ExecutablePath"
        },
        "imageCatalog": {
          "$ref": "#/$defs/ContentReference"
        },
        "success": {
          "type": "boolean"
        },
        "message": {
          "$ref": "#/$defs/OperationMessage"
        },
        "catalogRevision": {
          "$ref": "#/$defs/CatalogRevision"
        },
        "error": {
          "$ref": "#/$defs/DockerExecutionOperationError"
        }
      },
      "required": [
        "success"
      ],
      "additionalProperties": false
    }
  }
}
