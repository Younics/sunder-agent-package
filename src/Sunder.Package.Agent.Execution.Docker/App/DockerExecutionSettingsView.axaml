<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sunder.Package.Agent.Execution.Docker"
             xmlns:p="using:Sunder.Package.Agent.Shared.Presentation"
             x:Class="Sunder.Package.Agent.Execution.Docker.DockerExecutionSettingsView"
             x:DataType="vm:DockerExecutionSettingsViewModel" Classes="agent-page">
  <UserControl.Styles><StyleInclude Source="/Presentation/PresentationStyles.axaml" /></UserControl.Styles>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="{DynamicResource Sunder.Padding.Panel}"
                 Spacing="16">
      <Border Classes="card-surface"
              IsVisible="{Binding IsLoading}">
        <TextBlock Text="Loading Docker images and execution settings..."
                   TextWrapping="Wrap" />
      </Border>

      <Border Classes="card-surface"
              IsVisible="{Binding IsError}">
        <StackPanel Spacing="8">
          <TextBlock Classes="section-title"
                     Text="Docker settings could not be loaded" />
          <TextBlock Classes="caption"
                     Text="{Binding StatusText}"
                     TextWrapping="Wrap" />
          <Button Classes="secondary-action"
                  Content="Retry"
                  HorizontalAlignment="Left"
                  Command="{Binding RetryInitializationCommand}" />
        </StackPanel>
      </Border>

      <Border Classes="card-surface"
              IsVisible="{Binding IsReady}"
              IsEnabled="{Binding CanMutate}">
        <StackPanel Spacing="12">
          <p:SectionHeader Title="Docker images" HelpText="Use an explicit image tag or sha256 digest. Tagged images resolve to a local image ID before launch. Containers have bounded resources and no network by default. Writable folder mounts mean Docker execution is not a complete security sandbox." />

          <p:ResponsiveGrid ColumnDefinitions="*,Auto"
                ColumnSpacing="10">
            <TextBox Text="{Binding NewImageReference, Mode=TwoWay}"
                     PlaceholderText="repository/image:1.2.3 or repository/image@sha256:..." />
            <Button Grid.Column="1"
                    Classes="secondary-action"
                    Content="Add Image"
                    Command="{Binding AddImageCommand}" />
          </p:ResponsiveGrid>

          <ListBox ItemsSource="{Binding Images}"
                   SelectedItem="{Binding SelectedImage, Mode=TwoWay}"
                   MinHeight="180"
                   IsVisible="{Binding HasImages}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DockerImageRowViewModel">
                <p:ResponsiveGrid ColumnDefinitions="*,Auto"
                      RowDefinitions="Auto,Auto,Auto"
                      ColumnSpacing="12"
                      RowSpacing="4"
                      Margin="0,6">
                  <TextBlock Text="{Binding ImageReference}"
                             FontWeight="SemiBold"
                             TextWrapping="Wrap" />
                  <Border Grid.Column="1"
                          Padding="8,3"
                          CornerRadius="{DynamicResource Sunder.Radius.Small}"
                          Background="{DynamicResource Sunder.Brush.Info.Soft}">
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="{DynamicResource Sunder.FontSize.Caption}"
                               Foreground="{DynamicResource Sunder.Brush.Accent}" />
                  </Border>
                  <TextBlock Grid.Row="1"
                             Grid.ColumnSpan="2"
                             Classes="caption"
                             Text="{Binding DateText}"
                             TextWrapping="Wrap"
                             IsVisible="{Binding HasDateText}" />
                  <TextBlock Grid.Row="2"
                             Grid.ColumnSpan="2"
                             Classes="caption"
                             Text="{Binding ErrorMessage}"
                             TextWrapping="Wrap"
                             IsVisible="{Binding HasErrorMessage}" />
                </p:ResponsiveGrid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Classes="caption"
                     Text="No images. Add an image reference above."
                     TextWrapping="Wrap"
                     IsVisible="{Binding !HasImages}" />

          <WrapPanel Orientation="Horizontal">
            <Button Classes="primary-action compact-action"
                    Content="Pull Selected"
                    Margin="0,0,8,8"
                    Command="{Binding PullSelectedImageCommand}" />
            <Button Classes="secondary-action compact-action"
                    Content="Refresh Selected"
                    Margin="0,0,8,8"
                    Command="{Binding RefreshSelectedImageCommand}" />
            <Button Classes="secondary-action compact-action"
                    Content="Refresh All"
                    Margin="0,0,8,8"
                    Command="{Binding RefreshAllImagesCommand}" />
            <Button Classes="secondary-action compact-action danger-action"
                    Content="Delete"
                    Margin="0,0,8,8"
                    Command="{Binding DeleteSelectedImageCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border Classes="card-surface"
              IsVisible="{Binding IsReady}"
              IsEnabled="{Binding CanMutate}">
        <StackPanel Spacing="12">
          <p:SectionHeader Title="Timeout (seconds)" HelpText="Default timeout for Docker shell and process commands when no limit is specified." />
          <TextBox Text="{Binding TimeoutSeconds, Mode=TwoWay}"
                    PlaceholderText="300" />
          <StackPanel Spacing="6">
            <p:SectionHeader Title="Docker executable" HelpText="Leave unset to detect Docker Desktop, Homebrew, or a system installation automatically." />
            <p:ResponsiveGrid ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="8">
              <TextBox Text="{Binding DockerCliPath}"
                       IsReadOnly="True"
                       PlaceholderText="Auto-detect" />
              <Button Grid.Column="1"
                      Classes="secondary-action compact-action"
                      Content="Choose..."
                      Click="OnChooseDockerCliClicked" />
              <Button Grid.Column="2"
                      Classes="secondary-action compact-action"
                      Content="Auto-detect"
                      Command="{Binding ClearDockerCliPathCommand}" />
            </p:ResponsiveGrid>
          </StackPanel>
          <WrapPanel Orientation="Horizontal">
            <Button Classes="primary-action"
                    Content="Save Settings"
                    Margin="0,0,8,0"
                    Command="{Binding SaveSettingsCommand}" />
            <Button Classes="secondary-action"
                    Content="Test Docker"
                    Command="{Binding TestDockerCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <TextBlock Classes="caption"
                 Text="{Binding StatusText}"
                 TextWrapping="Wrap"
                 IsVisible="{Binding IsReady}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
