<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <SunderPackageFamilyId>sunder.package.agent.execution.docker</SunderPackageFamilyId>
    <SunderSdkAvaloniaReference>true</SunderSdkAvaloniaReference>
    <SunderSdkStacksReference>true</SunderSdkStacksReference>
    <SunderAgentCurrentPackageStorageKey>true</SunderAgentCurrentPackageStorageKey>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\Sunder.Agent.Worker.props" />
  <Import Project="..\Sunder.Package.Agent\Models\AgentExtensionSources.props" />

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <Compile Include="@(SunderAgentExecutionSource->Distinct())" LinkBase="Domain" />
  </ItemGroup>

  <ItemGroup>
    <SunderSdkCapability Include="docker-environment.v1" />
  </ItemGroup>

  <Import Project="..\Sunder.Package.Agent.Shared\Sunder.Package.Agent.Shared.props" />

</Project>
