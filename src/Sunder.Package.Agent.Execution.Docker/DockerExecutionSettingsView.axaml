<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sunder.Package.Agent.Execution.Docker"
             x:Class="Sunder.Package.Agent.Execution.Docker.DockerExecutionSettingsView"
             x:DataType="vm:DockerExecutionSettingsViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,0,8"
                 Spacing="16">
      <Border Classes="card-surface"
              IsVisible="{Binding IsLoading}">
        <TextBlock Text="Loading Docker images and execution settings..."
                   TextWrapping="Wrap" />
      </Border>

      <Border Classes="card-surface"
              IsVisible="{Binding IsError}">
        <StackPanel Spacing="8">
          <TextBlock Classes="section-title"
                     Text="Docker settings could not be loaded" />
          <TextBlock Classes="caption"
                     Text="{Binding StatusText}"
                     TextWrapping="Wrap" />
          <Button Classes="secondary-action"
                  Content="Retry"
                  HorizontalAlignment="Left"
                  Command="{Binding RetryInitializationCommand}" />
        </StackPanel>
      </Border>

      <Border Classes="card-surface"
              IsVisible="{Binding IsReady}"
              IsEnabled="{Binding CanMutate}">
        <StackPanel Spacing="12">
          <StackPanel Spacing="6">
            <TextBlock Classes="section-title"
                       Text="Docker Images" />
            <TextBlock Classes="caption"
                       Text="Manage images pinned by explicit version tag or sha256 digest. Floating or implicit latest tags are rejected. Containers use bounded resources and no network by default, but writable bind mounts mean Docker execution is not a complete security sandbox."
                       TextWrapping="Wrap" />
          </StackPanel>

          <Grid ColumnDefinitions="*,Auto"
                ColumnSpacing="10">
            <TextBox Text="{Binding NewImageReference, Mode=TwoWay}"
                     PlaceholderText="repository/image:1.2.3 or repository/image@sha256:..." />
            <Button Grid.Column="1"
                    Classes="secondary-action"
                    Content="Add Image"
                    Command="{Binding AddImageCommand}" />
          </Grid>

          <ListBox ItemsSource="{Binding Images}"
                   SelectedItem="{Binding SelectedImage, Mode=TwoWay}"
                   MinHeight="180"
                   IsVisible="{Binding HasImages}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DockerImageRowViewModel">
                <Grid ColumnDefinitions="*,Auto"
                      RowDefinitions="Auto,Auto,Auto"
                      ColumnSpacing="12"
                      RowSpacing="4"
                      Margin="0,6">
                  <TextBlock Text="{Binding ImageReference}"
                             FontWeight="SemiBold"
                             TextWrapping="Wrap" />
                  <Border Grid.Column="1"
                          Padding="8,3"
                          CornerRadius="8"
                          Background="{DynamicResource Sunder.Brush.Info.Soft}">
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="12"
                               Foreground="{DynamicResource Sunder.Brush.Accent}" />
                  </Border>
                  <TextBlock Grid.Row="1"
                             Grid.ColumnSpan="2"
                             Classes="caption"
                             Text="{Binding DateText}"
                             TextWrapping="Wrap"
                             IsVisible="{Binding HasDateText}" />
                  <TextBlock Grid.Row="2"
                             Grid.ColumnSpan="2"
                             Classes="caption"
                             Text="{Binding ErrorMessage}"
                             TextWrapping="Wrap"
                             IsVisible="{Binding HasErrorMessage}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Classes="caption"
                     Text="No Docker images are configured. Add one above before assigning Docker execution to a workspace."
                     TextWrapping="Wrap"
                     IsVisible="{Binding !HasImages}" />

          <WrapPanel Orientation="Horizontal">
            <Button Classes="primary-action compact-action"
                    Content="Pull Selected"
                    Margin="0,0,8,8"
                    Command="{Binding PullSelectedImageCommand}" />
            <Button Classes="secondary-action compact-action"
                    Content="Refresh Selected"
                    Margin="0,0,8,8"
                    Command="{Binding RefreshSelectedImageCommand}" />
            <Button Classes="secondary-action compact-action"
                    Content="Refresh All"
                    Margin="0,0,8,8"
                    Command="{Binding RefreshAllImagesCommand}" />
            <Button Classes="secondary-action compact-action danger-action"
                    Content="Delete Selected"
                    Margin="0,0,8,8"
                    Command="{Binding DeleteSelectedImageCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border Classes="card-surface"
              IsVisible="{Binding IsReady}"
              IsEnabled="{Binding CanMutate}">
        <StackPanel Spacing="12">
          <StackPanel Spacing="6">
            <TextBlock Classes="section-title"
                       Text="Execution" />
            <TextBlock Classes="caption"
                       Text="Default timeout used by Docker shell and process commands."
                       TextWrapping="Wrap" />
          </StackPanel>
          <TextBox Text="{Binding TimeoutSeconds, Mode=TwoWay}"
                    PlaceholderText="300" />
          <StackPanel Spacing="6">
            <TextBlock Classes="caption"
                       Text="Optional Docker CLI path. Leave empty to auto-detect Docker Desktop, Homebrew, or system Docker installs."
                       TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="8">
              <TextBox Text="{Binding DockerCliPath}"
                       IsReadOnly="True"
                       PlaceholderText="Auto-detect" />
              <Button Grid.Column="1"
                      Classes="secondary-action compact-action"
                      Content="Choose..."
                      Click="OnChooseDockerCliClicked" />
              <Button Grid.Column="2"
                      Classes="secondary-action compact-action"
                      Content="Auto-detect"
                      Command="{Binding ClearDockerCliPathCommand}" />
            </Grid>
          </StackPanel>
          <WrapPanel Orientation="Horizontal">
            <Button Classes="primary-action"
                    Content="Save Settings"
                    Margin="0,0,8,0"
                    Command="{Binding SaveSettingsCommand}" />
            <Button Classes="secondary-action"
                    Content="Test Docker"
                    Command="{Binding TestDockerCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <TextBlock Classes="caption"
                 Text="{Binding StatusText}"
                 TextWrapping="Wrap"
                 IsVisible="{Binding IsReady}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
