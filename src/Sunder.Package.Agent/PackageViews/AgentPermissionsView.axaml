<UserControl xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:p="using:Sunder.Package.Agent.Shared.Presentation"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:vm="using:Sunder.Package.Agent.PackageViews"
              xmlns:shared="using:Sunder.Package.Agent.Shared.PackageViews"
              x:Class="Sunder.Package.Agent.PackageViews.AgentPermissionsView"
             x:DataType="vm:AgentPermissionsViewModel"
              mc:Ignorable="d" Classes="agent-page">
  <UserControl.Styles>
    <StyleInclude Source="/Presentation/PresentationStyles.axaml" />
    <Style Selector="ListBox.permission-rows ListBoxItem">
      <Setter Property="Margin" Value="20,0,20,12" />
      <Setter Property="Padding" Value="{DynamicResource Sunder.Padding.Card}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*,Auto"
        RowSpacing="16">
    <StackPanel Spacing="8" Margin="{DynamicResource Sunder.Padding.Panel}">
      <p:SectionHeader Title="Permissions" HelpText="Choose the default decision for each action and request context. Reset restores package defaults; save applies your choices." />
    </StackPanel>

      <Grid Grid.Row="1" RowDefinitions="Auto,*">
        <ListBox Grid.Row="1" Classes="permission-rows" Padding="0" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ItemsSource="{Binding Rows}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:PermissionBoundaryRowViewModel">
              <p:ResponsiveGrid ColumnDefinitions="2*,3*,Auto,Auto"
                    ColumnSpacing="{DynamicResource Sunder.Spacing.Medium}" RowSpacing="{DynamicResource Sunder.Spacing.Small}">
                <TextBlock Text="{Binding ActionDisplayName}"
                           TextWrapping="Wrap" />
                <StackPanel Grid.Column="1"
                            Spacing="2">
                  <p:SectionHeader Title="{Binding BoundaryDisplayName}" HelpText="{Binding BoundaryDescription}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="{DynamicResource Sunder.Spacing.XSmall}">
                  <TextBlock Text="Package default" Classes="caption" />
                  <TextBlock Text="{Binding DefaultDecision}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Spacing="{DynamicResource Sunder.Spacing.XSmall}">
                <TextBlock Text="Decision" Classes="caption" />
                <shared:SunderComboBox
                                        ItemsSource="{Binding Decisions}"
                                        SelectedItem="{Binding SelectedDecision, Mode=TwoWay}" />
                </StackPanel>
              </p:ResponsiveGrid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

    <WrapPanel Grid.Row="2" Margin="{DynamicResource Sunder.Padding.Panel}" ItemSpacing="{DynamicResource Sunder.Spacing.Small}" LineSpacing="{DynamicResource Sunder.Spacing.Small}">
      <Button Classes="primary-action"
              Content="Save"
              Command="{Binding SaveCommand}" />
      <Button Classes="secondary-action"
              Content="Reset To Package Defaults"
              Command="{Binding ResetToPackageDefaultsCommand}" />
      <TextBlock Classes="caption"
                 Text="{Binding StatusText}"
                 TextWrapping="Wrap"
                 VerticalAlignment="Center" />
    </WrapPanel>
  </Grid>
</UserControl>
