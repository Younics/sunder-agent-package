<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:p="using:Sunder.Package.Agent.Shared.Presentation"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:vm="using:Sunder.Package.Agent.PackageViews"
              xmlns:m="using:Sunder.Package.Agent.Contracts.Models"
              xmlns:shared="using:Sunder.Package.Agent.Shared.PackageViews"
              x:Class="Sunder.Package.Agent.PackageViews.AgentProfilesView"
             x:DataType="vm:AgentProfilesViewModel"
              mc:Ignorable="d" Classes="agent-page">

  <UserControl.Styles>
    <StyleInclude Source="/Presentation/PresentationStyles.axaml" />
    <StyleInclude Source="/Presentation/ModelBindingStyles.axaml" />

    <Style Selector="Border.profile-shell">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Raised}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="Border.profile-pane">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Raised}" />
    </Style>

    <Style Selector="Border.profile-list-pane">
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>

    <Style Selector="Border.profile-pane-header">
      <Setter Property="Padding" Value="{DynamicResource Sunder.Padding.Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style Selector="Border.profile-list-body">
      <Setter Property="Padding" Value="{DynamicResource Sunder.Padding.Panel}" />
    </Style>

    <Style Selector="Border.profile-editor-body">
      <Setter Property="Padding" Value="{DynamicResource Sunder.Padding.Panel}" />
      <Setter Property="MaxWidth" Value="{DynamicResource Sunder.Agent.FormWidth}" />
    </Style>

    <Style Selector="Border.profile-actions">
      <Setter Property="Padding" Value="{DynamicResource Sunder.Padding.Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

    <Style Selector="Border.profile-status-message">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Warning.Soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Warning}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Small}" />
      <Setter Property="Padding" Value="{DynamicResource Sunder.Padding.Card}" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style Selector="Border.profile-status-message.success">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Success.Soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Success}" />
    </Style>

    <Style Selector="Border.profile-status-message.error">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Danger.Soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Danger}" />
    </Style>

    <Style Selector="TextBlock.profile-status-message">
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Warning}" />
      <Setter Property="FontSize" Value="{DynamicResource Sunder.FontSize.Caption}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.profile-status-message.success">
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Success}" />
    </Style>

    <Style Selector="TextBlock.profile-status-message.error">
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Danger}" />
    </Style>

    <Style Selector="TextBlock.profile-title">
      <Setter Property="FontSize" Value="{DynamicResource Sunder.FontSize.PageTitle}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Primary}" />
    </Style>

    <Style Selector="TextBlock.profile-caption">
      <Setter Property="FontSize" Value="{DynamicResource Sunder.FontSize.Caption}" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Secondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.profile-field-label">
      <Setter Property="FontSize" Value="{DynamicResource Sunder.FontSize.Body}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Primary}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style Selector="TextBlock.profile-field-help">
      <Setter Property="FontSize" Value="{DynamicResource Sunder.FontSize.Caption}" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Muted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.profile-field-help.warning-text">
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Warning}" />
    </Style>

    <Style Selector="ListBox.profile-list">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Transparent}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="ListBox.profile-list ListBoxItem">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Base}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Small}" />
      <Setter Property="Padding" Value="{DynamicResource Sunder.Padding.Card}" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style Selector="ListBox.profile-list ListBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Hover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Strong}" />
    </Style>

    <Style Selector="ListBox.profile-list ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Info.Soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Accent}" />
    </Style>

    <Style Selector="Button.profile-add-action">
      <Setter Property="Width" Value="36" />
      <Setter Property="MinWidth" Value="36" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="{DynamicResource Sunder.FontSize.PageTitle}" />
      <Setter Property="FontWeight" Value="Regular" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.profile-card">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Popover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Small}" />
      <Setter Property="Padding" Value="{DynamicResource Sunder.Padding.Card}" />
    </Style>

    <Style Selector="Border.profile-editor-empty-state">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Code}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Small}" />
      <Setter Property="Padding" Value="{DynamicResource Sunder.Padding.Card}" />
    </Style>

    <Style Selector="Button.profile-field-icon-action">
      <Setter Property="Width" Value="32" />
      <Setter Property="MinWidth" Value="32" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Transparent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Transparent}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Small}" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Secondary}" />
      <Setter Property="FontSize" Value="{DynamicResource Sunder.FontSize.Body}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.profile-field-icon-action:pointerover">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Hover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Primary}" />
    </Style>

    <Style Selector="Button.warning-action">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Warning.Soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Strong}" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Warning}" />
    </Style>

    <Style Selector="Button.warning-action:pointerover">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Hover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Strong}" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Warning}" />
    </Style>

    <Style Selector="TextBox.profile-instructions">
      <Setter Property="MinHeight" Value="140" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>
  </UserControl.Styles>

  <Border Classes="profile-shell">
    <Grid x:Name="ProfileAdaptiveLayout"
          RowDefinitions="Auto,*"
          ColumnDefinitions="360,*"
          ColumnSpacing="4">
      <Border x:Name="ProfileRuntimeNoticeBanner"
              Grid.Row="0"
              Grid.ColumnSpan="2"
              Classes="profile-status-message"
              Margin="18,18,18,12"
              IsVisible="{Binding HasRuntimeNotice}">
        <TextBlock Classes="profile-status-message"
                   Text="{Binding RuntimeNoticeText}" />
      </Border>

      <Border x:Name="ProfileListPane"
              Grid.Row="1"
              Classes="profile-pane profile-list-pane"
              IsVisible="{Binding ShowListPane}">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0"
                  Classes="profile-pane-header">
            <Grid ColumnDefinitions="*,Auto"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="8">
              <TextBlock Grid.Column="0"
                         Classes="profile-title"
                         Text="Agents"
                         VerticalAlignment="Center" />
              <Button Grid.Column="1"
                      Classes="secondary-action compact-action profile-add-action"
                      Content="+"
                      Command="{Binding CreateProfileCommand}"
                      ToolTip.Tip="New profile" />
            </Grid>
          </Border>

          <Border Grid.Row="1"
                  Classes="profile-list-body">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <ListBox Classes="profile-list"
                       IsEnabled="{Binding CanNavigateProfiles}"
                       ItemsSource="{Binding Profiles}"
                       SelectedItem="{Binding SelectedProfile, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="m:AgentProfileRecord">
                    <Grid RowDefinitions="Auto,Auto"
                          RowSpacing="3"
                          MinWidth="0"
                          Tapped="OnProfileItemTapped">
                      <TextBlock Text="{Binding DisplayName}"
                                 FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Row="1"
                                 Text="{Binding Description}"
                                 Foreground="{DynamicResource Sunder.Brush.Foreground.Muted}"
                                 FontSize="{DynamicResource Sunder.FontSize.Caption}"
                                 TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </ScrollViewer>
          </Border>
        </Grid>
      </Border>

      <Border x:Name="ProfileEditorPane"
              Grid.Row="1"
              Grid.Column="1"
              Classes="profile-pane"
              IsVisible="{Binding ShowEditorPane}">
        <Grid RowDefinitions="Auto,*,Auto">
          <Border Grid.Row="0"
                  Classes="profile-pane-header">
            <StackPanel Spacing="8">
              <TextBlock Classes="profile-title"
                          Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>

          <ScrollViewer Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <Border Classes="profile-editor-body">
              <StackPanel Spacing="{DynamicResource Sunder.Spacing.Large}"
                          IsEnabled="{Binding IsEditorEnabled}">
                <Border Classes="profile-card">
                  <StackPanel Spacing="{DynamicResource Sunder.Spacing.Medium}">
                    <StackPanel Spacing="5">
                      <TextBlock Classes="profile-field-label"
                                 Text="Display name" />
                      <TextBox x:Name="ProfileDisplayNameTextBox"
                               Text="{Binding DisplayName, Mode=TwoWay}"
                               PlaceholderText="Profile name" />
                    </StackPanel>

                    <StackPanel Spacing="5">
                      <TextBlock Classes="profile-field-label"
                                 Text="Description" />
                      <TextBox Text="{Binding Description, Mode=TwoWay}"
                               PlaceholderText="Description" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Border Classes="profile-card">
                  <StackPanel Spacing="{DynamicResource Sunder.Spacing.Small}">
                    <p:SectionHeader Title="Instructions" HelpText="Instructions used by this agent in its sessions." />
                    <TextBox Classes="profile-instructions" Text="{Binding Instructions, Mode=TwoWay}"
                             AcceptsReturn="True" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <Border Classes="profile-card">
                  <StackPanel Spacing="{DynamicResource Sunder.Spacing.Medium}">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">
                      <p:SectionHeader Title="Chat model" HelpText="Used for this agent's replies and tool calls. Provider availability and model options are shown below." />
                      <Button Grid.Column="1"
                              Classes="profile-field-icon-action"
                              Content="↻"
                              Command="{Binding ReloadProfileProvidersCommand}"
                              ToolTip.Tip="Reload providers" />
                    </Grid>

                    <Border Classes="profile-editor-empty-state"
                            IsVisible="{Binding HasNoChatProviders}">
                      <TextBlock Classes="profile-field-help"
                                 Text="Install a chat provider to choose a model." />
                    </Border>

                    <StackPanel Spacing="5"
                                IsVisible="{Binding ShowChatProviderPicker}">
                      <TextBlock Classes="profile-field-label"
                                 Text="Chat provider" />
                       <shared:SunderComboBox ItemsSource="{Binding ChatProviders}"
                                             SelectedItem="{Binding SelectedChatProvider, Mode=TwoWay}"
                                             ItemTemplate="{StaticResource ModelBindingProviderOptionTemplate}"
                                             HorizontalAlignment="Stretch">
                      </shared:SunderComboBox>
                    </StackPanel>

                    <Border Classes="profile-editor-empty-state"
                            IsVisible="{Binding ShowChatProviderWarning}">
                      <Grid ColumnDefinitions="*,Auto"
                            ColumnSpacing="12">
                        <TextBlock Classes="profile-field-help warning-text"
                                   Text="{Binding ChatProviderWarningText}"
                                   VerticalAlignment="Top" />
                        <Button Grid.Column="1"
                                Classes="secondary-action compact-action warning-action"
                                Content="Settings"
                                Command="{Binding OpenSelectedChatProviderSettingsCommand}"
                                IsVisible="{Binding CanOpenChatProviderSettings}"
                                VerticalAlignment="Top" />
                      </Grid>
                    </Border>

                    <StackPanel Spacing="5"
                                IsVisible="{Binding ShowChatModelSelection}">
                      <TextBlock Classes="profile-field-label"
                                 Text="Chat model" />
                       <shared:SunderComboBox ItemsSource="{Binding ChatModels}"
                                             SelectedItem="{Binding SelectedChatModel, Mode=TwoWay}"
                                             ItemTemplate="{StaticResource ModelBindingModelOptionTemplate}"
                                             HorizontalAlignment="Stretch">
                      </shared:SunderComboBox>
                    </StackPanel>

                    <StackPanel Spacing="5"
                                IsVisible="{Binding ShowSpeedOptions}">
                      <TextBlock Classes="profile-field-label"
                                 Text="Speed" />
                       <shared:SunderComboBox ItemsSource="{Binding SpeedOptions}"
                                             SelectedItem="{Binding SelectedSpeedOption, Mode=TwoWay}"
                                             ItemTemplate="{StaticResource ModelBindingSpeedOptionTemplate}"
                                             HorizontalAlignment="Stretch">
                      </shared:SunderComboBox>
                    </StackPanel>

                    <StackPanel Spacing="5"
                                IsVisible="{Binding ShowReasoningOptions}">
                      <TextBlock Classes="profile-field-label"
                                 Text="Reasoning" />
                       <shared:SunderComboBox ItemsSource="{Binding ReasoningOptions}"
                                              SelectedItem="{Binding SelectedReasoningOption, Mode=TwoWay}"
                                              IsEnabled="{Binding IsReasoningSelectionEnabled}"
                                               ItemTemplate="{StaticResource ModelBindingReasoningOptionTemplate}"
                                               ItemContainerTheme="{StaticResource ModelBindingReasoningItemTheme}"
                                             HorizontalAlignment="Stretch">
                      </shared:SunderComboBox>
                    </StackPanel>

                    <Expander Header="Advanced model options" IsVisible="{Binding ShowModeOptions}">
                    <StackPanel Spacing="5">
                      <TextBlock Classes="profile-field-label"
                                 Text="Mode" />
                       <shared:SunderComboBox ItemsSource="{Binding ModeOptions}"
                                             SelectedItem="{Binding SelectedModeOption, Mode=TwoWay}"
                                             ItemTemplate="{StaticResource ModelBindingModeOptionTemplate}"
                                             HorizontalAlignment="Stretch">
                       </shared:SunderComboBox>
                    </StackPanel>
                    </Expander>
                  </StackPanel>
                </Border>

                <Border Classes="profile-card"
                        IsVisible="{Binding ShowEmbeddingsSection}">
                  <StackPanel Spacing="{DynamicResource Sunder.Spacing.Medium}">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">
                      <p:SectionHeader Title="Embeddings" HelpText="Used by capabilities that search for related content, such as semantic memory." />
                      <Button Grid.Column="1"
                              Classes="profile-field-icon-action"
                              Content="↻"
                              Command="{Binding ReloadProfileProvidersCommand}"
                              ToolTip.Tip="Reload providers" />
                    </Grid>

                    <Border Classes="profile-editor-empty-state"
                            IsVisible="{Binding ShowEmbeddingProviderEmptyState}">
                      <TextBlock Classes="profile-field-help"
                                 Text="Install an embedding provider to enable semantic features." />
                    </Border>

                    <StackPanel Spacing="5"
                                IsVisible="{Binding ShowEmbeddingProviderPicker}">
                      <TextBlock Classes="profile-field-label"
                                 Text="Embedding provider" />
                       <shared:SunderComboBox ItemsSource="{Binding EmbeddingProviders}"
                                             SelectedItem="{Binding SelectedEmbeddingProvider, Mode=TwoWay}"
                                             ItemTemplate="{StaticResource ModelBindingProviderOptionTemplate}"
                                             HorizontalAlignment="Stretch">
                      </shared:SunderComboBox>
                    </StackPanel>

                    <Border Classes="profile-editor-empty-state"
                            IsVisible="{Binding ShowEmbeddingProviderWarning}">
                      <Grid ColumnDefinitions="*,Auto"
                            ColumnSpacing="12">
                        <TextBlock Classes="profile-field-help warning-text"
                                   Text="{Binding EmbeddingProviderWarningText}"
                                   VerticalAlignment="Top" />
                        <Button Grid.Column="1"
                                Classes="secondary-action compact-action warning-action"
                                Content="Settings"
                                Command="{Binding OpenSelectedEmbeddingProviderSettingsCommand}"
                                IsVisible="{Binding CanOpenEmbeddingProviderSettings}"
                                VerticalAlignment="Top" />
                      </Grid>
                    </Border>

                    <StackPanel Spacing="5"
                                IsVisible="{Binding ShowEmbeddingModelSelection}">
                      <TextBlock Classes="profile-field-label"
                                 Text="Embedding model" />
                       <shared:SunderComboBox ItemsSource="{Binding EmbeddingModels}"
                                             SelectedItem="{Binding SelectedEmbeddingModel, Mode=TwoWay}"
                                             IsEnabled="{Binding CanSelectEmbeddingModel}"
                                             ItemTemplate="{StaticResource ModelBindingModelOptionTemplate}"
                                             HorizontalAlignment="Stretch">
                      </shared:SunderComboBox>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Border Classes="profile-card">
                  <StackPanel Spacing="{DynamicResource Sunder.Spacing.Small}">
                    <p:SectionHeader Title="Behavior" HelpText="The behavior loop controls how the agent runs. Default uses the standard agent loop." />
                    <shared:SunderComboBox ItemsSource="{Binding BehaviorLoops}"
                                          SelectedItem="{Binding SelectedBehaviorLoop, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch">
                      <shared:SunderComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:BehaviorLoopOption">
                          <TextBlock Text="{Binding Label}" ToolTip.Tip="{Binding Description}" />
                        </DataTemplate>
                      </shared:SunderComboBox.ItemTemplate>
                    </shared:SunderComboBox>
                  </StackPanel>
                </Border>

                <Border Classes="profile-card"
                        IsVisible="{Binding HasToolCallingConfiguration}">
                  <StackPanel Spacing="{DynamicResource Sunder.Spacing.Medium}">
                    <p:SectionHeader Title="Capabilities" HelpText="Selected capabilities are available to this agent. Permissions and workspace access still apply. Changes take effect when you save." />

                    <ItemsControl ItemsSource="{Binding CapabilityGroups}"
                                  ItemTemplate="{StaticResource CapabilityGroupTemplate}" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </ScrollViewer>

          <Border Grid.Row="2"
                  Classes="profile-actions">
            <Grid RowDefinitions="Auto,Auto">
              <Border Grid.Row="0"
                      Classes="profile-status-message"
                      Classes.success="{Binding IsStatusSuccess}"
                      Classes.warning="{Binding IsStatusWarning}"
                      Classes.error="{Binding IsStatusError}"
                      IsVisible="{Binding HasStatusText}">
                <TextBlock Classes="profile-status-message"
                           Classes.success="{Binding IsStatusSuccess}"
                           Classes.warning="{Binding IsStatusWarning}"
                           Classes.error="{Binding IsStatusError}"
                           Text="{Binding StatusText}" />
              </Border>

              <p:EditorFooter Grid.Row="1">
                <Button Grid.Column="0"
                        Classes="secondary-action compact-action danger-action"
                        Content="Delete"
                        Command="{Binding DeleteProfileCommand}" />
                <TextBlock Grid.Column="1"
                           Text="Unsaved changes"
                           IsVisible="{Binding IsDirty}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Sunder.Brush.Foreground.Muted}"
                           FontSize="{DynamicResource Sunder.FontSize.Caption}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{DynamicResource Sunder.Spacing.Small}">
                <Button
                        Classes="secondary-action compact-action"
                        Content="Back"
                        Command="{Binding BackToProfileListCommand}"
                        IsVisible="{Binding IsCompactLayout}" />
                <Button
                        Classes="primary-action"
                        Content="Save"
                        Command="{Binding SaveProfileCommand}" />
                </StackPanel>
              </p:EditorFooter>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
