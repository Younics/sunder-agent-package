<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Sunder.Package.Agent.PackageViews"
             xmlns:m="using:Sunder.Package.Agent.Contracts.Models"
             xmlns:agentModels="using:Sunder.Package.Agent.Models"
             xmlns:shared="using:Sunder.Package.Agent.Shared.PackageViews"
             xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
             x:Class="Sunder.Package.Agent.PackageViews.AgentChatView"
             x:DataType="vm:AgentChatViewModel"
             mc:Ignorable="d">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://LiveMarkdown.Avalonia/Defaults.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <StreamGeometry x:Key="AgentChat.Icon.Workspace">M3.25 3.25 L7.25 3.25 L7.25 7.25 L3.25 7.25 Z M8.75 3.25 L12.75 3.25 L12.75 7.25 L8.75 7.25 Z M3.25 8.75 L7.25 8.75 L7.25 12.75 L3.25 12.75 Z M8.75 8.75 L12.75 8.75 L12.75 12.75 L8.75 12.75 Z</StreamGeometry>
      <StreamGeometry x:Key="AgentChat.Icon.Path">M2.75 5.25 L6.25 5.25 L7.3 6.45 L13.25 6.45 L13.25 12.25 L2.75 12.25 Z</StreamGeometry>

      <DataTemplate x:Key="WorkspaceSelectionBoxTemplate"
                    x:DataType="m:AgentWorkspaceRecord">
        <Grid ColumnDefinitions="Auto,*"
              ColumnSpacing="8"
              MinWidth="0">
          <Path Classes="header-select-icon fill"
                Data="{StaticResource AgentChat.Icon.Workspace}" />
          <TextBlock Grid.Column="1"
                     Text="{Binding DisplayName}"
                     MinWidth="0"
                     MaxLines="1"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
        </Grid>
      </DataTemplate>

      <DataTemplate x:Key="WorkspaceDropDownItemTemplate"
                    x:DataType="m:AgentWorkspaceRecord">
        <Grid ColumnDefinitions="Auto,*"
              ColumnSpacing="9"
              MinWidth="0">
          <Path Classes="header-select-icon fill"
                Data="{StaticResource AgentChat.Icon.Workspace}" />
          <TextBlock Grid.Column="1"
                     Text="{Binding DisplayName}"
                     MinWidth="0"
                     MaxLines="2"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
        </Grid>
      </DataTemplate>

      <DataTemplate x:Key="AgentSelectionBoxTemplate"
                    x:DataType="m:AgentProfileRecord">
        <Grid ColumnDefinitions="Auto,*"
              ColumnSpacing="8"
              MinWidth="0">
          <Image Classes="header-select-image"
                 Source="avares://Sunder.Package.Agent/Assets/profile-icon.png" />
          <TextBlock Grid.Column="1"
                     Text="{Binding DisplayName}"
                     MinWidth="0"
                     MaxLines="1"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
        </Grid>
      </DataTemplate>

      <DataTemplate x:Key="AgentDropDownItemTemplate"
                    x:DataType="m:AgentProfileRecord">
        <Grid ColumnDefinitions="Auto,*"
              ColumnSpacing="9"
              MinWidth="0">
          <Image Classes="header-select-image"
                 Source="avares://Sunder.Package.Agent/Assets/profile-icon.png" />
          <TextBlock Grid.Column="1"
                     Text="{Binding DisplayName}"
                     MinWidth="0"
                     MaxLines="2"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
        </Grid>
      </DataTemplate>

      <DataTemplate x:Key="SessionSelectionBoxTemplate"
                    x:DataType="vm:AgentSessionListItemViewModel">
        <Grid ColumnDefinitions="Auto,*"
              ColumnSpacing="8"
              MinWidth="0">
          <Border Classes="session-status-icon"
                  Background="{Binding StatusBrush}"
                  ToolTip.Tip="{Binding StatusBadgeText}">
            <Border.OpacityMask>
              <ImageBrush Source="avares://Sunder.Package.Agent/Assets/session-icon.png"
                          Stretch="Uniform" />
            </Border.OpacityMask>
          </Border>
          <TextBlock Grid.Column="1"
                     Text="{Binding Title}"
                     MinWidth="0"
                     MaxLines="1"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
        </Grid>
      </DataTemplate>

      <DataTemplate x:Key="SessionDropDownItemTemplate"
                    x:DataType="vm:AgentSessionListItemViewModel">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto"
              ColumnSpacing="10"
              MinWidth="0"
              Margin="0,2">
          <Border Classes="session-status-icon"
                  Background="{Binding StatusBrush}"
                  ToolTip.Tip="{Binding StatusBadgeText}">
            <Border.OpacityMask>
              <ImageBrush Source="avares://Sunder.Package.Agent/Assets/session-icon.png"
                          Stretch="Uniform" />
            </Border.OpacityMask>
          </Border>
          <TextBlock Grid.Column="1"
                     Text="{Binding Title}"
                     MinWidth="0"
                     MaxLines="1"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center"
                     IsVisible="{Binding !IsRenameActive}" />
          <TextBox Grid.Column="1"
                   Classes="session-rename-input"
                   Text="{Binding RenameTitle, Mode=TwoWay}"
                   AttachedToVisualTree="OnSessionRenameTextBoxAttachedToVisualTree"
                   LayoutUpdated="OnSessionRenameTextBoxLayoutUpdated"
                   KeyDown="OnSessionRenameKeyDown"
                   PointerReleased="OnSessionRenameInputInteraction"
                   Tapped="OnSessionRenameInputInteraction"
                   IsVisible="{Binding IsRenameActive}" />
          <Button Grid.Column="2"
                  Classes="session-row-action"
                  Content="⋯"
                  Click="OnSessionActionsClick"
                  ToolTip.Tip="Session actions"
                  IsVisible="{Binding !IsRenameActive}" />
          <Button Grid.Column="2"
                  Classes="session-row-action confirm"
                  Content="✓"
                  Command="{Binding $parent[UserControl].DataContext.SaveSessionRenameCommand}"
                  CommandParameter="{Binding}"
                  ToolTip.Tip="Save session name"
                  IsVisible="{Binding IsRenameActive}" />
          <Button Grid.Column="3"
                  Classes="session-row-action"
                  Content="×"
                  Command="{Binding $parent[UserControl].DataContext.CancelSessionRenameCommand}"
                  CommandParameter="{Binding}"
                  ToolTip.Tip="Cancel rename"
                  IsVisible="{Binding IsRenameActive}" />
        </Grid>
      </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <StyleInclude Source="avares://LiveMarkdown.Avalonia/Styles.axaml" />
    <StyleInclude Source="avares://Sunder.Package.Agent/PackageViews/TranscriptStyles.axaml" />

    <Style Selector="Border.agent-chat-shell">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Workspace}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="Border.agent-chat-header">
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="14,10,14,8" />
    </Style>

    <Style Selector="Path.header-select-icon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Path.header-select-icon.fill">
      <Setter Property="Fill" Value="{DynamicResource Sunder.Brush.Accent}" />
    </Style>

    <Style Selector="Path.header-select-icon.stroke">
      <Setter Property="Stroke" Value="{DynamicResource Sunder.Brush.Accent}" />
      <Setter Property="StrokeThickness" Value="1.7" />
      <Setter Property="StrokeLineCap" Value="Round" />
    </Style>

    <Style Selector="Path.header-select-icon.stroke.muted">
      <Setter Property="Stroke" Value="{DynamicResource Sunder.Brush.Foreground.Muted}" />
    </Style>

    <Style Selector="Image.header-select-image">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.session-status-icon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="ComboBox.header-select, ComboBox.composer-agent-select">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Popover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Primary}" />
    </Style>

    <Style Selector="ComboBox.header-select:pointerover, ComboBox.composer-agent-select:pointerover">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Hover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
    </Style>

    <Style Selector="ComboBox.header-select:focus, ComboBox.header-select:focus-within, ComboBox.header-select:focus-visible, ComboBox.composer-agent-select:focus, ComboBox.composer-agent-select:focus-within, ComboBox.composer-agent-select:focus-visible">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Popover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Strong}" />
    </Style>

    <Style Selector="ComboBox.composer-agent-select">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MaxWidth" Value="360" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style Selector="TextBlock.agent-title">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Primary}" />
    </Style>

    <Style Selector="Button.header-action">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.session-row-action">
      <Setter Property="Width" Value="28" />
      <Setter Property="MinWidth" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Transparent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Transparent}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Small}" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Muted}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.session-row-action:pointerover">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Hover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Primary}" />
    </Style>

    <Style Selector="Button.session-row-action.confirm">
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Accent}" />
    </Style>

    <Style Selector="TextBox.session-rename-input">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Grid.context-path-row">
      <Setter Property="Margin" Value="0,8,0,0" />
      <Setter Property="MinWidth" Value="0" />
    </Style>

    <Style Selector="Border.context-path-chip">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Popover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Small}" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.context-path-chip.more">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Transparent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
    </Style>

    <Style Selector="Path.context-path-icon">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Stroke" Value="{DynamicResource Sunder.Brush.Foreground.Muted}" />
      <Setter Property="StrokeThickness" Value="1.4" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,1,0,0" />
    </Style>

    <Style Selector="TextBlock.context-path-text">
      <Setter Property="FontFamily" Value="Menlo,Consolas,monospace" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Secondary}" />
      <Setter Property="MaxLines" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.context-path-more-text">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Muted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.status-pill">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Success.Soft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Full}" />
      <Setter Property="Padding" Value="12,6" />
    </Style>

    <Style Selector="Border.transcript-surface">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Workspace}" />
    </Style>

    <Style Selector="Border.setup-card">
      <Setter Property="MaxWidth" Value="560" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Base}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Medium}" />
      <Setter Property="Padding" Value="24" />
      <Setter Property="Margin" Value="0,48,0,0" />
    </Style>

    <Style Selector="TextBlock.setup-title">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Primary}" />
    </Style>

    <Style Selector="TextBlock.setup-description">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Secondary}" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="LineHeight" Value="22" />
    </Style>

    <Style Selector="Border.message-bubble TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Primary}" />
    </Style>

    <Style Selector="TextBlock.message-header">
      <Setter Property="Margin" Value="2,0,0,1" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Muted}" />
      <Setter Property="MaxLines" Value="1" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Opacity" Value="0.78" />
    </Style>

    <Style Selector="TextBlock.message-header.user">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Margin" Value="0,0,2,1" />
    </Style>

    <Style Selector="Border.activity-pulse-dot">
      <Setter Property="Width" Value="6" />
      <Setter Property="Height" Value="6" />
      <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Full}" />
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Accent}" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,7,0,0" />
      <Style.Animations>
        <Animation Duration="0:0:1.3"
                   IterationCount="INFINITE"
                   PlaybackDirection="Alternate">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0.42" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="0.96" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="TextBlock.activity-text">
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Muted}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Regular" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="MaxLines" Value="5" />
      <Setter Property="LineHeight" Value="19" />
      <Setter Property="Opacity" Value="0.82" />
    </Style>

    <Style Selector="Border.message-copy-host">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Transparent}" />
    </Style>

    <Style Selector="Border.message-copy-host Button.message-copy-action">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style Selector="Border.message-copy-host:pointerover Button.message-copy-action">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>

    <Style Selector="Button.message-copy-action">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Small}" />
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Transparent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Transparent}" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Muted}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.message-copy-action.user">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style Selector="Button.message-copy-action:pointerover">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Hover}" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Primary}" />
    </Style>

    <Style Selector="Button.tool-step-header:pointerover">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Popover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Strong}" />
    </Style>

    <Style Selector="Button.tool-step-header:pressed">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Code}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
    </Style>

    <Style Selector="Button.tool-step-header:focus, Button.tool-step-header:focus-within, Button.tool-step-header:focus-visible">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Code}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
    </Style>

    <Style Selector="Border.tool-output-card">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Workspace}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Small}" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Border.tool-output-header">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Raised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="CornerRadius" Value="7,7,0,0" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="MinWidth" Value="0" />
    </Style>

    <Style Selector="Border.tool-output-body">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Workspace}" />
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="MinWidth" Value="0" />
    </Style>

    <Style Selector="TextBlock.output-text">
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Secondary}" />
      <Setter Property="FontFamily" Value="Menlo,Consolas,monospace" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="Border.metadata-bar">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Popover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="MinWidth" Value="0" />
    </Style>

    <Style Selector="Border.metadata-pill">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Small}" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="MinWidth" Value="0" />
    </Style>

    <Style Selector="Border.metadata-pill.error">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Danger.Soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Danger}" />
    </Style>

    <Style Selector="Border.metadata-pill.neutral">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Base}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
    </Style>

    <Style Selector="Border.permission-card">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Warning.Soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Warning}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Small}" />
      <Setter Property="Padding" Value="14" />
    </Style>

    <Style Selector="Border.composer-surface">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Base}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Padding" Value="8" />
    </Style>

    <Style Selector="Border.composer-surface.drop-target-active">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.DragOver}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Accent}" />
    </Style>

    <Style Selector="TextBox.composer-input">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Popover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Small}" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Primary}" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style Selector="TextBox.composer-input /template/ TextBlock#PART_Watermark">
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Muted}" />
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="TextBox.composer-input.drop-target-active">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.DragOver}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Accent}" />
    </Style>

    <Style Selector="TextBox.composer-input.expanded">
      <Setter Property="Height" Value="NaN" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Button.composer-action, ToggleButton.composer-action">
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Small}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.composer-action.clear">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="ToggleButton.composer-action">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Popover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Secondary}" />
    </Style>

    <Style Selector="ToggleButton.composer-action:checked">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Info.Soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Accent}" />
    </Style>

    <Style Selector="Border.attachment-chip">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Popover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Small}" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="MaxWidth" Value="260" />
    </Style>

    <Style Selector="Border.attachment-tray">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Popover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Small}" />
      <Setter Property="Padding" Value="8,6" />
    </Style>

    <Style Selector="Border.attachment-badge">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Info.Soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Accent}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Small}" />
      <Setter Property="Padding" Value="5,2" />
    </Style>

    <Style Selector="TextBlock.attachment-badge-text">
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Accent}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.attachment-remove">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Transparent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Transparent}" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Muted}" />
      <Setter Property="FontSize" Value="14" />
    </Style>

    <Style Selector="Button.attachment-preview-button">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Transparent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Transparent}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Border.attachment-preview-backdrop">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Overlay.Backdrop}" />
    </Style>

    <Style Selector="Border.attachment-preview-card">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Base}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Strong}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Medium}" />
      <Setter Property="Padding" Value="14" />
    </Style>

    <Style Selector="Image.attachment-preview-image">
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="MaxWidth" Value="1100" />
      <Setter Property="MaxHeight" Value="760" />
    </Style>

    <Style Selector="Button.preview-close">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>
    <DataTemplate x:DataType="shared:ToolDiffFileViewModel">
      <Border Classes="tool-diff-file-card"
              Margin="0,0,0,8"
              MinWidth="0"
              HorizontalAlignment="Stretch">
        <Grid RowDefinitions="Auto,Auto"
              MinWidth="0"
              HorizontalAlignment="Stretch">
          <Border Classes="tool-diff-file-header">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                  ColumnSpacing="10"
                  MinWidth="0">
              <TextBlock Grid.Column="0"
                         Classes="tool-diff-operation"
                         Text="{Binding OperationText}"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                         Classes="tool-diff-path"
                         Text="{Binding Path}"
                         ToolTip.Tip="{Binding Path}"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="2"
                         Classes="tool-diff-added-count"
                         Text="{Binding AddedLineCountText}"
                         IsVisible="{Binding HasAddedLines}"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="3"
                         Classes="tool-diff-deleted-count"
                         Text="{Binding DeletedLineCountText}"
                         IsVisible="{Binding HasDeletedLines}"
                         VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ItemsControl Grid.Row="1"
                        ItemsSource="{Binding Lines}"
                        MinWidth="0"
                        HorizontalAlignment="Stretch">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="shared:ToolDiffLineViewModel">
                <Border Classes="tool-diff-line"
                        Classes.added="{Binding IsAdded}"
                        Classes.deleted="{Binding IsDeleted}"
                        Classes.hunk="{Binding IsHunk}"
                        Classes.collapsed="{Binding IsCollapsed}">
                  <Grid ColumnDefinitions="56,1,*"
                        ColumnSpacing="8"
                        MinWidth="0">
                    <TextBlock Classes="tool-diff-line-number"
                               Text="{Binding LineNumberText}" />
                    <Border Grid.Column="1"
                            Classes="tool-diff-line-separator" />
                    <TextBlock Grid.Column="2"
                               Classes="tool-diff-content"
                               Classes.added="{Binding IsAdded}"
                               Classes.deleted="{Binding IsDeleted}"
                               Classes.hunk="{Binding IsHunk}"
                               Classes.collapsed="{Binding IsCollapsed}"
                               Text="{Binding Text}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:DataType="vm:AgentPendingAttachmentViewModel">
      <Border Classes="attachment-chip"
              Margin="0,0,8,0">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="6">
          <Button Grid.Column="0"
                  Classes="attachment-preview-button"
                  Command="{Binding $parent[UserControl].DataContext.OpenPendingAttachmentPreviewCommand}"
                  CommandParameter="{Binding}"
                  ToolTip.Tip="{Binding PreviewToolTipText}">
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="8">
              <Border Classes="attachment-badge">
                <TextBlock Classes="attachment-badge-text"
                           Text="{Binding BadgeText}" />
              </Border>
              <StackPanel Grid.Column="1"
                          MinWidth="0">
                <TextBlock Text="{Binding FileName}"
                           MaxLines="1"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding DetailText}"
                           FontSize="11"
                           MaxLines="1"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Sunder.Brush.Foreground.Muted}" />
              </StackPanel>
            </Grid>
          </Button>
          <Button Grid.Column="1"
                  Classes="attachment-remove"
                  Content="x"
                  Command="{Binding $parent[UserControl].DataContext.RemovePendingAttachmentCommand}"
                  CommandParameter="{Binding}"
                  ToolTip.Tip="Remove attachment" />
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:DataType="vm:AgentActivityTranscriptRowViewModel">
      <Grid ColumnDefinitions="42,*"
            ColumnSpacing="16"
            Margin="0,0,0,22"
            MinWidth="0"
            HorizontalAlignment="Stretch">
        <Border Classes="message-avatar"
                VerticalAlignment="Top">
          <TextBlock Classes="avatar-glyph"
                     Text="{Binding RoleGlyph}" />
        </Border>

        <Grid Grid.Column="1"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="9"
              MinWidth="0"
              Margin="0,11,0,0"
              VerticalAlignment="Top">
          <Border Classes="activity-pulse-dot" />
          <TextBlock Grid.Column="1"
                     Classes="activity-text"
                     Text="{Binding ThinkingText}" />
        </Grid>
      </Grid>
    </DataTemplate>

    <DataTemplate x:DataType="vm:AgentTextTranscriptRowViewModel">
      <Grid Margin="0,0,0,30"
            MinWidth="0"
            HorizontalAlignment="Stretch">
        <Grid ColumnDefinitions="42,*"
              ColumnSpacing="16"
              MinWidth="0"
              HorizontalAlignment="Stretch"
              IsVisible="{Binding IsNotUser}">
          <Border Classes="message-avatar"
                  VerticalAlignment="Top">
            <TextBlock Classes="avatar-glyph"
                       Text="{Binding RoleGlyph}" />
          </Border>

          <Border Grid.Column="1"
                  MinWidth="0"
                  Classes="message-copy-host">
            <StackPanel Spacing="4"
                        MinWidth="0">
              <TextBlock Classes="message-header"
                         Text="{Binding MessageHeaderText}"
                         IsVisible="{Binding ShowMessageHeader}" />
              <Border Classes="message-bubble"
                      MinWidth="0">
                <StackPanel Spacing="10"
                            MinWidth="0">
                  <md:MarkdownRenderer MarkdownBuilder="{Binding MarkdownBuilder}"
                                       MinWidth="0"
                                       HorizontalAlignment="Stretch"
                                       IsVisible="{Binding HasContent}" />
                  <ItemsControl ItemsSource="{Binding Attachments}"
                                MinWidth="0"
                                IsVisible="{Binding HasAttachments}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:AgentTranscriptAttachmentViewModel">
                        <Button Classes="attachment-preview-button"
                                Command="{Binding $parent[UserControl].DataContext.OpenTranscriptAttachmentPreviewCommand}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="{Binding PreviewToolTipText}">
                          <Border Classes="attachment-chip"
                                  Margin="0,0,8,8">
                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="8">
                              <Border Classes="attachment-badge">
                                <TextBlock Classes="attachment-badge-text"
                                            Text="{Binding BadgeText}" />
                              </Border>
                              <StackPanel Grid.Column="1"
                                          MinWidth="0">
                                <TextBlock Text="{Binding FileName}"
                                           MaxLines="1"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding DetailText}"
                                           FontSize="11"
                                           MaxLines="1"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Sunder.Brush.Foreground.Muted}" />
                              </StackPanel>
                            </Grid>
                          </Border>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Button Classes="message-copy-action"
                      Content="⧉"
                      Tag="{Binding Content}"
                      Click="CopyTranscriptText_OnClick"
                      ToolTip.Tip="Copy response"
                      IsVisible="{Binding HasContent}" />
            </StackPanel>
          </Border>
        </Grid>

        <Grid ColumnDefinitions="*"
              MinWidth="0"
              HorizontalAlignment="Stretch"
              IsVisible="{Binding IsUser}">
          <Border Classes="message-copy-host"
                  MinWidth="0">
            <StackPanel Spacing="4"
                        MinWidth="0">
              <TextBlock Classes="message-header user"
                         Text="{Binding MessageHeaderText}"
                         IsVisible="{Binding ShowMessageHeader}" />
              <Border Classes="message-bubble user"
                      MinWidth="0">
                <StackPanel Spacing="10"
                            MinWidth="0">
                  <md:MarkdownRenderer MarkdownBuilder="{Binding MarkdownBuilder}"
                                       MinWidth="0"
                                       HorizontalAlignment="Stretch"
                                       IsVisible="{Binding HasContent}" />
                  <ItemsControl ItemsSource="{Binding Attachments}"
                                MinWidth="0"
                                IsVisible="{Binding HasAttachments}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:AgentTranscriptAttachmentViewModel">
                        <Button Classes="attachment-preview-button"
                                Command="{Binding $parent[UserControl].DataContext.OpenTranscriptAttachmentPreviewCommand}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="{Binding PreviewToolTipText}">
                          <Border Classes="attachment-chip"
                                  Margin="0,0,8,8">
                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="8">
                              <Border Classes="attachment-badge">
                                <TextBlock Classes="attachment-badge-text"
                                            Text="{Binding BadgeText}" />
                              </Border>
                              <StackPanel Grid.Column="1"
                                          MinWidth="0">
                                <TextBlock Text="{Binding FileName}"
                                           MaxLines="1"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding DetailText}"
                                           FontSize="11"
                                           MaxLines="1"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Sunder.Brush.Foreground.Muted}" />
                              </StackPanel>
                            </Grid>
                          </Border>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <StackPanel Orientation="Horizontal"
                          HorizontalAlignment="Right"
                          Spacing="4">
                <Button Classes="message-copy-action user"
                        Content="↩"
                        Command="{Binding $parent[UserControl].DataContext.StartRollbackFromMessageCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="Rollback" />
                <Button Classes="message-copy-action user"
                        Content="⧉"
                        Tag="{Binding Content}"
                        Click="CopyTranscriptText_OnClick"
                        ToolTip.Tip="Copy message"
                        IsVisible="{Binding HasContent}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </DataTemplate>

    <DataTemplate x:DataType="vm:AgentToolInvocationRowViewModel">
      <Grid ColumnDefinitions="42,*"
            ColumnSpacing="16"
            Margin="0,0,0,20"
            MinWidth="0"
            HorizontalAlignment="Stretch">
        <Border Classes="timeline-spine"
                Margin="0,-22,0,-6" />

        <StackPanel Grid.Column="1"
                    MinWidth="0"
                    HorizontalAlignment="Stretch">
          <Button Classes="tool-step-header"
                  MinWidth="0"
                  Click="ToolStepHeader_OnClick">
            <Grid RowDefinitions="Auto,Auto"
                  ColumnDefinitions="Auto,*,Auto"
                  RowSpacing="3"
                  ColumnSpacing="8"
                  MinWidth="0"
                  HorizontalAlignment="Stretch">
              <Border Grid.Row="0"
                      Grid.Column="0"
                      Classes="tool-state-dot"
                      Background="{Binding StateSoftBrush}"
                      BorderBrush="{Binding StateBrush}">
                <TextBlock Classes="tool-state-icon"
                           Text="{Binding StatusIconText}"
                           Foreground="{Binding StateBrush}" />
              </Border>
              <TextBlock Grid.Row="0"
                         Grid.Column="1"
                         Classes="tool-label"
                         Text="{Binding ToolLabel}"
                         MinWidth="0"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Row="0"
                         Grid.Column="2"
                         Classes="tool-chevron"
                         Text="{Binding ExpandGlyph}" />
              <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Classes="tool-command"
                           Text="{Binding HeaderDetailText}"
                           MinWidth="0"
                           TextWrapping="Wrap"
                          MaxLines="2"
                          TextTrimming="CharacterEllipsis"
                          Margin="0,-1,8,0"
                          IsVisible="{Binding HasHeaderDetail}" />
            </Grid>
          </Button>

          <ItemsControl ItemsSource="{Binding ChildSessionLinks}"
                        IsVisible="{Binding HasChildSessionLinks}"
                        MinWidth="0"
                        Margin="28,8,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AgentChildSessionLinkViewModel">
                <Button Classes="secondary-action compact-action"
                        Margin="0,0,8,8"
                        Command="{Binding $parent[UserControl].DataContext.OpenChildSessionCommand}"
                        CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal"
                              Spacing="8">
                    <Border Classes="tool-state-dot"
                            Background="{Binding StateSoftBrush}"
                            BorderBrush="{Binding StateBrush}"
                            ToolTip.Tip="{Binding StatusText}">
                      <TextBlock Classes="tool-state-icon"
                                 Text="{Binding StatusIconText}"
                                 Foreground="{Binding StateBrush}" />
                    </Border>
                    <TextBlock Text="Subagent"
                               Foreground="{DynamicResource Sunder.Brush.Foreground.Muted}" />
                    <TextBlock Text="{Binding DisplayText}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Classes="tool-output-card"
                  Margin="28,10,0,0"
                  MinWidth="0"
                  IsVisible="{Binding ShowDetails}">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                  MinWidth="0">
              <Border Classes="tool-output-header"
                      IsVisible="{Binding HasOutput}">
                <TextBlock Text="Output"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Sunder.Brush.Foreground.Muted}" />
              </Border>

              <Border Grid.Row="1"
                      Classes="tool-output-body"
                      IsVisible="{Binding HasOutput}">
                <TextBlock Classes="output-text"
                           MinWidth="0"
                           Text="{Binding OutputText}" />
              </Border>

              <StackPanel Grid.Row="2"
                           Margin="16,14,16,0"
                           Spacing="6"
                           MinWidth="0"
                           IsVisible="{Binding HasToolDiff}">
                <TextBlock Classes="tool-diff-section-title"
                           Text="{Binding ToolDiffSectionTitle}" />
                <ItemsControl ItemsSource="{Binding ToolDiffFiles}"
                              MinWidth="0"
                              HorizontalAlignment="Stretch" />
              </StackPanel>

              <Border Grid.Row="3"
                      Padding="16"
                      MinWidth="0"
                      HorizontalAlignment="Stretch"
                      IsVisible="{Binding ShowMarkdownDetails}">
                <md:MarkdownRenderer MarkdownBuilder="{Binding DetailMarkdownBuilder}"
                                      MinWidth="0"
                                      HorizontalAlignment="Stretch" />
              </Border>

              <Border Grid.Row="4"
                      Classes="metadata-bar"
                      IsVisible="{Binding HasMetadata}">
                <WrapPanel>
                  <Border Classes="metadata-pill error"
                           IsVisible="{Binding HasErrorCode}">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="5"
                          MinWidth="0">
                      <TextBlock Text="Error code:"
                                  FontSize="12"
                                  FontWeight="SemiBold"
                                  Foreground="{DynamicResource Sunder.Brush.Danger}" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding ErrorCodeText}"
                                 FontSize="12"
                                 FontFamily="Menlo,Consolas,monospace"
                                 Foreground="{DynamicResource Sunder.Brush.Danger}"
                                 MinWidth="0"
                                 TextWrapping="Wrap"
                                 MaxLines="2"
                                 TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </Border>

                  <Border Classes="metadata-pill neutral"
                           IsVisible="{Binding HasBackend}">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="5"
                          MinWidth="0">
                      <TextBlock Text="Backend:"
                                  FontSize="12"
                                  FontWeight="SemiBold"
                                  Foreground="{DynamicResource Sunder.Brush.Foreground.Muted}" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding BackendText}"
                                 FontSize="12"
                                 FontFamily="Menlo,Consolas,monospace"
                                 Foreground="{DynamicResource Sunder.Brush.Foreground.Secondary}"
                                 MinWidth="0"
                                 TextWrapping="Wrap"
                                 MaxLines="2"
                                 TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </Border>
                </WrapPanel>
              </Border>
            </Grid>
          </Border>
        </StackPanel>
      </Grid>
    </DataTemplate>
  </UserControl.DataTemplates>

  <Grid>
    <Border Classes="agent-chat-shell">
      <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                Classes="agent-chat-header">
          <Grid>
            <Grid x:Name="HeaderWideLayout"
                  RowDefinitions="Auto,Auto">
              <Grid Grid.Row="0"
                    ColumnDefinitions="240,*,Auto"
                    ColumnSpacing="10">
                <shared:SunderComboBox Grid.Column="0"
                                        Classes="header-select"
                                        ItemsSource="{Binding Workspaces}"
                                        SelectedItem="{Binding SelectedWorkspace, Mode=TwoWay}"
                                        IsEnabled="{Binding HasWorkspaces}"
                                        SelectionBoxItemTemplate="{StaticResource WorkspaceSelectionBoxTemplate}"
                                        ItemTemplate="{StaticResource WorkspaceDropDownItemTemplate}"
                                        HorizontalAlignment="Stretch" />

                <shared:SunderComboBox x:Name="WideSessionComboBox"
                                        Grid.Column="1"
                                        Classes="header-select"
                                        ItemsSource="{Binding Sessions}"
                                        SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                                        SelectionBoxItemTemplate="{StaticResource SessionSelectionBoxTemplate}"
                                        ItemTemplate="{StaticResource SessionDropDownItemTemplate}"
                                        HorizontalAlignment="Stretch" />

                <Button Grid.Column="2"
                        Classes="secondary-action header-action"
                        Content="+"
                        Command="{Binding CreateSessionCommand}"
                        ToolTip.Tip="New session" />
              </Grid>

              <Grid x:Name="WideWorkspacePathRow"
                    Grid.Row="1"
                    Classes="context-path-row"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="8"
                    SizeChanged="OnWorkspacePathRowSizeChanged"
                    IsVisible="{Binding HasWorkspacePathChips}">
                <ItemsControl ItemsSource="{Binding WideWorkspacePathChips}"
                              MinWidth="0"
                              ClipToBounds="True">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal"
                                  Spacing="6" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AgentWorkspacePathChipViewModel">
                      <Border Classes="context-path-chip">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="6">
                          <Path Classes="context-path-icon"
                                Data="{StaticResource AgentChat.Icon.Path}" />
                          <TextBlock Grid.Column="1"
                                     Classes="context-path-text"
                                     Text="{Binding Label}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Grid.Column="1"
                        Classes="context-path-chip more">
                  <Border.IsVisible>
                    <Binding Path="HasWideWorkspacePathOverflow" />
                  </Border.IsVisible>
                  <TextBlock Classes="context-path-more-text"
                             Text="{Binding WideWorkspacePathOverflowText}" />
                </Border>
              </Grid>
            </Grid>

          <Grid x:Name="HeaderNarrowLayout"
                RowDefinitions="Auto,Auto,Auto"
                ColumnDefinitions="*,Auto"
                RowSpacing="8"
                ColumnSpacing="12"
                IsVisible="False">
            <shared:SunderComboBox Grid.Row="0"
                                    Grid.ColumnSpan="2"
                                    Classes="header-select"
                                    ItemsSource="{Binding Workspaces}"
                                    SelectedItem="{Binding SelectedWorkspace, Mode=TwoWay}"
                                    IsEnabled="{Binding HasWorkspaces}"
                                    SelectionBoxItemTemplate="{StaticResource WorkspaceSelectionBoxTemplate}"
                                    ItemTemplate="{StaticResource WorkspaceDropDownItemTemplate}"
                                    HorizontalAlignment="Stretch" />

            <shared:SunderComboBox x:Name="NarrowSessionComboBox"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Classes="header-select"
                                    ItemsSource="{Binding Sessions}"
                                    SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                                    SelectionBoxItemTemplate="{StaticResource SessionSelectionBoxTemplate}"
                                    ItemTemplate="{StaticResource SessionDropDownItemTemplate}"
                                    HorizontalAlignment="Stretch" />

            <Button Grid.Row="1"
                    Grid.Column="1"
                    Classes="secondary-action header-action"
                    Content="+"
                    Command="{Binding CreateSessionCommand}"
                    ToolTip.Tip="New session" />

            <Grid x:Name="NarrowWorkspacePathRow"
                  Grid.Row="2"
                  Grid.ColumnSpan="2"
                  Classes="context-path-row"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="8"
                  SizeChanged="OnWorkspacePathRowSizeChanged"
                  IsVisible="{Binding HasWorkspacePathChips}">
              <ItemsControl ItemsSource="{Binding NarrowWorkspacePathChips}"
                            MinWidth="0"
                            ClipToBounds="True">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"
                                Spacing="6" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AgentWorkspacePathChipViewModel">
                    <Border Classes="context-path-chip">
                      <Grid ColumnDefinitions="Auto,*"
                            ColumnSpacing="6">
                        <Path Classes="context-path-icon"
                              Data="{StaticResource AgentChat.Icon.Path}" />
                        <TextBlock Grid.Column="1"
                                   Classes="context-path-text"
                                   Text="{Binding Label}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Grid.Column="1"
                      Classes="context-path-chip more">
                <Border.IsVisible>
                  <Binding Path="HasNarrowWorkspacePathOverflow" />
                </Border.IsVisible>
                <TextBlock Classes="context-path-more-text"
                           Text="{Binding NarrowWorkspacePathOverflowText}" />
              </Border>
            </Grid>
          </Grid>
          </Grid>
        </Border>

        <Border Grid.Row="1"
                Classes="transcript-surface"
                IsVisible="{Binding ShowTranscriptSurface}">
          <Grid>
            <ScrollViewer x:Name="TranscriptScrollViewer"
                          Classes="transcript-scroll"
                          IsVisible="{Binding !ShowSetupInstructions}">
              <Border Classes="transcript-content"
                      Width="{Binding Viewport.Width, ElementName=TranscriptScrollViewer}">
                <ItemsControl x:Name="TranscriptItemsControl"
                              Classes="transcript-items"
                              ItemsSource="{Binding Messages}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AgentTranscriptRowViewModel">
                      <shared:TranscriptRowPresenter Classes="transcript-row-anchor"
                                                     AnchorKey="{Binding AnchorKey}"
                                                     Content="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </ScrollViewer>

            <Border Classes="setup-card"
                    IsVisible="{Binding ShowSetupInstructions}">
              <StackPanel Spacing="10">
                <TextBlock Classes="setup-title"
                           Text="{Binding SetupTitle}" />
                <TextBlock Classes="setup-description"
                           Text="{Binding SetupDescription}" />
              </StackPanel>
            </Border>

            <TextBlock Text="Loading messages..."
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,30,0,0"
                       Foreground="{DynamicResource Sunder.Brush.Foreground.Muted}"
                       IsVisible="{Binding IsTranscriptLoading}" />
            <TextBlock Text="Loading older messages..."
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,30,0,0"
                       Foreground="{DynamicResource Sunder.Brush.Foreground.Muted}"
                       IsVisible="{Binding IsLoadingOlderTranscriptRows}" />
            <TextBlock Text="Loading newer messages..."
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,30"
                       Foreground="{DynamicResource Sunder.Brush.Foreground.Muted}"
                       IsVisible="{Binding IsLoadingNewerTranscriptRows}" />
            <Button x:Name="JumpToLatestTranscriptButton"
                    Classes="transcript-jump-latest"
                    Content="↓"
                    Click="JumpToLatestTranscript_OnClick"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="37,0,0,18"
                    ToolTip.Tip="Jump to latest"
                    IsVisible="False" />
          </Grid>
        </Border>

        <Border x:Name="ExpandedComposerDropTarget"
                Grid.Row="1"
                Grid.RowSpan="2"
                Classes="composer-surface"
                Classes.drop-target-active="{Binding IsComposerDropTargetActive}"
                IsVisible="{Binding ShowExpandedComposer}">
          <Grid RowDefinitions="Auto,*,Auto"
                RowSpacing="14">
            <ItemsControl ItemsSource="{Binding PendingPermissionRequests}"
                          IsVisible="{Binding HasPendingPermissionRequests}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="agentModels:AgentPendingPermissionRequestRecord">
                  <Border Classes="permission-card"
                          Margin="0,0,0,8">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="16">
                      <StackPanel Spacing="6">
                        <TextBlock Text="Permission Required"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Sunder.Brush.Warning}" />
                        <TextBlock Text="{Binding Summary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ResourceDisplayName}"
                                   Foreground="{DynamicResource Sunder.Brush.Foreground.Muted}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1"
                                  Orientation="Horizontal"
                                  Spacing="8"
                                  VerticalAlignment="Center">
                        <Button Classes="secondary-action compact-action"
                                Content="Allow Once"
                                Command="{Binding $parent[UserControl].DataContext.ApprovePermissionCommand}"
                                CommandParameter="{Binding}" />
                        <Button Classes="secondary-action compact-action"
                                Content="Allow In Session"
                                Command="{Binding $parent[UserControl].DataContext.ApprovePermissionForSessionCommand}"
                                CommandParameter="{Binding}" />
                        <Button Classes="secondary-action compact-action danger-action"
                                Content="Deny"
                                Command="{Binding $parent[UserControl].DataContext.DenyPermissionCommand}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBox x:Name="ExpandedComposerTextBox"
                     Grid.Row="1"
                     Classes="composer-input expanded"
                     Classes.drop-target-active="{Binding IsComposerDropTargetActive}"
                     Text="{Binding DraftMessage, Mode=TwoWay}"
                     PlaceholderText="Type a message to the selected agent session..."
                     AcceptsReturn="True"
                     TextWrapping="Wrap" />
            <Grid Grid.Row="2"
                  RowDefinitions="Auto,Auto"
                  RowSpacing="8">
              <Border Grid.Row="0"
                      Classes="attachment-tray"
                      IsVisible="{Binding HasPendingAttachments}">
                <Grid RowDefinitions="Auto,Auto"
                      RowSpacing="6">
                  <TextBlock Text="{Binding PendingAttachmentSummaryText}"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource Sunder.Brush.Foreground.Muted}"
                             Margin="0,0,8,0" />
                  <ScrollViewer Grid.Row="1"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding PendingAttachments}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </Border>
              <Grid Grid.Row="1"
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="8">
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Spacing="8">
                  <Button Classes="secondary-action composer-action"
                          Content="+"
                          Click="OnAttachFilesClick"
                          ToolTip.Tip="Attach files or paste copied files"
                          IsEnabled="{Binding IsSelectedSessionRunInactive}" />
                  <ToggleButton Classes="composer-action"
                                Content="⛶"
                                IsChecked="{Binding IsComposerExpanded, Mode=TwoWay}"
                                ToolTip.Tip="Collapse composer" />
                  <Button Classes="secondary-action composer-action clear"
                          Content="{Binding ClearComposerButtonText}"
                          Command="{Binding ClearComposerCommand}"
                          ToolTip.Tip="{Binding ClearComposerToolTipText}" />
                </StackPanel>
                <Grid Grid.Column="1"
                      ColumnDefinitions="*,Auto,Auto,Auto"
                      ColumnSpacing="8"
                      MinWidth="0"
                      HorizontalAlignment="Stretch">
                  <shared:SunderComboBox Grid.Column="0"
                                         Classes="composer-agent-select"
                                         ItemsSource="{Binding Profiles}"
                                         SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                         IsEnabled="{Binding HasProfiles}"
                                         SelectionBoxItemTemplate="{StaticResource AgentSelectionBoxTemplate}"
                                         ItemTemplate="{StaticResource AgentDropDownItemTemplate}"
                                         ToolTip.Tip="Agent" />
                  <ToggleButton Grid.Column="1"
                                Classes="composer-action"
                                Content="∞"
                                IsChecked="{Binding IsUnrestrictedModeEnabled, Mode=TwoWay}"
                                ToolTip.Tip="Unrestricted Mode" />
                  <ToggleButton Grid.Column="2"
                                Classes="composer-action"
                                Content="↵"
                                IsChecked="{Binding IsSendOnEnterEnabled, Mode=TwoWay}"
                                ToolTip.Tip="Send with Enter" />
                  <Button Grid.Column="3"
                          Classes="primary-action composer-action"
                          Content="↑"
                          Command="{Binding SendMessageCommand}"
                          ToolTip.Tip="Send"
                          IsVisible="{Binding ShowSendAction}" />
                  <Button Grid.Column="3"
                          Classes="secondary-action composer-action"
                          Content="■"
                          Command="{Binding StopRunCommand}"
                          ToolTip.Tip="Stop"
                          IsVisible="{Binding ShowStopAction}" />
                </Grid>
              </Grid>
            </Grid>
          </Grid>
        </Border>

        <Border x:Name="CollapsedComposerDropTarget"
                Grid.Row="2"
                Classes="composer-surface"
                Classes.drop-target-active="{Binding IsComposerDropTargetActive}"
                IsVisible="{Binding ShowCollapsedComposer}">
          <StackPanel Spacing="14">
            <ItemsControl ItemsSource="{Binding PendingPermissionRequests}"
                          IsVisible="{Binding HasPendingPermissionRequests}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="agentModels:AgentPendingPermissionRequestRecord">
                  <Border Classes="permission-card"
                          Margin="0,0,0,8">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="16">
                      <StackPanel Spacing="6">
                        <TextBlock Text="Permission Required"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Sunder.Brush.Warning}" />
                        <TextBlock Text="{Binding Summary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ResourceDisplayName}"
                                   Foreground="{DynamicResource Sunder.Brush.Foreground.Muted}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1"
                                  Orientation="Horizontal"
                                  Spacing="8"
                                  VerticalAlignment="Center">
                        <Button Classes="secondary-action compact-action"
                                Content="Allow Once"
                                Command="{Binding $parent[UserControl].DataContext.ApprovePermissionCommand}"
                                CommandParameter="{Binding}" />
                        <Button Classes="secondary-action compact-action"
                                Content="Allow In Session"
                                Command="{Binding $parent[UserControl].DataContext.ApprovePermissionForSessionCommand}"
                                CommandParameter="{Binding}" />
                        <Button Classes="secondary-action compact-action danger-action"
                                Content="Deny"
                                Command="{Binding $parent[UserControl].DataContext.DenyPermissionCommand}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid RowDefinitions="Auto,Auto,Auto"
                  RowSpacing="8">
              <TextBox x:Name="CollapsedComposerTextBox"
                       Grid.Row="0"
                       Classes="composer-input"
                       Classes.drop-target-active="{Binding IsComposerDropTargetActive}"
                       MinHeight="75"
                       MaxHeight="150"
                       Text="{Binding DraftMessage, Mode=TwoWay}"
                       PlaceholderText="Type a message to the selected agent session..."
                       AcceptsReturn="True"
                       TextWrapping="Wrap" />
              <Border Grid.Row="1"
                      Classes="attachment-tray"
                      IsVisible="{Binding HasPendingAttachments}">
                <Grid RowDefinitions="Auto,Auto"
                      RowSpacing="6">
                  <TextBlock Text="{Binding PendingAttachmentSummaryText}"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource Sunder.Brush.Foreground.Muted}"
                             Margin="0,0,8,0" />
                  <ScrollViewer Grid.Row="1"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding PendingAttachments}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </Border>
              <Grid Grid.Row="2"
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="8">
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Spacing="8">
                  <Button Classes="secondary-action composer-action"
                          Content="+"
                          Click="OnAttachFilesClick"
                          ToolTip.Tip="Attach files or paste copied files"
                          IsEnabled="{Binding IsSelectedSessionRunInactive}" />
                  <ToggleButton Classes="composer-action"
                                Content="⛶"
                                IsChecked="{Binding IsComposerExpanded, Mode=TwoWay}"
                                ToolTip.Tip="Expand composer" />
                  <Button Classes="secondary-action composer-action clear"
                          Content="{Binding ClearComposerButtonText}"
                          Command="{Binding ClearComposerCommand}"
                          ToolTip.Tip="{Binding ClearComposerToolTipText}" />
                </StackPanel>
                <Grid Grid.Column="1"
                      ColumnDefinitions="*,Auto,Auto,Auto"
                      ColumnSpacing="8"
                      MinWidth="0"
                      HorizontalAlignment="Stretch">
                  <shared:SunderComboBox Grid.Column="0"
                                         Classes="composer-agent-select"
                                         ItemsSource="{Binding Profiles}"
                                         SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                         IsEnabled="{Binding HasProfiles}"
                                         SelectionBoxItemTemplate="{StaticResource AgentSelectionBoxTemplate}"
                                         ItemTemplate="{StaticResource AgentDropDownItemTemplate}"
                                         ToolTip.Tip="Agent" />
                  <ToggleButton Grid.Column="1"
                                Classes="composer-action"
                                Content="∞"
                                IsChecked="{Binding IsUnrestrictedModeEnabled, Mode=TwoWay}"
                                ToolTip.Tip="Unrestricted Mode" />
                  <ToggleButton Grid.Column="2"
                                Classes="composer-action"
                                Content="↵"
                                IsChecked="{Binding IsSendOnEnterEnabled, Mode=TwoWay}"
                                ToolTip.Tip="Send with Enter" />
                  <Button Grid.Column="3"
                          Classes="primary-action composer-action"
                          Content="↑"
                          Command="{Binding SendMessageCommand}"
                          ToolTip.Tip="Send"
                          IsVisible="{Binding ShowSendAction}" />
                  <Button Grid.Column="3"
                          Classes="secondary-action composer-action"
                          Content="■"
                          Command="{Binding StopRunCommand}"
                          ToolTip.Tip="Stop"
                          IsVisible="{Binding ShowStopAction}" />
                </Grid>
              </Grid>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Border Classes="attachment-preview-backdrop"
            IsVisible="{Binding IsAttachmentPreviewVisible}">
      <Grid Margin="28">
        <Border Classes="attachment-preview-card"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="1160"
                MaxHeight="840">
          <Grid RowDefinitions="Auto,*"
                RowSpacing="12">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="14">
              <TextBlock Text="{Binding AttachmentPreviewTitle}"
                         FontSize="14"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource Sunder.Brush.Foreground.Primary}"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />
              <Button Grid.Column="1"
                      Classes="secondary-action preview-close"
                      Content="x"
                      Command="{Binding CloseAttachmentPreviewCommand}"
                      ToolTip.Tip="Close preview" />
            </Grid>
            <Image Grid.Row="1"
                   Classes="attachment-preview-image"
                   Source="{Binding AttachmentPreviewImage}"
                   IsVisible="{Binding HasAttachmentPreviewImage}" />
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
