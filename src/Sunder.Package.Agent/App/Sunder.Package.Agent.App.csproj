<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <SunderPackageFamilyId>sunder.package.agent</SunderPackageFamilyId>
    <SunderPackageRole>app</SunderPackageRole>
    <SunderPackageProject>true</SunderPackageProject>
    <SunderSdkAvaloniaReference>true</SunderSdkAvaloniaReference>
    <SunderSdkStacksReference>true</SunderSdkStacksReference>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <SunderAgentSharedTranscript>true</SunderAgentSharedTranscript>
    <AssemblyName>Sunder.Package.Agent.App</AssemblyName>
    <RootNamespace>Sunder.Package.Agent</RootNamespace>
    <SunderPackageAssetsDirectory>$(MSBuildProjectDirectory)\..\Assets</SunderPackageAssetsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Controls.ItemsRepeater" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="LiveMarkdown.Avalonia" />
    <ProjectReference Include="..\..\Sunder.Package.Agent.Contracts\Sunder.Package.Agent.Contracts.csproj" />
    <ProjectReference Include="..\OwnerProtocol\Sunder.Package.Agent.OwnerProtocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\PackageMetadata.cs" Link="PackageMetadata.cs" />
    <Compile Include="..\PackageViews\**\*.cs" LinkBase="PackageViews" />
    <Compile Include="..\Runtime\AgentAppRuntimeGateway*.cs" LinkBase="Runtime" />
    <Compile Include="..\Runtime\AgentRuntimePayloadLimits.cs" Link="Runtime\AgentRuntimePayloadLimits.cs" />
    <Compile Include="..\HistorySearch\HistorySearchNavigation.cs" Link="HistorySearch\HistorySearchNavigation.cs" />
    <Compile Include="..\Services\AgentChatSelectionStateService.cs" Link="Services\AgentChatSelectionStateService.cs" />
    <Compile Include="..\Services\AgentToolPresentationService.cs" Link="Services\AgentToolPresentationService.cs" />
    <AvaloniaResource Include="..\Assets\**" Link="Assets\%(RecursiveDir)%(Filename)%(Extension)" />
    <AvaloniaXaml Include="..\PackageViews\**\*.axaml" Link="PackageViews\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <SunderContractBundle Include="..\OwnerProtocol\Contracts\agent-owner-runtime.rpc.json"
                          ContractId="sunder.agent.owner.runtime"
                           Version="1.0.0"
                          DescriptorPath="contracts/agent-owner-runtime.rpc.json"
                          Exposure="package" />
    <SunderUsesContract Include="sunder.agent.owner.runtime"
                        Role="app"
                         ContractVersion="1.0.0"
                        Required="true"
                        Actions="discover;invoke;subscribe" />
    <SunderUsesContract Include="sunder.agent.tool.source"
                        Role="app"
                        ContractVersion="1.0.0"
                        Required="false"
                        Actions="discover;invoke" />
    <SunderUsesContract Include="sunder.agent.workspace.editor"
                        Role="app"
                        ContractVersion="1.0.0"
                        Required="false"
                        Actions="discover;invoke" />
  </ItemGroup>

  <Import Project="..\..\Sunder.Package.Agent.Shared\Sunder.Package.Agent.Shared.props" />

</Project>
