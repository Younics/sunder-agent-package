<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Sunder.Package.Agent.Provider.OpenAI</AssemblyName>
    <RootNamespace>Sunder.Package.Agent.Provider.OpenAI</RootNamespace>
    <SunderPackageFamilyId>sunder.package.agent.provider.openai</SunderPackageFamilyId>
    <SunderSdkAvaloniaReference>true</SunderSdkAvaloniaReference>
    <SunderPackageAssetsDirectory>$(MSBuildProjectDirectory)\Assets</SunderPackageAssetsDirectory>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\Sunder.Agent.Worker.props" />
  <Import Project="..\Sunder.Package.Agent\Models\AgentExtensionSources.props" />

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="OpenAI" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <_ProviderDomainSource Include="@(SunderAgentProviderRuntimeSource);@(SunderAgentProviderAppSource)" />
    <Compile Include="@(_ProviderDomainSource->Distinct())" LinkBase="Domain" />
    <Compile Include="..\Sunder.Package.Agent.Provider.Shared\*.cs"
             Exclude="..\Sunder.Package.Agent.Provider.Shared\ApiKeySettingsState.cs;..\Sunder.Package.Agent.Provider.Shared\ApiKeyUtilitySettingsState.cs;..\Sunder.Package.Agent.Provider.Shared\ProviderConfigurationSections.cs;..\Sunder.Package.Agent.Provider.Shared\UtilityModelSettingsState.cs"
             Link="Provider.Shared\%(Filename)%(Extension)" />
    <Compile Include="..\Sunder.Package.Agent.Shared\Presentation\PackageCallbackFlowRunner.cs;..\Sunder.Package.Agent.Shared\Presentation\PresentationOperationObserver.cs" LinkBase="Presentation" />
  </ItemGroup>

  <Import Project="..\Sunder.Package.Agent.Provider.Shared\ProviderSettingsSources.props" />

</Project>
