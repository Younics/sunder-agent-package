<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vm="using:Sunder.Package.Agent.Provider.OpenAI"
              xmlns:p="using:Sunder.Package.Agent.Shared.Presentation"
             xmlns:shared="using:Sunder.Package.Agent.Shared.PackageViews"
             x:Class="Sunder.Package.Agent.Provider.OpenAI.OpenAiSettingsView"
             x:DataType="vm:OpenAiSettingsViewModel" Classes="agent-page">
  <UserControl.Styles>
    <StyleInclude Source="/Presentation/PresentationStyles.axaml" />
    <StyleInclude Source="/Provider.Shared/ProviderSettingsStyles.axaml" />
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="{DynamicResource Sunder.Padding.Panel}"
                Spacing="{DynamicResource Sunder.Spacing.Large}" HorizontalAlignment="Stretch">
      <Border Classes="card-surface">
        <StackPanel Spacing="{DynamicResource Sunder.Spacing.Medium}">
          <p:SectionHeader Title="Authentication" HelpText="Choose the credential used for chat, then save. Connecting an account or storing an API key does not switch the saved mode." />
          <shared:SunderComboBox ItemsSource="{Binding AuthModes}"
                                 SelectedItem="{Binding SelectedAuthMode, Mode=TwoWay}"
                                 HorizontalAlignment="Left">
            <shared:SunderComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:OpenAiAuthModeOption">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </shared:SunderComboBox.ItemTemplate>
          </shared:SunderComboBox>
          <Button Classes="primary-action"
                  Content="Save Authentication Mode"
                  HorizontalAlignment="Left"
                  Command="{Binding SaveAuthModeCommand}"
                  IsEnabled="{Binding CanSaveAuthMode}" />
        </StackPanel>
      </Border>

      <Border Classes="card-surface">
        <StackPanel Spacing="{DynamicResource Sunder.Spacing.Medium}">
          <p:ResponsiveGrid ColumnDefinitions="*,Auto"
                ColumnSpacing="{DynamicResource Sunder.Spacing.Medium}" RowSpacing="{DynamicResource Sunder.Spacing.Small}">
            <p:SectionHeader Title="ChatGPT Plus/Pro" HelpText="Select ChatGPT Plus/Pro as the authentication mode and save. Authorize opens your browser to sign in; return here while Sunder waits for the callback." />
            <Border Grid.Column="1"
                    Classes="settings-status-pill"
                    Classes.success="{Binding IsCodexConnected}"
                    Classes.warning="{Binding IsCodexStatusWarning}"
                    Classes.danger="{Binding IsCodexStatusError}">
              <TextBlock Classes="settings-status-label"
                         Text="{Binding CodexStatusLabel}" />
            </Border>
          </p:ResponsiveGrid>
            <StackPanel Spacing="6">
              <TextBlock Classes="muted"
                         Text="{Binding CodexStatusDetail}"
                         TextWrapping="Wrap" />
            </StackPanel>
          <WrapPanel ItemSpacing="{DynamicResource Sunder.Spacing.Small}" LineSpacing="{DynamicResource Sunder.Spacing.Small}">
            <Button x:Name="AuthorizeButton"
                    Classes="primary-action"
                    Content="{Binding AuthorizationButtonLabel}"
                    Command="{Binding AuthorizeCommand}"
                    IsEnabled="{Binding CanAuthorize}" />
            <Button Classes="secondary-action"
                    Content="Disconnect"
                    Command="{Binding DisconnectCommand}"
                    IsEnabled="{Binding CanDisconnectAction}" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <ContentControl Content="{Binding ApiKeySettings}"
                      ContentTemplate="{StaticResource ProviderApiKeySettingsTemplate}" />
      <ContentControl Content="{Binding UtilityModelSettings}"
                      ContentTemplate="{StaticResource ProviderUtilityModelSettingsTemplate}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
