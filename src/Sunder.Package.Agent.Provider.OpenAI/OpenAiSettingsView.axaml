<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sunder.Package.Agent.Provider.OpenAI"
             xmlns:shared="using:Sunder.Package.Agent.Shared.PackageViews"
             x:Class="Sunder.Package.Agent.Provider.OpenAI.OpenAiSettingsView"
             x:DataType="vm:OpenAiSettingsViewModel">
  <UserControl.Styles>
    <StyleInclude Source="/Presentation/PresentationStyles.axaml" />
    <StyleInclude Source="/Provider.Shared/ProviderSettingsStyles.axaml" />
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="0,0,0,8"
                Spacing="16">
      <Border Classes="card-surface">
        <StackPanel Spacing="14">
          <StackPanel Spacing="6">
            <TextBlock Classes="section-title"
                       Text="Authentication Mode" />
            <TextBlock Classes="caption"
                       Text="Choose which credential OpenAI chat uses. ChatGPT Plus/Pro remains the default until another mode is saved."
                       TextWrapping="Wrap" />
          </StackPanel>
          <shared:SunderComboBox ItemsSource="{Binding AuthModes}"
                                 SelectedItem="{Binding SelectedAuthMode, Mode=TwoWay}"
                                 HorizontalAlignment="Left">
            <shared:SunderComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:OpenAiAuthModeOption">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </shared:SunderComboBox.ItemTemplate>
          </shared:SunderComboBox>
          <Button Classes="primary-action"
                  Content="Save Authentication Mode"
                  HorizontalAlignment="Left"
                  Command="{Binding SaveAuthModeCommand}"
                  IsEnabled="{Binding CanSaveAuthMode}" />
        </StackPanel>
      </Border>

      <Border Classes="card-surface">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto"
                ColumnSpacing="12">
            <TextBlock Classes="section-title"
                       Text="ChatGPT Plus/Pro"
                       VerticalAlignment="Center" />
            <Border Grid.Column="1"
                    Classes="settings-status-pill"
                    Classes.success="{Binding IsCodexConnected}"
                    Classes.warning="{Binding IsCodexStatusWarning}"
                    Classes.danger="{Binding IsCodexStatusError}">
              <TextBlock Classes="settings-status-label"
                         Text="{Binding CodexStatusLabel}" />
            </Border>
          </Grid>
          <Border Classes="settings-detail-card">
            <StackPanel Spacing="6">
              <TextBlock Classes="caption"
                         Text="Authorize this provider with your ChatGPT Plus or Pro account. This remains vendor-specific and is used only by Codex-connected chat mode."
                         TextWrapping="Wrap" />
              <TextBlock Classes="muted"
                         Text="{Binding CodexStatusDetail}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <StackPanel Orientation="Horizontal"
                      Spacing="10">
            <Button Classes="primary-action"
                    Content="Authorize"
                    Command="{Binding AuthorizeCommand}"
                    IsEnabled="{Binding CanAuthorize}" />
            <Button Classes="secondary-action"
                    Content="Cancel Authorization"
                    Command="{Binding CancelAuthorizationCommand}"
                    IsEnabled="{Binding CanCancelAuthorization}"
                    IsVisible="{Binding IsAuthorizing}" />
            <Button Classes="secondary-action"
                    Content="Disconnect"
                    Command="{Binding DisconnectCommand}"
                    IsEnabled="{Binding CanDisconnect}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <ContentControl Content="{Binding ApiKeySettings}"
                      ContentTemplate="{StaticResource ProviderApiKeySettingsTemplate}" />
      <ContentControl Content="{Binding UtilityModelSettings}"
                      ContentTemplate="{StaticResource ProviderUtilityModelSettingsTemplate}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
