{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "descriptorVersion": 2,
  "schemaProfile": "sunder.rpc.values.v1",
  "contractId": "sunder.package.agent.provider.openai.management",
  "version": "2.0.0",
  "errors": {
    "openai.management.failed": {
      "description": "The OpenAI management request failed."
    }
  },
  "services": {
    "management": {
      "methods": {
        "get-auth-status": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": ["openai.management.failed"],
          "requestSchema": { "$ref": "#/$defs/ManagementQuery" },
          "responseSchema": { "$ref": "#/$defs/AuthStatus" }
        },
        "disconnect-auth": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": ["openai.management.failed"],
          "requestSchema": { "$ref": "#/$defs/ManagementQuery" },
          "responseSchema": { "$ref": "#/$defs/AuthStatus" }
        },
        "get-credential-status": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": ["openai.management.failed"],
          "requestSchema": { "$ref": "#/$defs/ManagementQuery" },
          "responseSchema": { "$ref": "#/$defs/CredentialStatus" }
        },
        "set-credential": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": ["openai.management.failed"],
          "requestSchema": { "$ref": "#/$defs/CredentialRequest" },
          "responseSchema": { "$ref": "#/$defs/CredentialStatus" }
        },
        "clear-credential": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": ["openai.management.failed"],
          "requestSchema": { "$ref": "#/$defs/ManagementQuery" },
          "responseSchema": { "$ref": "#/$defs/CredentialStatus" }
        }
      }
    }
  },
  "$defs": {
    "ManagementQuery": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "StatusMessage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "AuthStatus": {
      "type": "object",
      "properties": {
        "isConnected": { "type": "boolean" },
        "hasCachedSession": { "type": "boolean" },
        "expiresAtUtc": { "type": "string", "format": "date-time" },
        "errorMessage": { "$ref": "#/$defs/StatusMessage" }
      },
      "required": ["isConnected", "hasCachedSession"],
      "additionalProperties": false
    },
    "ApiKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "CredentialRequest": {
      "type": "object",
      "properties": {
        "credential": { "$ref": "#/$defs/ApiKey" }
      },
      "required": ["credential"],
      "additionalProperties": false
    },
    "CredentialStatus": {
      "type": "object",
      "properties": {
        "hasStoredCredential": { "type": "boolean" }
      },
      "required": ["hasStoredCredential"],
      "additionalProperties": false
    }
  }
}
