<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Sunder.Package.Agent.Provider.OpenAI.App</AssemblyName>
    <RootNamespace>Sunder.Package.Agent.Provider.OpenAI</RootNamespace>
    <SunderPackageFamilyId>sunder.package.agent.provider.openai</SunderPackageFamilyId>
    <SunderPackageRole>app</SunderPackageRole>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <SunderPackageAssetsDirectory>$(MSBuildProjectDirectory)\..\Assets</SunderPackageAssetsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <ProjectReference Include="..\Shared\Sunder.Package.Agent.Provider.OpenAI.Shared.csproj" />
    <Compile Include="..\OpenAiSettingsView.axaml.cs" Link="OpenAiSettingsView.axaml.cs" />
    <Compile Include="..\OpenAiSettingsViewModel.cs" Link="OpenAiSettingsViewModel.cs" />
    <Compile Include="..\PackageMetadata.cs" Link="PackageMetadata.cs" />
    <Compile Include="..\Management\OpenAiAppManagement.cs"
             Link="Management\OpenAiAppManagement.cs" />
    <Compile Include="..\Management\OpenAiCredentialOwnerClient.cs"
              Link="Management\OpenAiCredentialOwnerClient.cs" />
    <Compile Include="..\..\Sunder.Package.Agent.Provider.Shared\ApiKeySettingsState.cs"
             Link="Provider.Shared\ApiKeySettingsState.cs" />
    <Compile Include="..\..\Sunder.Package.Agent.Provider.Shared\UtilityModelSettingsState.cs"
             Link="Provider.Shared\UtilityModelSettingsState.cs" />
    <Compile Include="..\..\Sunder.Package.Agent.Shared\PackageViews\SunderComboBox.cs"
             Link="PackageViews\SunderComboBox.cs" />
    <Compile Include="..\..\Sunder.Package.Agent.Shared\Presentation\CapabilitySelectionState.cs"
             Link="Presentation\CapabilitySelectionState.cs" />
    <Compile Include="..\..\Sunder.Package.Agent.Shared\Presentation\ModelBindingEditorState.cs"
             Link="Presentation\ModelBindingEditorState.cs" />
    <Compile Include="..\..\Sunder.Package.Agent.Shared\Presentation\PackageCallbackFlowRunner.cs"
             Link="Presentation\PackageCallbackFlowRunner.cs" />
    <Compile Include="..\..\Sunder.Package.Agent.Shared\Presentation\OperationState.cs"
             Link="Presentation\OperationState.cs" />
    <Compile Include="..\..\Sunder.Package.Agent.Shared\Presentation\PresentationDispatcher.cs"
             Link="Presentation\PresentationDispatcher.cs" />
    <Compile Include="..\..\Sunder.Package.Agent.Shared\Presentation\PresentationExceptionPolicy.cs"
             Link="Presentation\PresentationExceptionPolicy.cs" />
    <Compile Include="..\..\Sunder.Package.Agent.Shared\Presentation\PresentationOperationObserver.cs"
             Link="Presentation\PresentationOperationObserver.cs" />
    <Compile Include="..\..\Sunder.Package.Agent.Shared\Presentation\PresentationTaskScope.cs"
             Link="Presentation\PresentationTaskScope.cs" />
    <Compile Include="..\..\Sunder.Package.Agent.Shared\Presentation\ProviderModelLoader.cs"
             Link="Presentation\ProviderModelLoader.cs" />
    <Compile Include="..\..\Sunder.Package.Agent.Shared\Presentation\TimedStatusController.cs"
             Link="Presentation\TimedStatusController.cs" />
    <AvaloniaXaml Include="..\OpenAiSettingsView.axaml" Link="OpenAiSettingsView.axaml" />
    <AvaloniaResource Include="..\..\Sunder.Package.Agent.Shared\Presentation\PresentationStyles.axaml"
                      Link="Presentation\PresentationStyles.axaml" />
    <AvaloniaResource Include="..\..\Sunder.Package.Agent.Provider.Shared\ProviderSettingsStyles.axaml"
                      Link="Provider.Shared\ProviderSettingsStyles.axaml" />
    <SunderContractBundle Include="..\Shared\Contracts\openai-management.rpc.json"
                          ContractId="sunder.package.agent.provider.openai.management"
                            Version="1.0.0"
                          DescriptorPath="contracts/openai-management.rpc.json"
                          Exposure="package" />
    <SunderUsesContract Include="sunder.package.agent.provider.openai.management"
                        Role="app"
                          ContractVersion="1.0.0"
                        Required="true"
                        Actions="discover;invoke" />
  </ItemGroup>

</Project>
