<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <SunderPackageFamilyId>sunder.package.agent.builder</SunderPackageFamilyId>
    <SunderPackageRole>app</SunderPackageRole>
    <SunderPackageProject>true</SunderPackageProject>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <SunderPackageAssetsDirectory>$(MSBuildProjectDirectory)\..\Assets</SunderPackageAssetsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <ProjectReference Include="..\..\Sunder.Package.Agent.Contracts\Sunder.Package.Agent.Contracts.csproj" />
    <ProjectReference Include="..\Protocol\Sunder.Package.Agent.Builder.Protocol.csproj" />
    <Compile Include="..\BuilderOperationQueue.cs;..\BuilderPathService.cs;..\BuilderProjectApplicationService.cs;..\BuilderProjectPersistence.cs;..\BuilderProjectRecord.cs;..\BuilderProjectStore.cs;..\BuilderProjectViewModels.cs;..\BuilderSetupService.cs;..\BuilderUiDispatcher.cs;..\BuilderViewModel.Operations.cs;..\BuilderViewModel.PresentationOperations.cs;..\BuilderViewModels.cs;..\BuilderWorkspaceExecutionService.cs"
             Link="%(Filename)%(Extension)" />
    <Compile Include="..\PackageMetadata.cs" Link="PackageMetadata.cs" />
  </ItemGroup>

  <ItemGroup>
    <SunderContractBundle Include="..\Protocol\Contracts\builder-runtime.rpc.json"
                          ContractId="sunder.package.agent.builder.runtime"
                            Version="1.0.0"
                          DescriptorPath="contracts/builder-runtime.rpc.json"
                          Exposure="package" />
    <SunderUsesContract Include="sunder.package.agent.builder.runtime"
                        Role="app"
                          ContractVersion="1.0.0"
                        Required="true"
                        Actions="discover;invoke" />
  </ItemGroup>

  <Import Project="..\..\Sunder.Package.Agent.Shared\Sunder.Package.Agent.Shared.props" />

</Project>
