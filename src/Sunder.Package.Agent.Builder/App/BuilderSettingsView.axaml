<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sunder.Package.Agent.Builder" xmlns:p="using:Sunder.Package.Agent.Shared.Presentation" x:Class="Sunder.Package.Agent.Builder.BuilderSettingsView"
             x:DataType="vm:BuilderSettingsViewModel" x:CompileBindings="True" Classes="agent-page">
  <UserControl.Styles>
    <StyleInclude Source="/Presentation/PresentationStyles.axaml" />
    <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Primary}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style Selector="TextBlock.caption"><Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Secondary}" /></Style>
  </UserControl.Styles>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="{DynamicResource Sunder.Spacing.Large}" Margin="{DynamicResource Sunder.Padding.Panel}">
      <p:ResponsiveGrid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Sunder.Spacing.Medium}" RowSpacing="{DynamicResource Sunder.Spacing.Small}">
        <p:SectionHeader Title="SDKs" HelpText="Package Maker uses isolated, managed SDK installations. Externally installed SDKs are read-only. Installation paths and versions are listed in Details." />
        <Button Grid.Column="1" Content="Check for updates" Classes="secondary-action"
                Click="OnRefreshClicked" VerticalAlignment="Center" />
      </p:ResponsiveGrid>
      <ItemsControl ItemsSource="{Binding Cards}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:BuilderSdkCardViewModel">
            <Border Classes="card-surface" Margin="0,0,0,12">
              <StackPanel Spacing="12">
                <p:ResponsiveGrid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Sunder.Spacing.Medium}" RowSpacing="{DynamicResource Sunder.Spacing.Small}">
                  <Border Width="48" Height="48" CornerRadius="{DynamicResource Sunder.Radius.Small}" Background="{DynamicResource Sunder.Brush.Surface.Raised}">
                    <TextBlock Text="{Binding Glyph}" FontSize="{DynamicResource Sunder.FontSize.Body}" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="{DynamicResource Sunder.FontSize.SectionTitle}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Status}" />
                  </StackPanel>
                  <Button Grid.Column="2" Content="{Binding PrimaryActionText}" Classes="primary-action"
                          Click="OnInstallClicked" IsVisible="{Binding ShowPrimaryAction}"
                          IsEnabled="{Binding CanManage}" VerticalAlignment="Center" />
                </p:ResponsiveGrid>
                <TextBlock Text="{Binding VersionText}" Classes="caption" />
                <ProgressBar IsVisible="{Binding IsRefreshing}" IsIndeterminate="True" />
                <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding ShowOperationStatus}">
                  <TextBlock Text="{Binding Message}" IsVisible="{Binding ShowMessage}" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="Cancel operation" Classes="secondary-action"
                          Click="OnCancelClicked" IsVisible="{Binding IsBusy}" />
                </Grid>
                <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                           Foreground="{DynamicResource Sunder.Brush.Warning}" />
                <Expander Header="Details" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="10" Margin="0,8,0,0">
                    <TextBlock Text="{Binding Description}" Classes="caption" />
                    <TextBlock Text="{Binding LastCheckText}" Classes="caption" />
                    <TextBlock Text="No SDK installations found." IsVisible="{Binding IsEmpty}" Classes="caption" />
                    <ItemsControl ItemsSource="{Binding Installations}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BuilderSdkInstallationViewModel">
                          <Border BorderBrush="{DynamicResource Sunder.Brush.Border.Subtle}" BorderThickness="0,1,0,0" Padding="0,12" Margin="0,6,0,0">
                            <StackPanel Spacing="6">
                              <WrapPanel><TextBlock Text="{Binding Version}" FontWeight="SemiBold" Margin="0,0,12,0" /><TextBlock Text="{Binding Origin}" Classes="caption" /></WrapPanel>
                              <SelectableTextBlock Text="{Binding ExecutablePath}" TextWrapping="Wrap" FontSize="{DynamicResource Sunder.FontSize.Caption}" />
                              <TextBlock Text="{Binding NpmText}" Classes="caption" />
                              <TextBlock Text="{Binding HealthText}" />
                              <WrapPanel>
                                <Button Content="Repair" Classes="secondary-action" Click="OnRepairClicked" IsEnabled="{Binding CanManage}" Margin="0,0,8,0" />
                                <Button Content="Remove" Classes="secondary-action" Click="OnRemoveClicked" IsEnabled="{Binding CanManage}" />
                              </WrapPanel>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Expander>
                <Expander Header="SDK operation output" IsVisible="{Binding HasOutput}" HorizontalAlignment="Stretch"><ScrollViewer MaxHeight="220"><SelectableTextBlock Text="{Binding Output}" TextWrapping="Wrap" FontSize="{DynamicResource Sunder.FontSize.Caption}" /></ScrollViewer></Expander>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
