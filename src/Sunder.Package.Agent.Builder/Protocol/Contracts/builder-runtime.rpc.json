{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "descriptorVersion": 2,
  "schemaProfile": "sunder.rpc.values.v1",
  "contractId": "sunder.package.agent.builder.runtime",
  "version": "1.0.0",
  "errors": {
    "agent.builder.execution-target-unavailable": {
      "description": "The selected execution-target activation became unavailable."
    },
    "agent.builder.invalid-request": {
      "description": "The Builder request is incomplete or invalid."
    },
    "agent.builder.request-too-large": {
      "description": "The Builder request exceeds its package-owned payload limit."
    },
    "agent.builder.response-too-large": {
      "description": "The Builder response exceeds its package-owned content limit."
    },
    "agent.builder.unsupported-operation": {
      "description": "The selected execution target does not implement the requested Builder operation."
    },
    "agent.builder.workspace-execution-unavailable": {
      "description": "The Agent workspace execution resolver is unavailable."
    }
  },
  "services": {
    "builder-runtime": {
      "methods": {
        "execute": {
          "kind": "unary",
          "idempotency": "none",
          "errors": [
            "agent.builder.execution-target-unavailable",
            "agent.builder.invalid-request",
            "agent.builder.request-too-large",
            "agent.builder.response-too-large",
            "agent.builder.unsupported-operation",
            "agent.builder.workspace-execution-unavailable"
          ],
          "requestSchema": {
            "$ref": "#/$defs/BuilderExecuteRequest"
          },
          "responseSchema": {
            "$ref": "#/$defs/BuilderResultContent"
          }
        }
      }
    }
  },
  "$defs": {
    "BuilderOperation": {
      "type": "string",
      "enum": [
        "list-workspaces",
        "resolve-workspace",
        "execute-process",
        "execute-shell",
        "map-to-host-path",
        "add-path-entry"
      ]
    },
    "WorkspaceId": {
      "type": "string",
      "minLength": 1
    },
    "ExecutableName": {
      "type": "string",
      "minLength": 1
    },
    "ProcessArgument": {
      "type": "string"
    },
    "ProcessArguments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProcessArgument"
      }
    },
    "ShellCommand": {
      "type": "string",
      "minLength": 1
    },
    "ExecutionPath": {
      "type": "string",
      "minLength": 1
    },
    "TimeoutSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "BuilderExecuteRequest": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/BuilderOperation"
        },
        "workspaceId": {
          "$ref": "#/$defs/WorkspaceId"
        },
        "fileName": {
          "$ref": "#/$defs/ExecutableName"
        },
        "arguments": {
          "$ref": "#/$defs/ProcessArguments"
        },
        "command": {
          "$ref": "#/$defs/ShellCommand"
        },
        "workingDirectory": {
          "$ref": "#/$defs/ExecutionPath"
        },
        "timeoutSeconds": {
          "$ref": "#/$defs/TimeoutSeconds"
        },
        "executionPath": {
          "$ref": "#/$defs/ExecutionPath"
        }
      },
      "required": [
        "kind",
        "timeoutSeconds"
      ],
      "additionalProperties": false
    },
    "ContentReference": {
      "type": "object",
      "logicalType": "content-reference"
    },
    "BuilderResultContent": {
      "type": "object",
      "properties": {
        "content": {
          "$ref": "#/$defs/ContentReference"
        }
      },
      "required": [
        "content"
      ],
      "additionalProperties": false
    }
  }
}
