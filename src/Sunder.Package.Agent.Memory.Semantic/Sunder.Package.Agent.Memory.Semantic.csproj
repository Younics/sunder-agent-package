<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <SunderPackageFamilyId>sunder.package.agent.memory.semantic</SunderPackageFamilyId>
    <SunderPackageRole>worker</SunderPackageRole>
    <SunderPackageProject>true</SunderPackageProject>
    <SunderSdkWorkerReference>true</SunderSdkWorkerReference>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <UseAppHost>true</UseAppHost>
    <PublishSingleFile>false</PublishSingleFile>
    <SunderGeneratedPackageManifest>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\sunder-package.json'))</SunderGeneratedPackageManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <ProjectReference Include="..\Sunder.Package.Agent.Contracts\Sunder.Package.Agent.Contracts.csproj" />
    <ProjectReference Include="Protocol\Sunder.Package.Agent.Memory.Semantic.Protocol.csproj"
                      PrivateAssets="all" />
    <Compile Include="..\Sunder.Package.Agent.Shared\Threading\ReferenceCountedKeyedLock.cs"
             Link="Threading\ReferenceCountedKeyedLock.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Aggregate\**\*" />
    <Compile Remove="App\**\*" />
    <Compile Remove="MemoryStoreModels.cs" />
    <Compile Remove="PackageViews\**\*" />
    <Compile Remove="Protocol\**\*" />
    <None Remove="Aggregate\**\*" />
    <None Remove="App\**\*" />
    <None Remove="PackageViews\**\*" />
    <None Remove="Protocol\**\*" />
  </ItemGroup>

  <ItemGroup>
    <SunderContractBundle Include="Protocol\Contracts\memory-inspector.rpc.json"
                          ContractId="sunder.agent.memory.semantic.inspector"
                          Version="2.0.0"
                          DescriptorPath="contracts/memory-inspector.rpc.json"
                          Exposure="package" />
    <SunderRpcProvider Include="semantic.memory.inspector"
                       ContractId="sunder.agent.memory.semantic.inspector"
                       ContractVersion="2.0.0"
                       Role="runtime"
                       Audience="owner" />
    <SunderPackageTarget Include="runtime/$(RuntimeIdentifier)"
                         Role="runtime"
                         Rid="$(RuntimeIdentifier)"
                         Kind="worker" />
  </ItemGroup>

</Project>
