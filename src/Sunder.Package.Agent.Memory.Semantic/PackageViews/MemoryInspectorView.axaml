<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sunder.Package.Agent.Memory.Semantic.PackageViews"
             xmlns:m="using:Sunder.Generated.Packages.Younics_Ai_Agent_Models"
             xmlns:p="using:Sunder.Package.Agent.Shared.Presentation"
             xmlns:shared="using:Sunder.Package.Agent.Shared.PackageViews"
             x:Class="Sunder.Package.Agent.Memory.Semantic.PackageViews.MemoryInspectorView"
             x:DataType="vm:MemoryInspectorViewModel" Classes="agent-page">
  <UserControl.Styles>
    <StyleInclude Source="/Presentation/PresentationStyles.axaml" />
    <Style Selector="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="{DynamicResource Sunder.FontSize.Body}" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Secondary}" />
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Primary}" />
    </Style>
    <Style Selector="TabItem /template/ Border#PART_SelectedPipe">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Accent}" />
    </Style>
    <Style Selector="Border.memory-section">
      <Setter Property="Padding" Value="{DynamicResource Sunder.Padding.Card}" />
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Popover}" />
      <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Small}" />
    </Style>
    <Style Selector="StackPanel.memory-fields">
      <Setter Property="Spacing" Value="{DynamicResource Sunder.Spacing.Medium}" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="{DynamicResource Sunder.Spacing.Small}"
        Background="{DynamicResource Sunder.Brush.Surface.Raised}">
    <WrapPanel ItemSpacing="{DynamicResource Sunder.Spacing.Small}" LineSpacing="{DynamicResource Sunder.Spacing.Small}">
      <TextBlock Classes="page-title" Text="Memory" VerticalAlignment="Center" />
      <shared:SunderComboBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                            MaxWidth="{DynamicResource Sunder.Agent.HelpWidth}" AutomationProperties.Name="Session">
        <shared:SunderComboBox.ItemTemplate><DataTemplate x:DataType="m:AgentSessionRecord"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" /></DataTemplate></shared:SunderComboBox.ItemTemplate>
      </shared:SunderComboBox>
      <TextBox Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="Search memories" AutomationProperties.Name="Search memories" />
      <shared:SunderComboBox ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding CategoryFilter, Mode=TwoWay}" PlaceholderText="All categories" AutomationProperties.Name="Category" />
      <CheckBox Content="Pinned only" IsChecked="{Binding OnlyPinned, Mode=TwoWay}" />
      <CheckBox Content="Include inactive" IsChecked="{Binding IncludeInactive, Mode=TwoWay}" />
      <Button Content="Refresh" Classes="secondary-action" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}" />
    </WrapPanel>
    <TabControl Grid.Row="1" x:Name="InspectorTabs" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">
      <TabItem Header="Graph">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="{DynamicResource Sunder.Spacing.Small}">
          <WrapPanel ItemSpacing="{DynamicResource Sunder.Spacing.Small}" LineSpacing="{DynamicResource Sunder.Spacing.Small}">
            <p:SectionHeader Title="Connections" HelpText="Drag the background to pan and scroll to zoom. Drag memories to arrange them. Select a memory to highlight its recorded connections. Source links point from a turn to a memory; replacement links point from an older memory to its replacement. Evidence appears for the selected memory. Nearby nodes do not imply similarity." />
            <Button Content="−" Classes="secondary-action" Click="OnZoomOut" AutomationProperties.Name="Zoom out" />
            <Button Content="+" Classes="secondary-action" Click="OnZoomIn" AutomationProperties.Name="Zoom in" />
            <Button Content="Fit view" Classes="secondary-action" Click="OnFitGraph" />
            <Button Content="Reset layout" Classes="secondary-action" Click="OnResetGraph" />
            <Button Content="Open in Data" Classes="secondary-action" Click="OnOpenData" IsEnabled="{Binding HasSelection}" />
          </WrapPanel>
          <vm:MemoryGraphControl x:Name="MemoryGraph" Grid.Row="1" Graph="{Binding Graph}"
                                 SelectedMemoryId="{Binding SelectedGraphMemoryId, Mode=TwoWay}" />
          <Border Grid.Row="2" Classes="memory-section" IsVisible="{Binding HasSelection}">
            <StackPanel Classes="memory-fields">
              <WrapPanel ItemSpacing="{DynamicResource Sunder.Spacing.Small}">
                <TextBlock Classes="section-title" Text="{Binding SelectedMemory.CategoryLabel}" />
                <TextBlock Classes="caption" Text="{Binding SelectedMemory.StateLabel}" />
              </WrapPanel>
              <SelectableTextBlock Text="{Binding SelectedMemory.Content}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="Data">
        <Grid x:Name="MemoryDataLayout" ColumnDefinitions="320,*">
          <Border x:Name="MemoryListPane" Padding="{DynamicResource Sunder.Padding.Card}">
            <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource Sunder.Spacing.Small}">
              <TextBlock Classes="section-title" Text="Memories" />
              <ListBox Grid.Row="1" ItemsSource="{Binding FilteredMemories}" SelectedItem="{Binding SelectedMemory, Mode=TwoWay}"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:MemoryListItemViewModel">
                    <StackPanel Classes="memory-fields" Tapped="OnMemoryItemTapped">
                      <TextBlock Text="{Binding CategoryLabel}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding PreviewText}" MaxLines="3" TextTrimming="CharacterEllipsis" />
                      <WrapPanel ItemSpacing="{DynamicResource Sunder.Spacing.Small}">
                        <TextBlock Classes="caption" Text="{Binding StateLabel}" />
                        <TextBlock Classes="caption" Text="Pinned" IsVisible="{Binding IsPinned}" />
                        <TextBlock Classes="caption" Text="{Binding UpdatedAtLabel}" />
                      </WrapPanel>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
          <Border x:Name="MemoryDetailPane" Grid.Column="1" Padding="{DynamicResource Sunder.Padding.Card}">
            <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource Sunder.Spacing.Small}">
              <Button Content="Back to memories" Classes="secondary-action" HorizontalAlignment="Left" Click="OnBackToMemories" IsVisible="False" x:Name="MemoryBackButton" />
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <StackPanel Classes="memory-fields">
                <TextBlock Text="Select a memory." IsVisible="{Binding HasNoSelection}" Classes="caption" />
                <StackPanel Classes="memory-fields" IsVisible="{Binding HasSelection}">
                  <p:SectionHeader Title="Memory" HelpText="Save updates this memory. Create correction records a corrected memory and preserves its relationship to the original." />
                  <TextBlock Text="Category" Classes="section-title" />
                  <shared:SunderComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding EditCategory, Mode=TwoWay}" />
                  <TextBlock Text="Content" Classes="section-title" />
                  <TextBox Text="{Binding EditContent, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="{DynamicResource Sunder.Agent.Graph.EditorHeight}" />
                  <WrapPanel ItemSpacing="{DynamicResource Sunder.Spacing.Small}" LineSpacing="{DynamicResource Sunder.Spacing.Small}">
                    <Button Content="Save" Classes="primary-action" Command="{Binding SaveMemoryCommand}" />
                    <Button Content="Create correction" Classes="secondary-action" Command="{Binding CreateCorrectionCommand}" />
                    <Button Content="{Binding PinButtonText}" Classes="secondary-action" Command="{Binding TogglePinnedCommand}" />
                    <TextBlock Text="Unsaved changes" Classes="caption" IsVisible="{Binding IsMemoryDirty}" VerticalAlignment="Center" />
                  </WrapPanel>
                  <Expander Header="State actions">
                    <StackPanel Classes="memory-fields">
                      <p:SectionHeader Title="State" HelpText="Contest flags a memory as disputed. Forget removes it from recall. Supersede marks it as replaced. These actions change stored memory state." />
                      <WrapPanel ItemSpacing="{DynamicResource Sunder.Spacing.Small}" LineSpacing="{DynamicResource Sunder.Spacing.Small}">
                        <Button Content="{Binding ContestButtonText}" Classes="secondary-action" Command="{Binding ContestMemoryCommand}" />
                        <Button Content="Forget" Classes="danger-action" Command="{Binding ForgetMemoryCommand}" />
                        <Button Content="Supersede" Classes="secondary-action" Command="{Binding SupersedeMemoryCommand}" />
                      </WrapPanel>
                    </StackPanel>
                  </Expander>
                  <Expander Header="Evidence" IsExpanded="False">
                    <ItemsControl ItemsSource="{Binding EvidenceItems}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MemoryEvidenceItemViewModel">
                      <Border Classes="memory-section"><StackPanel Classes="memory-fields"><TextBlock Text="{Binding TimestampLabel}" Classes="caption" /><SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" /></StackPanel></Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  </Expander>
                  <Expander Header="Correction history" IsVisible="{Binding HasCorrectionLineage}">
                    <StackPanel Classes="memory-fields">
                      <TextBlock Text="{Binding CorrectionLineageSummaryText}" />
                      <TextBlock Text="Replaced by" Classes="section-title" IsVisible="{Binding HasSupersedingMemory}" />
                      <SelectableTextBlock Text="{Binding SupersedingMemory.Content}" TextWrapping="Wrap" IsVisible="{Binding HasSupersedingMemory}" />
                      <TextBlock Text="Replaces" Classes="section-title" IsVisible="{Binding HasSupersededMemories}" />
                      <ItemsControl ItemsSource="{Binding SupersededMemoryItems}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MemoryListItemViewModel"><SelectableTextBlock Text="{Binding Content}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                  </Expander>
                </StackPanel>
                <Expander Header="Index and diagnostics">
                  <StackPanel Classes="memory-fields">
                    <TextBlock Text="{Binding SemanticStatusText}" />
                    <TextBlock Text="{Binding SelectedMemory.SemanticIndexStatusText}" IsVisible="{Binding HasSelectedMemorySemanticStatus}" />
                    <Button Content="Reindex" Classes="secondary-action" Command="{Binding ReindexSemanticIndexCommand}" IsEnabled="{Binding CanReindexSemanticIndex}" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding SemanticWorkerStatusText}" />
                    <TextBlock Text="{Binding MemoryMetricsSummaryText}" />
                  </StackPanel>
                </Expander>
                <Expander Header="Session summary" IsVisible="{Binding HasWorkingSummary}"><SelectableTextBlock Text="{Binding WorkingSummaryText}" TextWrapping="Wrap" /></Expander>
              </StackPanel>
            </ScrollViewer>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
    <StackPanel Grid.Row="2" Classes="memory-fields">
      <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" />
      <Button Content="Load more memories" Classes="secondary-action" Command="{Binding LoadMoreMemoriesCommand}" IsVisible="{Binding CanLoadMoreMemories}" HorizontalAlignment="Left" />
      <TextBlock Text="More memories are available. Narrow your search to inspect them." Classes="caption" IsVisible="{Binding HasBoundedMemoryPage}" />
      <TextBlock Text="{Binding StatusText}" Classes="caption" IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
  </Grid>
</UserControl>
