<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Sunder.Package.Agent.Memory.Semantic.App</AssemblyName>
    <SunderPackageFamilyId>sunder.package.agent.memory.semantic</SunderPackageFamilyId>
    <SunderPackageRole>app</SunderPackageRole>
    <SunderPackageProject>true</SunderPackageProject>
    <SunderSdkAvaloniaReference>true</SunderSdkAvaloniaReference>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <SunderPackageAssetsDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\Assets'))</SunderPackageAssetsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <ProjectReference Include="..\..\Sunder.Package.Agent.Contracts\Sunder.Package.Agent.Contracts.csproj" />
    <ProjectReference Include="..\Protocol\Sunder.Package.Agent.Memory.Semantic.Protocol.csproj"
                      PrivateAssets="all" />
    <Compile Include="..\PackageMetadata.cs" Link="PackageMetadata.cs" />
    <Compile Include="..\PackageViews\**\*.cs" Link="PackageViews\%(RecursiveDir)%(Filename)%(Extension)" />
    <AvaloniaXaml Include="..\PackageViews\**\*.axaml"
                  Link="PackageViews\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <SunderContractBundle Include="..\Protocol\Contracts\memory-inspector.rpc.json"
                          ContractId="sunder.agent.memory.semantic.inspector"
                            Version="1.0.0"
                          DescriptorPath="contracts/memory-inspector.rpc.json"
                          Exposure="package" />
    <SunderUsesContract Include="sunder.agent.memory.semantic.inspector"
                        Role="app"
                          ContractVersion="1.0.0"
                        Required="true"
                        Actions="discover;invoke;subscribe" />
  </ItemGroup>

  <Import Project="..\..\Sunder.Package.Agent.Shared\Sunder.Package.Agent.Shared.props" />

</Project>
