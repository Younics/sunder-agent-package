{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "descriptorVersion": 2,
  "schemaProfile": "sunder.rpc.values.v1",
  "contractId": "sunder.agent.memory.semantic.inspector",
  "version": "2.0.0",
  "errors": {
    "memory.semantic.operation-failed": {
      "description": "The requested semantic memory operation could not be completed."
    }
  },
  "services": {
    "memory-inspector": {
      "methods": {
        "query": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": ["memory.semantic.operation-failed"],
          "requestSchema": { "$ref": "#/$defs/MemoryQuery" },
          "responseSchema": { "$ref": "#/$defs/MemoryProjectionContent" }
        },
        "command": {
          "kind": "unary",
          "idempotency": "none",
          "errors": ["memory.semantic.operation-failed"],
          "requestSchema": { "$ref": "#/$defs/MemoryCommand" },
          "responseSchema": { "$ref": "#/$defs/MemoryProjectionContent" }
        },
        "changes": {
          "kind": "server-stream",
          "idempotency": "idempotent",
          "errors": ["memory.semantic.operation-failed"],
          "requestSchema": { "$ref": "#/$defs/MemoryChangeSubscription" },
          "eventSchema": { "$ref": "#/$defs/MemoryChanged" }
        }
      }
    }
  },
  "$defs": {
    "MemoryId": {
      "type": "string",
      "format": "uuid"
    },
    "ProfileId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "SearchText": {
      "type": "string",
      "minLength": 0,
      "maxLength": 1024
    },
    "MemoryCategory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "MemoryContent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "EvidenceText": {
      "type": "string",
      "minLength": 0,
      "maxLength": 65536
    },
    "CorrectionNote": {
      "type": "string",
      "minLength": 0,
      "maxLength": 4096
    },
    "StatusText": {
      "type": "string",
      "minLength": 0,
      "maxLength": 2048
    },
    "ProviderId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "ModelId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "ConfigurationFingerprint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "MemoryScore": {
      "type": "number",
      "format": "float32",
      "minimum": 0,
      "maximum": 1
    },
    "AccessCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "MemoryRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "MemoryQueryKind": {
      "type": "string",
      "minLength": 7,
      "maxLength": 21,
      "enum": [
        "sessions",
        "session-checkpoint",
        "working-summary",
        "memories",
        "details",
        "semantic-state",
        "semantic-index-status",
        "worker-status",
        "metrics"
      ]
    },
    "MemoryCommandKind": {
      "type": "string",
      "minLength": 3,
      "maxLength": 9,
      "enum": ["update", "pin", "contest", "forget", "supersede", "correct", "reindex"]
    },
    "MemoryProvenance": {
      "type": "string",
      "minLength": 4,
      "maxLength": 9,
      "enum": ["unknown", "user", "assistant", "tool"]
    },
    "MemoryState": {
      "type": "string",
      "minLength": 6,
      "maxLength": 10,
      "enum": ["active", "contested", "forgotten", "superseded"]
    },
    "StoredMemory": {
      "type": "object",
      "properties": {
        "memoryId": { "$ref": "#/$defs/MemoryId" },
        "sessionId": { "$ref": "#/$defs/MemoryId" },
        "category": { "$ref": "#/$defs/MemoryCategory" },
        "content": { "$ref": "#/$defs/MemoryContent" },
        "evidenceText": { "$ref": "#/$defs/EvidenceText" },
        "sourceTurnId": { "$ref": "#/$defs/MemoryId" },
        "importance": { "$ref": "#/$defs/MemoryScore" },
        "confidence": { "$ref": "#/$defs/MemoryScore" },
        "isPinned": { "type": "boolean" },
        "state": { "$ref": "#/$defs/MemoryState" },
        "supersededByMemoryId": { "$ref": "#/$defs/MemoryId" },
        "createdAtUtc": { "type": "string", "format": "date-time" },
        "updatedAtUtc": { "type": "string", "format": "date-time" },
        "lastAccessedAtUtc": { "type": "string", "format": "date-time" },
        "accessCount": { "$ref": "#/$defs/AccessCount" },
        "provenance": { "$ref": "#/$defs/MemoryProvenance" },
        "memoryRevision": { "$ref": "#/$defs/MemoryRevision" },
        "isManual": { "type": "boolean" }
      },
      "required": [
        "memoryId",
        "sessionId",
        "category",
        "content",
        "importance",
        "confidence",
        "isPinned",
        "state",
        "createdAtUtc",
        "updatedAtUtc",
        "accessCount",
        "provenance",
        "memoryRevision",
        "isManual"
      ],
      "additionalProperties": false
    },
    "SemanticEmbeddingContext": {
      "type": "object",
      "properties": {
        "statusLabel": { "$ref": "#/$defs/StatusText" },
        "statusText": { "$ref": "#/$defs/StatusText" },
        "isReady": { "type": "boolean" },
        "providerId": { "$ref": "#/$defs/ProviderId" },
        "modelId": { "$ref": "#/$defs/ModelId" },
        "providerDisplayName": { "$ref": "#/$defs/StatusText" },
        "configurationFingerprint": { "$ref": "#/$defs/ConfigurationFingerprint" }
      },
      "required": ["statusLabel", "statusText", "isReady"],
      "additionalProperties": false
    },
    "MemoryQuery": {
      "type": "object",
      "properties": {
        "kind": { "$ref": "#/$defs/MemoryQueryKind" },
        "sessionId": { "$ref": "#/$defs/MemoryId" },
        "memoryId": { "$ref": "#/$defs/MemoryId" },
        "searchText": { "$ref": "#/$defs/SearchText" },
        "includeInactive": { "type": "boolean" },
        "profileId": { "$ref": "#/$defs/ProfileId" },
        "memory": { "$ref": "#/$defs/StoredMemory" },
        "semanticContext": { "$ref": "#/$defs/SemanticEmbeddingContext" }
      },
      "required": ["kind", "includeInactive"],
      "additionalProperties": false
    },
    "MemoryCommand": {
      "type": "object",
      "properties": {
        "kind": { "$ref": "#/$defs/MemoryCommandKind" },
        "memoryId": { "$ref": "#/$defs/MemoryId" },
        "category": { "$ref": "#/$defs/MemoryCategory" },
        "content": { "$ref": "#/$defs/MemoryContent" },
        "note": { "$ref": "#/$defs/CorrectionNote" },
        "isPinned": { "type": "boolean" },
        "profileId": { "$ref": "#/$defs/ProfileId" }
      },
      "required": ["kind", "memoryId", "isPinned"],
      "additionalProperties": false
    },
    "ContentReference": {
      "type": "object",
      "logicalType": "content-reference"
    },
    "MemoryProjectionContent": {
      "type": "object",
      "properties": {
        "content": { "$ref": "#/$defs/ContentReference" }
      },
      "required": ["content"],
      "additionalProperties": false
    },
    "MemoryChangeSubscription": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "MemoryChangeKind": {
      "type": "string",
      "minLength": 6,
      "maxLength": 7,
      "enum": ["session", "worker"]
    },
    "MemoryChanged": {
      "type": "object",
      "properties": {
        "kind": { "$ref": "#/$defs/MemoryChangeKind" },
        "sessionId": { "$ref": "#/$defs/MemoryId" }
      },
      "required": ["kind"],
      "additionalProperties": false
    }
  }
}
