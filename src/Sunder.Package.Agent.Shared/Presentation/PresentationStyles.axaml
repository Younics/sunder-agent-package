<Styles xmlns="https://github.com/avaloniaui">
  <Style Selector="Border.settings-status-pill">
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.settings-status-pill.success">
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Info.Soft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Accent}" />
  </Style>

  <Style Selector="Border.settings-status-pill.warning">
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Selected}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Strong}" />
  </Style>

  <Style Selector="Border.settings-status-pill.danger">
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Danger.Soft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Danger}" />
  </Style>

  <Style Selector="TextBlock.settings-status-label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Primary}" />
  </Style>

  <Style Selector="Border.settings-status-pill.success TextBlock.settings-status-label">
    <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Accent}" />
  </Style>

  <Style Selector="Border.settings-status-pill.danger TextBlock.settings-status-label">
    <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.OnDanger}" />
  </Style>

  <Style Selector="Border.settings-detail-card">
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Small}" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <Style Selector="TextBox.secret-field">
    <Setter Property="PasswordChar" Value="*" />
  </Style>

  <Style Selector="Border.settings-confirmation-card">
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Danger.Soft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Danger}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Small}" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <Style Selector="TextBlock.settings-operation-status">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Muted}" />
  </Style>

  <Style Selector="TextBlock.settings-operation-status.success">
    <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Accent}" />
  </Style>

  <Style Selector="TextBlock.settings-operation-status.warning">
    <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Secondary}" />
  </Style>

  <Style Selector="TextBlock.settings-operation-status.danger">
    <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Danger}" />
  </Style>
</Styles>
