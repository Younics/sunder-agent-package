<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="using:Sunder.Package.Agent.Shared.Presentation">
  <Styles.Resources>
    <DataTemplate x:Key="ModelBindingProviderOptionTemplate"
                  x:DataType="p:ProviderCatalogOption">
      <TextBlock Text="{Binding Label}" />
    </DataTemplate>

    <DataTemplate x:Key="ModelBindingModelOptionTemplate"
                  x:DataType="p:ProviderModelCatalogOption">
      <TextBlock Text="{Binding Label}" />
    </DataTemplate>

    <DataTemplate x:Key="ModelBindingReasoningOptionTemplate"
                  x:DataType="p:ModelReasoningOption">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding Label}" />
        <TextBlock Text="{Binding Description}"
                   IsVisible="{Binding HasDescription}"
                   FontSize="12"
                   Foreground="{DynamicResource Sunder.Brush.Foreground.Muted}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ModelBindingSpeedOptionTemplate"
                  x:DataType="p:ModelSpeedOption">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding Label}" />
        <TextBlock Text="{Binding Description}"
                   IsVisible="{Binding HasDescription}"
                   FontSize="12"
                   Foreground="{DynamicResource Sunder.Brush.Foreground.Muted}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ModelBindingModeOptionTemplate"
                  x:DataType="p:ModelModeOption">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding Label}" />
        <TextBlock Text="{Binding Description}"
                   IsVisible="{Binding HasDescription}"
                   FontSize="12"
                   Foreground="{DynamicResource Sunder.Brush.Foreground.Muted}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="CapabilityOptionTemplate"
                  x:DataType="p:CapabilityOptionState">
      <Border Padding="0,4">
        <StackPanel Spacing="4">
          <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                    IsEnabled="{Binding CanSelect}">
            <TextBlock Text="{Binding DisplayName}" />
          </CheckBox>
          <TextBlock Text="{Binding Description}"
                     Margin="24,0,0,0"
                     MaxLines="2"
                     TextTrimming="CharacterEllipsis"
                     FontSize="12"
                     Foreground="{DynamicResource Sunder.Brush.Foreground.Muted}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="CapabilityGroupTemplate"
                  x:DataType="p:CapabilityGroupState">
      <StackPanel Spacing="8"
                  Margin="0,4,0,10">
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding Title}"
                     FontSize="14"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource Sunder.Brush.Foreground.Primary}" />
          <TextBlock Text="{Binding Description}"
                     MaxLines="2"
                     TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding HasDescription}"
                     FontSize="12"
                     Foreground="{DynamicResource Sunder.Brush.Foreground.Muted}"
                     TextWrapping="Wrap" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Options}"
                      ItemTemplate="{StaticResource CapabilityOptionTemplate}" />
      </StackPanel>
    </DataTemplate>
  </Styles.Resources>
</Styles>
