<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="using:Sunder.Package.Agent.Shared.Presentation">
  <Styles.Resources>
    <ControlTheme x:Key="ModelBindingReasoningItemTheme" TargetType="ComboBoxItem"
                  BasedOn="{StaticResource {x:Type ComboBoxItem}}" x:DataType="p:ModelReasoningOption">
      <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
      <Setter Property="ToolTip.Tip" Value="{Binding Description}" />
    </ControlTheme>
    <DataTemplate x:Key="ModelBindingProviderOptionTemplate"
                  x:DataType="p:ProviderCatalogOption">
      <TextBlock Text="{Binding Label}" />
    </DataTemplate>

    <DataTemplate x:Key="ModelBindingModelOptionTemplate"
                  x:DataType="p:ProviderModelCatalogOption">
      <TextBlock Text="{Binding Label}" ToolTip.Tip="{Binding Description}" TextTrimming="CharacterEllipsis" />
    </DataTemplate>

    <DataTemplate x:Key="ModelBindingReasoningOptionTemplate"
                  x:DataType="p:ModelReasoningOption">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding Label}" />
        <TextBlock Text="{Binding Description}"
                   IsVisible="{Binding HasDescription}"
                   FontSize="{DynamicResource Sunder.FontSize.Caption}"
                   Foreground="{DynamicResource Sunder.Brush.Foreground.Muted}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ModelBindingSpeedOptionTemplate"
                  x:DataType="p:ModelSpeedOption">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding Label}" />
        <TextBlock Text="{Binding Description}"
                   IsVisible="{Binding HasDescription}"
                   FontSize="{DynamicResource Sunder.FontSize.Caption}"
                   Foreground="{DynamicResource Sunder.Brush.Foreground.Muted}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ModelBindingModeOptionTemplate"
                  x:DataType="p:ModelModeOption">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding Label}" />
        <TextBlock Text="{Binding Description}"
                   IsVisible="{Binding HasDescription}"
                   FontSize="{DynamicResource Sunder.FontSize.Caption}"
                   Foreground="{DynamicResource Sunder.Brush.Foreground.Muted}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="CapabilityOptionTemplate"
                  x:DataType="p:CapabilityOptionState">
      <Border Padding="0,4">
        <StackPanel Spacing="{DynamicResource Sunder.Spacing.XSmall}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Sunder.Spacing.XSmall}">
          <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                    IsEnabled="{Binding CanSelect}">
            <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" />
          </CheckBox>
          <p:SectionHelpButton Grid.Column="1" HelpText="{Binding Description}"
                               IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </Grid>
          <TextBlock Text="{Binding StatusText}"
                     IsVisible="{Binding HasStatusText}"
                     Margin="{DynamicResource Sunder.Agent.ChildIndent}"
                     FontSize="{DynamicResource Sunder.FontSize.Caption}"
                     Foreground="{DynamicResource Sunder.Brush.Foreground.Muted}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="CapabilityGroupTemplate"
                  x:DataType="p:CapabilityGroupState">
      <StackPanel Spacing="{DynamicResource Sunder.Spacing.Small}"
                  Margin="0,4,0,10">
        <Border Classes="capability-group-header">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Sunder.Spacing.XSmall}">
          <CheckBox Classes="capability-group-toggle"
                    IsVisible="{Binding AllowsBulkSelection}"
                    IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                    IsEnabled="{Binding CanSelect}">
            <TextBlock Text="{Binding Title}"
                       FontSize="{DynamicResource Sunder.FontSize.SectionTitle}"
                       FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{DynamicResource Sunder.Brush.Foreground.Primary}" />
          </CheckBox>
          <TextBlock Text="{Binding Title}" IsVisible="{Binding !AllowsBulkSelection}"
                     VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap"
                     FontSize="{DynamicResource Sunder.FontSize.SectionTitle}" />
          <p:SectionHelpButton Grid.Column="1" HelpText="{Binding Description}" IsVisible="{Binding HasDescription}" />
        </Grid>
        </Border>
        <ItemsControl ItemsSource="{Binding Options}"
                      Margin="{DynamicResource Sunder.Agent.ChildIndent}"
                      ItemTemplate="{StaticResource CapabilityOptionTemplate}" />
      </StackPanel>
    </DataTemplate>
  </Styles.Resources>
</Styles>
