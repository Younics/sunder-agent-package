             Link="PackageViews\StreamingMarkdownPresenter.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\StableMarkdownRenderer.cs"
             Link="PackageViews\StableMarkdownRenderer.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\ITranscriptAnchorItem.cs"
             Link="PackageViews\ITranscriptAnchorItem.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\ITranscriptGeometrySource.cs"
             Link="PackageViews\ITranscriptGeometrySource.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\TranscriptItemsProjection.cs"
             Link="PackageViews\TranscriptItemsProjection.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\TranscriptRowProjector.cs"
             Link="PackageViews\TranscriptRowProjector.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\TranscriptRowProjector.Tools.cs"
             Link="PackageViews\TranscriptRowProjector.Tools.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\TranscriptRowProjector.Mutations.cs"
             Link="PackageViews\TranscriptRowProjector.Mutations.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\TranscriptRowProjector.Trimming.cs"
             Link="PackageViews\TranscriptRowProjector.Trimming.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\TranscriptScrollCoordinator.cs"
             Link="PackageViews\TranscriptScrollCoordinator.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\TranscriptScrollCoordinator.Anchors.cs"
             Link="PackageViews\TranscriptScrollCoordinator.Anchors.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\TranscriptScrollCoordinator.Anchoring.cs"
             Link="PackageViews\TranscriptScrollCoordinator.Anchoring.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\TranscriptScrollCoordinator.Lifetime.cs"
             Link="PackageViews\TranscriptScrollCoordinator.Lifetime.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\TranscriptScrollCoordinator.Models.cs"
             Link="PackageViews\TranscriptScrollCoordinator.Models.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\TranscriptScrollCoordinator.Mutations.cs"
             Link="PackageViews\TranscriptScrollCoordinator.Mutations.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\TranscriptScrollCoordinator.ViewportMutations.cs"
             Link="PackageViews\TranscriptScrollCoordinator.ViewportMutations.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\TranscriptScrollCoordinator.Interactions.cs"
             Link="PackageViews\TranscriptScrollCoordinator.Interactions.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\TranscriptScrollCoordinator.Paging.cs"
             Link="PackageViews\TranscriptScrollCoordinator.Paging.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\TranscriptScrollCoordinator.Placement.cs"
             Link="PackageViews\TranscriptScrollCoordinator.Placement.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\TranscriptScrollCoordinator.Rendering.cs"
             Link="PackageViews\TranscriptScrollCoordinator.Rendering.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\TranscriptScrollAnchorHost.cs"
