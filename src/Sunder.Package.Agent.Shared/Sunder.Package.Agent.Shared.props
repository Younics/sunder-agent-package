    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\TranscriptRowPresenter.cs"
             Link="PackageViews\TranscriptRowPresenter.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\TranscriptAnchorNavigation.cs"
             Link="PackageViews\TranscriptAnchorNavigation.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\ToolDiffViewModels.cs"
             Link="PackageViews\ToolDiffViewModels.cs" />
    <AvaloniaResource Include="$(MSBuildThisFileDirectory)PackageViews\TranscriptStyles.axaml"
                      Link="PackageViews\TranscriptStyles.axaml" />
  </ItemGroup>
</Project>
