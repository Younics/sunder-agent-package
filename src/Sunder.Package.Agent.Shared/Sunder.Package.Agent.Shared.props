    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\TranscriptToolDetailHost.cs"
              Link="PackageViews\TranscriptToolDetailHost.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\TranscriptToolPreparationPortal.cs"
              Link="PackageViews\TranscriptToolPreparationPortal.cs" />
