<Project>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Composition\*.cs"
             Link="Composition\%(Filename)%(Extension)" />
    <Compile Include="$(MSBuildThisFileDirectory)Presentation\*.cs"
             Exclude="$(MSBuildThisFileDirectory)Presentation\PackageCallbackFlowRunner.cs"
             Link="Presentation\%(Filename)%(Extension)" />
    <Compile Include="$(MSBuildThisFileDirectory)Importing\*.cs"
             Link="Importing\%(Filename)%(Extension)" />
    <Compile Include="$(MSBuildThisFileDirectory)Threading\*.cs"
             Link="Threading\%(Filename)%(Extension)" />
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\SunderComboBox.cs"
             Link="PackageViews\SunderComboBox.cs" />
    <AvaloniaResource Include="$(MSBuildThisFileDirectory)Presentation\PresentationStyles.axaml"
                      Link="Presentation\PresentationStyles.axaml" />
  </ItemGroup>

  <ItemGroup Condition="'$(SunderAgentSharedCallbackFlow)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)Presentation\PackageCallbackFlowRunner.cs"
             Link="Presentation\PackageCallbackFlowRunner.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(SunderAgentSharedTranscript)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\ActivityTicker.cs"
             Link="PackageViews\ActivityTicker.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\AgentRunActivityState.cs"
             Link="PackageViews\AgentRunActivityState.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\InlineRenameFocusCoordinator.cs"
             Link="PackageViews\InlineRenameFocusCoordinator.cs" />
