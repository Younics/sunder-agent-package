<Project>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Composition\*.cs"
             Link="Composition\%(Filename)%(Extension)" />
    <Compile Include="$(MSBuildThisFileDirectory)Presentation\*.cs"
             Exclude="$(MSBuildThisFileDirectory)Presentation\PackageCallbackFlowRunner.cs"
             Link="Presentation\%(Filename)%(Extension)" />
    <Compile Include="$(MSBuildThisFileDirectory)Importing\*.cs"
             Link="Importing\%(Filename)%(Extension)" />
    <Compile Include="$(MSBuildThisFileDirectory)Threading\*.cs"
             Link="Threading\%(Filename)%(Extension)" />
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\SunderComboBox.cs"
             Link="PackageViews\SunderComboBox.cs" />
    <AvaloniaResource Include="$(MSBuildThisFileDirectory)Presentation\PresentationStyles.axaml"
                      Link="Presentation\PresentationStyles.axaml" />
  </ItemGroup>

  <ItemGroup Condition="'$(SunderAgentSharedCallbackFlow)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)Presentation\PackageCallbackFlowRunner.cs"
             Link="Presentation\PackageCallbackFlowRunner.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(SunderAgentSharedTranscript)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\ActivityTicker.cs"
             Link="PackageViews\ActivityTicker.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\AgentRunActivityState.cs"
             Link="PackageViews\AgentRunActivityState.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\InlineRenameFocusCoordinator.cs"
             Link="PackageViews\InlineRenameFocusCoordinator.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\TranscriptRowProjector.cs"
             Link="PackageViews\TranscriptRowProjector.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\TranscriptScrollCoordinator.cs"
             Link="PackageViews\TranscriptScrollCoordinator.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\TranscriptScrollCoordinator.Anchors.cs"
             Link="PackageViews\TranscriptScrollCoordinator.Anchors.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\TranscriptScrollCoordinator.Lifetime.cs"
             Link="PackageViews\TranscriptScrollCoordinator.Lifetime.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\TranscriptScrollCoordinator.Paging.cs"
             Link="PackageViews\TranscriptScrollCoordinator.Paging.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\TranscriptTimelineState.cs"
             Link="PackageViews\TranscriptTimelineState.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\TranscriptToolPresentationService.cs"
             Link="PackageViews\TranscriptToolPresentationService.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\TranscriptViewBehavior.cs"
             Link="PackageViews\TranscriptViewBehavior.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\TranscriptRowWindow.cs"
             Link="PackageViews\TranscriptRowWindow.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\TranscriptRowPresenter.cs"
             Link="PackageViews\TranscriptRowPresenter.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PackageViews\ToolDiffViewModels.cs"
             Link="PackageViews\ToolDiffViewModels.cs" />
    <AvaloniaResource Include="$(MSBuildThisFileDirectory)PackageViews\TranscriptStyles.axaml"
                      Link="PackageViews\TranscriptStyles.axaml" />
  </ItemGroup>
</Project>
