<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vm="using:Sunder.Package.Agent.Provider.LMStudio"
              xmlns:p="using:Sunder.Package.Agent.Shared.Presentation"
             x:Class="Sunder.Package.Agent.Provider.LMStudio.LMStudioSettingsView"
             x:DataType="vm:LMStudioSettingsViewModel" Classes="agent-page">
  <UserControl.Styles>
    <StyleInclude Source="/Presentation/PresentationStyles.axaml" />
    <StyleInclude Source="/Provider.Shared/ProviderSettingsStyles.axaml" />
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="{DynamicResource Sunder.Padding.Panel}"
                Spacing="{DynamicResource Sunder.Spacing.Large}" HorizontalAlignment="Stretch">
      <Border Classes="card-surface"
              IsVisible="{Binding IsLoading}">
        <TextBlock Text="Loading LM Studio settings..."
                   TextWrapping="Wrap" />
      </Border>

      <Border Classes="card-surface"
              IsVisible="{Binding IsError}">
        <StackPanel Spacing="8">
          <TextBlock Classes="section-title"
                     Text="LM Studio settings could not be loaded" />
          <TextBlock Classes="caption"
                     Text="{Binding StatusText}"
                     TextWrapping="Wrap" />
          <Button Classes="secondary-action"
                  Content="Retry"
                  HorizontalAlignment="Left"
                  Command="{Binding RetryInitializationCommand}" />
        </StackPanel>
      </Border>

      <StackPanel Spacing="{DynamicResource Sunder.Spacing.Large}"
                  IsVisible="{Binding IsReady}"
                  IsEnabled="{Binding CanMutate}">
        <Border Classes="card-surface">
          <StackPanel Spacing="{DynamicResource Sunder.Spacing.Medium}">
            <p:ResponsiveGrid ColumnDefinitions="*,Auto"
                  ColumnSpacing="{DynamicResource Sunder.Spacing.Medium}" RowSpacing="{DynamicResource Sunder.Spacing.Small}">
              <p:SectionHeader Title="Connection" HelpText="Use the base URL of your LM Studio OpenAI-compatible server, including /v1. An API key is optional unless required by that server." />
              <Border Grid.Column="1"
                      Classes="settings-status-pill"
                      Classes.success="{Binding IsConnectionConfigured}"
                      Classes.warning="{Binding IsConnectionStatusWarning}"
                      Classes.danger="{Binding IsConnectionStatusError}">
                <TextBlock Classes="settings-status-label"
                           Text="{Binding ConnectionStatusLabel}" />
              </Border>
            </p:ResponsiveGrid>
              <StackPanel Spacing="6">
                <TextBlock Classes="muted"
                           Text="{Binding ConnectionStatusDetail}"
                           TextWrapping="Wrap" />
              </StackPanel>
            <StackPanel Spacing="6">
              <TextBlock Classes="caption"
                         Text="Base URL" />
              <TextBox Text="{Binding BaseUrl, Mode=TwoWay}"
                       PlaceholderText="http://127.0.0.1:1234/v1" />
            </StackPanel>
            <Button Classes="primary-action"
                    Content="Save Connection"
                    HorizontalAlignment="Left"
                    Command="{Binding SaveConnectionCommand}"
                    IsEnabled="{Binding CanSaveSettings}" />
          </StackPanel>
        </Border>

        <ContentControl Content="{Binding ApiKeySettings}"
                        ContentTemplate="{StaticResource ProviderApiKeySettingsTemplate}" />

        <Border Classes="card-surface">
          <StackPanel Spacing="{DynamicResource Sunder.Spacing.Medium}">
            <p:SectionHeader Title="Utility model" HelpText="Used for background tasks such as session names. Leave blank to use the first model returned by LM Studio." />
            <TextBox Text="{Binding UtilityModelId, Mode=TwoWay}"
                     PlaceholderText="lmstudio/model-name" />
            <Button Classes="primary-action"
                    Content="Save Utility Model"
                    HorizontalAlignment="Left"
                    Command="{Binding SaveUtilityModelCommand}"
                    IsEnabled="{Binding CanSaveSettings}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
