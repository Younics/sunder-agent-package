<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sunder.Package.Agent.Provider.Anthropic"
             x:Class="Sunder.Package.Agent.Provider.Anthropic.AnthropicSettingsView"
             x:DataType="vm:AnthropicSettingsViewModel" Classes="agent-page">
  <UserControl.Styles>
    <StyleInclude Source="/Presentation/PresentationStyles.axaml" />
    <StyleInclude Source="/Provider.Shared/ProviderSettingsStyles.axaml" />
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="{DynamicResource Sunder.Padding.Panel}"
                Spacing="{DynamicResource Sunder.Spacing.Large}">
      <ContentControl Content="{Binding ApiKeySettings}"
                      ContentTemplate="{StaticResource ProviderApiKeySettingsTemplate}" />
      <ContentControl Content="{Binding UtilityModelSettings}"
                      ContentTemplate="{StaticResource ProviderUtilityModelSettingsTemplate}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
