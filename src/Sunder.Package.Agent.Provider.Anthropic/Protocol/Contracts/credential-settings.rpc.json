{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "descriptorVersion": 2,
  "schemaProfile": "sunder.rpc.values.v1",
  "contractId": "sunder.package.agent.provider.anthropic.credentials",
  "version": "1.0.0",
  "errors": {
    "provider.credential.command-invalid": {
      "description": "The credential command kind is not supported."
    },
    "provider.credential.required": {
      "description": "A set command requires a non-empty credential."
    },
    "provider.credential.unexpected": {
      "description": "A clear command must not contain a credential."
    }
  },
  "services": {
    "credential-settings": {
      "methods": {
        "command": {
          "kind": "unary",
          "idempotency": "none",
          "errors": [
            "provider.credential.command-invalid",
            "provider.credential.required",
            "provider.credential.unexpected"
          ],
          "requestSchema": {
            "$ref": "#/$defs/CredentialCommand"
          },
          "responseSchema": {
            "$ref": "#/$defs/CredentialSnapshot"
          }
        },
        "query": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/CredentialQuery"
          },
          "responseSchema": {
            "$ref": "#/$defs/CredentialSnapshot"
          }
        }
      }
    }
  },
  "$defs": {
    "CredentialOperation": {
      "type": "string",
      "enum": [
        "set",
        "clear"
      ]
    },
    "CredentialValue": {
      "type": "string",
      "minLength": 1
    },
    "CredentialCommand": {
      "type": "object",
      "properties": {
        "credential": {
          "$ref": "#/$defs/CredentialValue"
        },
        "kind": {
          "$ref": "#/$defs/CredentialOperation"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "CredentialQuery": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "CredentialSnapshot": {
      "type": "object",
      "properties": {
        "hasStoredCredential": {
          "type": "boolean"
        }
      },
      "required": [
        "hasStoredCredential"
      ],
      "additionalProperties": false
    }
  }
}
