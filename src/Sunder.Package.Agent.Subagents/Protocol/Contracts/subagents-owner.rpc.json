{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "descriptorVersion": 2,
  "schemaProfile": "sunder.rpc.values.v1",
  "contractId": "sunder.package.agent.subagents.owner",
  "version": "2.0.0",
  "errors": {
    "subagents.owner.operation-failed": {
      "description": "The requested Subagents operation could not be completed."
    }
  },
  "services": {
    "subagents-management": {
      "methods": {
        "query": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": ["subagents.owner.operation-failed"],
          "requestSchema": { "$ref": "#/$defs/OwnerContent" },
          "responseSchema": { "$ref": "#/$defs/OwnerContent" }
        },
        "command": {
          "kind": "unary",
          "idempotency": "none",
          "errors": ["subagents.owner.operation-failed"],
          "requestSchema": { "$ref": "#/$defs/OwnerContent" },
          "responseSchema": { "$ref": "#/$defs/OwnerContent" }
        },
        "changes": {
          "kind": "server-stream",
          "idempotency": "idempotent",
          "errors": ["subagents.owner.operation-failed"],
          "requestSchema": { "$ref": "#/$defs/ChangeSubscription" },
          "eventSchema": { "$ref": "#/$defs/OwnerContent" }
        }
      }
    }
  },
  "$defs": {
    "ContentReference": {
      "type": "object",
      "logicalType": "content-reference"
    },
    "ChangeRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "OwnerContent": {
      "type": "object",
      "properties": {
        "content": { "$ref": "#/$defs/ContentReference" }
      },
      "required": ["content"],
      "additionalProperties": false
    },
    "ChangeSubscription": {
      "type": "object",
      "properties": {
        "afterRevision": { "$ref": "#/$defs/ChangeRevision" }
      },
      "required": ["afterRevision"],
      "additionalProperties": false
    }
  }
}
