<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:p="using:Sunder.Package.Agent.Shared.Presentation"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:vm="using:Sunder.Package.Agent.Subagents.PackageViews"
              xmlns:m="using:Sunder.Package.Agent.Subagents.Models"
              xmlns:shared="using:Sunder.Package.Agent.Shared.PackageViews"
              x:Class="Sunder.Package.Agent.Subagents.PackageViews.SubagentsView"
             x:DataType="vm:SubagentsViewModel"
              mc:Ignorable="d" Classes="agent-page">

  <UserControl.Styles>
    <StyleInclude Source="/Presentation/PresentationStyles.axaml" />
    <StyleInclude Source="/Presentation/ModelBindingStyles.axaml" />

    <Style Selector="Border.subagent-shell">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Raised}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="Border.subagent-pane">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Raised}" />
    </Style>

    <Style Selector="Border.subagent-list-pane">
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>

    <Style Selector="Border.subagent-pane-header">
      <Setter Property="Padding" Value="{DynamicResource Sunder.Padding.Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style Selector="Border.subagent-list-body">
      <Setter Property="Padding" Value="{DynamicResource Sunder.Padding.Panel}" />
    </Style>

    <Style Selector="Border.subagent-editor-body">
      <Setter Property="Padding" Value="{DynamicResource Sunder.Padding.Panel}" />
      <Setter Property="MaxWidth" Value="{DynamicResource Sunder.Agent.FormWidth}" />
    </Style>

    <Style Selector="Border.subagent-actions">
      <Setter Property="Padding" Value="{DynamicResource Sunder.Padding.Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

    <Style Selector="Border.subagent-status-message">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Warning.Soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Warning}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Small}" />
      <Setter Property="Padding" Value="{DynamicResource Sunder.Padding.Card}" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style Selector="Border.subagent-status-message.success">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Success.Soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Success}" />
    </Style>

    <Style Selector="Border.subagent-status-message.error">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Danger.Soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Danger}" />
    </Style>

    <Style Selector="TextBlock.subagent-status-message">
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Warning}" />
      <Setter Property="FontSize" Value="{DynamicResource Sunder.FontSize.Caption}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.subagent-status-message.success">
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Success}" />
    </Style>

    <Style Selector="TextBlock.subagent-status-message.error">
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Danger}" />
    </Style>

    <Style Selector="TextBlock.subagent-title">
      <Setter Property="FontSize" Value="{DynamicResource Sunder.FontSize.PageTitle}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Primary}" />
    </Style>

    <Style Selector="TextBlock.subagent-caption">
      <Setter Property="FontSize" Value="{DynamicResource Sunder.FontSize.Caption}" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Secondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.subagent-field-label">
      <Setter Property="FontSize" Value="{DynamicResource Sunder.FontSize.Body}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Primary}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style Selector="TextBlock.subagent-field-help">
      <Setter Property="FontSize" Value="{DynamicResource Sunder.FontSize.Caption}" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Muted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.subagent-field-help.warning-text">
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Warning}" />
    </Style>

    <Style Selector="ListBox.subagent-list">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Transparent}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="ListBox.subagent-list ListBoxItem">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Base}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Small}" />
      <Setter Property="Padding" Value="{DynamicResource Sunder.Padding.Card}" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style Selector="ListBox.subagent-list ListBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Hover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Strong}" />
    </Style>

    <Style Selector="ListBox.subagent-list ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Info.Soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Accent}" />
    </Style>

    <Style Selector="Button.subagent-add-action">
      <Setter Property="Width" Value="36" />
      <Setter Property="MinWidth" Value="36" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="{DynamicResource Sunder.FontSize.PageTitle}" />
      <Setter Property="FontWeight" Value="Regular" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.subagent-card">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Popover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Small}" />
      <Setter Property="Padding" Value="{DynamicResource Sunder.Padding.Card}" />
    </Style>

    <Style Selector="Border.subagent-editor-empty-state">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Code}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Small}" />
      <Setter Property="Padding" Value="{DynamicResource Sunder.Padding.Card}" />
    </Style>

    <Style Selector="Button.subagent-field-icon-action">
      <Setter Property="Width" Value="32" />
      <Setter Property="MinWidth" Value="32" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Transparent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Transparent}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Small}" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Secondary}" />
      <Setter Property="FontSize" Value="{DynamicResource Sunder.FontSize.Body}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.subagent-field-icon-action:pointerover">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Hover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Primary}" />
    </Style>

    <Style Selector="Button.warning-action">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Warning.Soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Strong}" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Warning}" />
    </Style>

    <Style Selector="Button.warning-action:pointerover">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Hover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Strong}" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Warning}" />
    </Style>

    <Style Selector="TextBox.subagent-instructions">
      <Setter Property="MinHeight" Value="140" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>
  </UserControl.Styles>

  <Border Classes="subagent-shell">
    <Grid x:Name="SubagentAdaptiveLayout"
          ColumnDefinitions="360,*"
          ColumnSpacing="4">
      <Border x:Name="SubagentListPane"
              Classes="subagent-pane subagent-list-pane"
              IsVisible="{Binding ShowListPane}">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0"
                  Classes="subagent-pane-header">
            <Grid ColumnDefinitions="*,Auto"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="8">
              <TextBlock Grid.Column="0"
                         Classes="subagent-title"
                         Text="Subagents"
                         VerticalAlignment="Center" />
              <Button Grid.Column="1"
                      Classes="secondary-action compact-action subagent-add-action"
                      Content="+"
                      Command="{Binding CreateSubagentCommand}"
                      ToolTip.Tip="New subagent" />
            </Grid>
          </Border>

          <Border Grid.Row="1"
                  Classes="subagent-list-body">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <ListBox Classes="subagent-list"
                       IsEnabled="{Binding CanNavigateSubagents}"
                       ItemsSource="{Binding Subagents}"
                       SelectedItem="{Binding SelectedSubagent, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="m:SubagentRecord">
                    <Grid RowDefinitions="Auto,Auto"
                          RowSpacing="3"
                          MinWidth="0"
                          Tapped="OnSubagentItemTapped">
                      <TextBlock Text="{Binding DisplayName}"
                                 FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Row="1"
                                 Text="{Binding DescriptionDisplay}"
                                 Foreground="{DynamicResource Sunder.Brush.Foreground.Muted}"
                                 FontSize="{DynamicResource Sunder.FontSize.Caption}"
                                 TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </ScrollViewer>
          </Border>
        </Grid>
      </Border>

      <Border x:Name="SubagentEditorPane"
              Grid.Column="1"
              Classes="subagent-pane"
              IsVisible="{Binding ShowEditorPane}">
        <Grid RowDefinitions="Auto,*,Auto">
          <Border Grid.Row="0"
                  Classes="subagent-pane-header">
            <StackPanel Spacing="8">
              <TextBlock Classes="subagent-title"
                         Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>

          <ScrollViewer Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <Border Classes="subagent-editor-body">
              <StackPanel Spacing="18"
                          IsEnabled="{Binding IsEditorEnabled}"
                          IsVisible="{Binding HasSelectedSubagent}">
                <Border Classes="subagent-card">
                  <StackPanel Spacing="14">
                    <StackPanel Spacing="5">
                      <TextBlock Classes="subagent-field-label"
                                 Text="Display name" />
                      <TextBox x:Name="SubagentDisplayNameTextBox"
                               Text="{Binding DisplayName, Mode=TwoWay}"
                               PlaceholderText="Subagent name" />
                    </StackPanel>

                    <StackPanel Spacing="5">
                      <p:SectionHeader Title="When to use" HelpText="The parent agent uses this description to decide when to delegate work to this subagent." />
                      <TextBox Text="{Binding Description, Mode=TwoWay}"
                               PlaceholderText="Describe the work this subagent handles" />
                      <TextBlock Classes="subagent-field-help"
                                 Text="{Binding DescriptionValidationText}"
                                 IsVisible="{Binding IsSelectedSubagentIncomplete}" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Border Classes="subagent-card">
                  <StackPanel Spacing="14">
                    <p:SectionHeader Title="Instructions" HelpText="Instructions for completing delegated work. The description above determines when the parent agent chooses this subagent." />
                    <TextBox Classes="subagent-instructions"
                             Text="{Binding Instructions, Mode=TwoWay}"
                             PlaceholderText="Subagent instructions"
                             AcceptsReturn="True"
                             TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <Border Classes="subagent-card">
                  <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">
                      <p:SectionHeader Title="Model override" HelpText="Leave the override unset to inherit the parent agent's model. Select a provider and model to use a different one." />
                      <Button Grid.Column="1"
                              Classes="subagent-field-icon-action"
                              Content="↻"
                              Command="{Binding ReloadSubagentChatProvidersCommand}"
                              ToolTip.Tip="Reload providers" />
                    </Grid>

                    <Border Classes="subagent-editor-empty-state"
                            IsVisible="{Binding HasNoChatProviderChoices}">
                      <TextBlock Classes="subagent-field-help"
                                 Text="No chat providers are installed. Install a chat provider package to configure subagent model overrides." />
                    </Border>

                    <StackPanel Spacing="5"
                                IsVisible="{Binding ShowChatProviderPicker}">
                      <TextBlock Classes="subagent-field-label"
                                 Text="Chat provider override" />
                       <shared:SunderComboBox ItemsSource="{Binding ChatProviders}"
                                             SelectedItem="{Binding SelectedChatProvider, Mode=TwoWay}"
                                             ItemTemplate="{StaticResource ModelBindingProviderOptionTemplate}"
                                             HorizontalAlignment="Stretch">
                      </shared:SunderComboBox>
                    </StackPanel>

                    <StackPanel Spacing="5"
                                IsVisible="{Binding ShowChatModelSelection}">
                      <TextBlock Classes="subagent-field-label"
                                 Text="Chat model override" />
                       <shared:SunderComboBox ItemsSource="{Binding ChatModels}"
                                             SelectedItem="{Binding SelectedChatModel, Mode=TwoWay}"
                                             ItemTemplate="{StaticResource ModelBindingModelOptionTemplate}"
                                             HorizontalAlignment="Stretch">
                      </shared:SunderComboBox>
                    </StackPanel>

                    <StackPanel Spacing="5"
                                IsVisible="{Binding ShowSpeedOptions}">
                      <TextBlock Classes="subagent-field-label"
                                 Text="Speed" />
                       <shared:SunderComboBox ItemsSource="{Binding SpeedOptions}"
                                             SelectedItem="{Binding SelectedSpeedOption, Mode=TwoWay}"
                                             ItemTemplate="{StaticResource ModelBindingSpeedOptionTemplate}"
                                             HorizontalAlignment="Stretch">
                      </shared:SunderComboBox>
                    </StackPanel>

                    <StackPanel Spacing="5"
                                IsVisible="{Binding ShowReasoningOptions}">
                      <TextBlock Classes="subagent-field-label"
                                 Text="Reasoning" />
                       <shared:SunderComboBox ItemsSource="{Binding ReasoningOptions}"
                                              SelectedItem="{Binding SelectedReasoningOption, Mode=TwoWay}"
                                              IsEnabled="{Binding IsReasoningSelectionEnabled}"
                                               ItemTemplate="{StaticResource ModelBindingReasoningOptionTemplate}"
                                               ItemContainerTheme="{StaticResource ModelBindingReasoningItemTheme}"
                                             HorizontalAlignment="Stretch">
                      </shared:SunderComboBox>
                    </StackPanel>

                    <Expander Header="Advanced model options" IsVisible="{Binding ShowModeOptions}">
                    <StackPanel Spacing="5">
                      <TextBlock Classes="subagent-field-label"
                                 Text="Mode" />
                       <shared:SunderComboBox ItemsSource="{Binding ModeOptions}"
                                             SelectedItem="{Binding SelectedModeOption, Mode=TwoWay}"
                                             ItemTemplate="{StaticResource ModelBindingModeOptionTemplate}"
                                             HorizontalAlignment="Stretch">
                       </shared:SunderComboBox>
                    </StackPanel>
                    </Expander>

                    <Border Classes="subagent-editor-empty-state"
                            IsVisible="{Binding ShowChatProviderWarning}">
                      <Grid ColumnDefinitions="*,Auto"
                            ColumnSpacing="12">
                        <TextBlock Classes="subagent-field-help warning-text"
                                   Text="{Binding ChatProviderWarningText}"
                                   VerticalAlignment="Top" />
                        <Button Grid.Column="1"
                                Classes="secondary-action compact-action warning-action"
                                Content="Settings"
                                Command="{Binding OpenSelectedChatProviderSettingsCommand}"
                                IsVisible="{Binding CanOpenChatProviderSettings}"
                                VerticalAlignment="Top" />
                      </Grid>
                    </Border>
                  </StackPanel>
                </Border>

                <Border Classes="subagent-card">
                  <StackPanel Spacing="12">
                    <p:SectionHeader Title="Capabilities" HelpText="Selected tools, skills, and servers are available to this subagent, subject to permissions and workspace access. Save to apply changes." />

                    <ItemsControl ItemsSource="{Binding CapabilityGroups}"
                                  ItemTemplate="{StaticResource CapabilityGroupTemplate}" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </ScrollViewer>

          <Border Grid.Row="2"
                  Classes="subagent-actions">
            <Grid RowDefinitions="Auto,Auto">
              <Border Grid.Row="0"
                      Classes="subagent-status-message"
                      Classes.success="{Binding IsStatusSuccess}"
                      Classes.warning="{Binding IsStatusWarning}"
                      Classes.error="{Binding IsStatusError}"
                      IsVisible="{Binding HasStatusText}">
                <TextBlock Classes="subagent-status-message"
                           Classes.success="{Binding IsStatusSuccess}"
                           Classes.warning="{Binding IsStatusWarning}"
                           Classes.error="{Binding IsStatusError}"
                           Text="{Binding StatusText}" />
              </Border>

              <p:EditorFooter Grid.Row="1">
                <Button Grid.Column="0"
                        Classes="secondary-action compact-action danger-action"
                        Content="Delete"
                        Command="{Binding DeleteSubagentCommand}" />
                <TextBlock Grid.Column="1"
                           Text="Unsaved changes"
                           IsVisible="{Binding IsDirty}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Sunder.Brush.Foreground.Muted}"
                           FontSize="{DynamicResource Sunder.FontSize.Caption}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{DynamicResource Sunder.Spacing.Small}">
                <Button
                        Classes="secondary-action compact-action"
                        Content="Back"
                        Command="{Binding BackToSubagentListCommand}"
                        IsVisible="{Binding IsCompactLayout}" />
                <Button
                        Classes="primary-action"
                        Content="Save"
                        Command="{Binding SaveSubagentCommand}" />
                </StackPanel>
              </p:EditorFooter>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
