<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Sunder.Package.Agent.Subagents.PackageViews"
             xmlns:shared="using:Sunder.Package.Agent.Shared.PackageViews"
             xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
             x:Class="Sunder.Package.Agent.Subagents.PackageViews.SubsessionsView"
             x:DataType="vm:SubsessionsViewModel"
             mc:Ignorable="d">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://LiveMarkdown.Avalonia/Defaults.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <DataTemplate x:Key="SubsessionToolDetailsTemplate"
                    x:DataType="vm:SubsessionToolInvocationRowViewModel">
        <Border Classes="tool-output-card"
                Margin="28,10,0,0"
                ClipToBounds="True"
                MinWidth="0">
          <StackPanel Spacing="12"
                      Margin="16"
                      MinWidth="0">
            <TextBlock Text="{Binding OutputText}"
                       FontFamily="Menlo,Consolas,monospace"
                       FontSize="13"
                       MinWidth="0"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasOutput}" />
            <StackPanel Spacing="6"
                        MinWidth="0"
                        IsVisible="{Binding HasToolDiff}">
              <TextBlock Classes="tool-diff-section-title"
                         Text="{Binding ToolDiffSectionTitle}" />
              <ItemsControl ItemsSource="{Binding ToolDiffFiles}"
                            MinWidth="0" />
            </StackPanel>
            <md:MarkdownRenderer MarkdownBuilder="{Binding DetailMarkdownBuilder}"
                                 MinWidth="0"
                                 HorizontalAlignment="Stretch"
                                 IsVisible="{Binding ShowMarkdownDetails}" />
          </StackPanel>
        </Border>
      </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <StyleInclude Source="avares://LiveMarkdown.Avalonia/Styles.axaml" />
    <StyleInclude Source="avares://Sunder.Package.Agent.Subagents/PackageViews/TranscriptStyles.axaml" />

    <Style Selector="Border.subsession-shell">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Raised}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="Border.subsession-pane">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Raised}" />
    </Style>

    <Style Selector="Border.subsession-list-pane">
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>

    <Style Selector="Border.subsession-pane-header">
      <Setter Property="Padding" Value="28,24,28,18" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style Selector="Border.subsession-list-body">
      <Setter Property="Padding" Value="18" />
    </Style>

    <Style Selector="Border.subsession-detail-body">
      <Setter Property="Padding" Value="28,24" />
    </Style>

    <Style Selector="Border.subsession-actions">
      <Setter Property="Padding" Value="18" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

    <Style Selector="TextBlock.subsession-title">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Primary}" />
    </Style>

    <Style Selector="TextBlock.subsession-caption">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Secondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="ListBox.subsession-list">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Transparent}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="ListBox.subsession-list ListBoxItem">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Base}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Small}" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style Selector="ListBox.subsession-list ListBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Hover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Strong}" />
    </Style>

    <Style Selector="ListBox.subsession-list ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Info.Soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Accent}" />
    </Style>

  </UserControl.Styles>

  <UserControl.DataTemplates>
    <DataTemplate x:DataType="shared:ToolDiffFileViewModel">
      <Border Classes="tool-diff-file-card"
              Margin="0,0,0,8">
        <Grid RowDefinitions="Auto,Auto">
          <Border Classes="tool-diff-file-header">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                  ColumnSpacing="10">
              <TextBlock Grid.Column="0"
                         Classes="tool-diff-operation"
                         Text="{Binding OperationText}"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                         Classes="tool-diff-path"
                         Text="{Binding Path}"
                         ToolTip.Tip="{Binding Path}"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="2"
                         Classes="tool-diff-added-count"
                         Text="{Binding AddedLineCountText}"
                         IsVisible="{Binding HasAddedLines}"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="3"
                         Classes="tool-diff-deleted-count"
                         Text="{Binding DeletedLineCountText}"
                         IsVisible="{Binding HasDeletedLines}"
                         VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ItemsControl Grid.Row="1"
                        ItemsSource="{Binding Lines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="shared:ToolDiffLineViewModel">
                <Border Classes="tool-diff-line"
                        Classes.added="{Binding IsAdded}"
                        Classes.deleted="{Binding IsDeleted}"
                        Classes.hunk="{Binding IsHunk}"
                        Classes.collapsed="{Binding IsCollapsed}">
                  <Grid ColumnDefinitions="56,1,*"
                        ColumnSpacing="8">
                    <TextBlock Classes="tool-diff-line-number"
                               Text="{Binding LineNumberText}" />
                    <Border Grid.Column="1"
                            Classes="tool-diff-line-separator" />
                    <TextBlock Grid.Column="2"
                               Classes="tool-diff-content"
                               Classes.added="{Binding IsAdded}"
                               Classes.deleted="{Binding IsDeleted}"
                               Classes.hunk="{Binding IsHunk}"
                               Classes.collapsed="{Binding IsCollapsed}"
                               Text="{Binding Text}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:DataType="vm:SubsessionActivityTranscriptRowViewModel">
      <Grid ColumnDefinitions="42,*"
            ColumnSpacing="16"
            Margin="0,0,0,22"
            MinWidth="0"
            HorizontalAlignment="Stretch">
        <Border Classes="message-avatar"
                VerticalAlignment="Top">
          <TextBlock Classes="avatar-glyph"
                     Text="{Binding RoleGlyph}" />
        </Border>

        <TextBlock Grid.Column="1"
                   Classes="thinking-text"
                   Text="{Binding ThinkingText}"
                   VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:DataType="vm:SubsessionTextTranscriptRowViewModel">
      <Grid Margin="0,0,0,30"
            MinWidth="0"
            HorizontalAlignment="Stretch">
        <Grid ColumnDefinitions="42,*"
              ColumnSpacing="16"
              MinWidth="0"
              HorizontalAlignment="Stretch"
              IsVisible="{Binding IsNotUser}">
          <Border Classes="message-avatar"
                  VerticalAlignment="Top">
            <TextBlock Classes="avatar-glyph"
                       Text="{Binding RoleGlyph}" />
          </Border>
          <Border Grid.Column="1"
                  MinWidth="0"
                  Classes="message-bubble">
            <shared:StreamingMarkdownPresenter MarkdownBuilder="{Binding MarkdownBuilder}"
                                               MinWidth="0"
                                               HorizontalAlignment="Stretch"
                                               Rendered="TranscriptMarkdown_OnRendered" />
          </Border>
        </Grid>
        <Grid ColumnDefinitions="*"
              MinWidth="0"
              HorizontalAlignment="Stretch"
              IsVisible="{Binding IsUser}">
          <Border Classes="message-bubble user"
                  MinWidth="0">
            <shared:StreamingMarkdownPresenter MarkdownBuilder="{Binding MarkdownBuilder}"
                                               MinWidth="0"
                                               HorizontalAlignment="Stretch"
                                               Rendered="TranscriptMarkdown_OnRendered" />
          </Border>
        </Grid>
      </Grid>
    </DataTemplate>

    <DataTemplate x:DataType="vm:SubsessionToolInvocationRowViewModel">
      <Grid ColumnDefinitions="42,*"
            ColumnSpacing="16"
            Margin="0,0,0,20"
            MinWidth="0"
            HorizontalAlignment="Stretch">
        <Border Classes="timeline-spine"
                Margin="0,-22,0,-6" />
        <StackPanel Grid.Column="1"
                    MinWidth="0"
                    HorizontalAlignment="Stretch">
          <Button Classes="tool-step-header"
                  MinWidth="0"
                  Click="ToolStepHeader_OnClick">
            <Grid RowDefinitions="Auto,Auto"
                  ColumnDefinitions="Auto,*,Auto"
                  RowSpacing="3"
                  ColumnSpacing="8"
                  MinWidth="0"
                  HorizontalAlignment="Stretch">
              <Border Grid.Row="0"
                      Grid.Column="0"
                      Classes="tool-state-dot"
                      Background="{Binding StateSoftBrush}"
                      BorderBrush="{Binding StateBrush}">
                <TextBlock Classes="tool-state-icon"
                           Text="{Binding StatusIconText}"
                           Foreground="{Binding StateBrush}" />
              </Border>
              <TextBlock Grid.Row="0"
                         Grid.Column="1"
                         Classes="tool-label"
                         Text="{Binding ToolLabel}"
                         MinWidth="0"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Row="0"
                         Grid.Column="2"
                         Classes="tool-chevron"
                         Text="{Binding ExpandGlyph}" />
              <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Classes="tool-command"
                           Text="{Binding HeaderDetailText}"
                           MinWidth="0"
                           TextWrapping="Wrap"
                          MaxLines="2"
                          TextTrimming="CharacterEllipsis"
                          Margin="0,-1,8,0"
                          IsVisible="{Binding HasHeaderDetail}" />
            </Grid>
          </Button>

          <ItemsControl ItemsSource="{Binding ChildSessionLinks}"
                        IsVisible="{Binding HasChildSessionLinks}"
                        MinWidth="0"
                        Margin="28,8,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SubsessionChildSessionLinkViewModel">
                <Button Classes="secondary-action compact-action"
                        Margin="0,0,8,8"
                        Command="{Binding $parent[UserControl].DataContext.OpenChildSessionCommand}"
                        CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal"
                              Spacing="8">
                    <Border Classes="tool-state-dot"
                            Background="{Binding StateSoftBrush}"
                            BorderBrush="{Binding StateBrush}"
                            ToolTip.Tip="{Binding StatusText}">
                      <TextBlock Classes="tool-state-icon"
                                 Text="{Binding StatusIconText}"
                                 Foreground="{Binding StateBrush}" />
                    </Border>
                    <TextBlock Text="Subsession"
                               Foreground="{DynamicResource Sunder.Brush.Foreground.Muted}" />
                    <TextBlock Text="{Binding DisplayText}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ContentControl Content="{Binding ExpandedDetails}"
                          ContentTemplate="{StaticResource SubsessionToolDetailsTemplate}"
                          MinWidth="0"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch" />
        </StackPanel>
      </Grid>
    </DataTemplate>
  </UserControl.DataTemplates>

  <Border Classes="subsession-shell">
    <Grid x:Name="SubsessionAdaptiveLayout"
          ColumnDefinitions="360,*"
          ColumnSpacing="4">
      <Border x:Name="SubsessionListPane"
              Classes="subsession-pane subsession-list-pane"
              IsVisible="{Binding ShowListPane}">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0"
                  Classes="subsession-pane-header">
            <StackPanel Spacing="8">
              <TextBlock Classes="subsession-title"
                         Text="Subsessions" />
              <TextBlock Classes="subsession-caption"
                         Text="Review live delegated subagent transcripts." />
            </StackPanel>
          </Border>

          <Border Grid.Row="1"
                  Classes="subsession-list-body">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="12">
                <TextBlock Text="No sub-sessions yet."
                           Foreground="{DynamicResource Sunder.Brush.Foreground.Muted}"
                           IsVisible="{Binding HasNoSubsessions}" />
                <ListBox Classes="subsession-list"
                         ItemsSource="{Binding Subsessions}"
                         SelectedItem="{Binding SelectedSubsession, Mode=TwoWay}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SubsessionListItemViewModel">
                      <Grid ColumnDefinitions="*,Auto"
                            ColumnSpacing="10"
                            Tapped="OnSubsessionItemTapped"
                            ToolTip.Tip="{Binding StatusText}">
                        <Grid RowDefinitions="Auto,Auto"
                              RowSpacing="3"
                              MinWidth="0">
                          <TextBlock Text="{Binding Title}"
                                     FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Row="1"
                                     Text="{Binding Subtitle}"
                                     Foreground="{DynamicResource Sunder.Brush.Foreground.Muted}"
                                     FontSize="12"
                                     TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding StatusBadgeText}"
                                   Foreground="{Binding StatusBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </Border>

      <Border x:Name="SubsessionDetailPane"
              Grid.Column="1"
              Classes="subsession-pane"
              IsVisible="{Binding ShowDetailPane}">
        <Grid RowDefinitions="Auto,*,Auto">
          <Border Grid.Row="0"
                  Classes="subsession-pane-header">
            <StackPanel Spacing="8">
              <TextBlock Classes="subsession-title"
                         Text="{Binding SelectedSubsession.Title}" />
              <TextBlock Classes="subsession-caption"
                         Text="{Binding SelectedSubsession.Subtitle}" />
            </StackPanel>
          </Border>

          <Grid Grid.Row="1">
            <ScrollViewer x:Name="TranscriptScrollViewer"
                          Classes="transcript-scroll">
              <Border x:Name="TranscriptScrollContent"
                      Classes="transcript-content"
                      Width="{Binding Viewport.Width, ElementName=TranscriptScrollViewer}">
                <ItemsControl x:Name="TranscriptItemsControl"
                              Classes="transcript-items"
                              ItemsSource="{Binding Messages}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SubsessionTranscriptRowViewModel">
                      <shared:TranscriptRowPresenter Classes="transcript-row-anchor"
                                                     AnchorKey="{Binding AnchorKey}"
                                                     Content="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </ScrollViewer>
            <TextBlock Text="Loading older messages..."
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,24,0,0"
                       Foreground="{DynamicResource Sunder.Brush.Foreground.Muted}"
                       IsVisible="{Binding IsLoadingOlderTranscriptRows}" />
            <TextBlock Text="Select a sub-session to inspect its transcript."
                       Foreground="{DynamicResource Sunder.Brush.Foreground.Muted}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsVisible="{Binding !HasSelectedSubsession}" />
            <TextBlock Text="This sub-session has no transcript messages yet."
                       Foreground="{DynamicResource Sunder.Brush.Foreground.Muted}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsVisible="{Binding ShowEmptyTranscript}" />
            <TextBlock Text="Loading newer messages..."
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,24"
                       Foreground="{DynamicResource Sunder.Brush.Foreground.Muted}"
                       IsVisible="{Binding IsLoadingNewerTranscriptRows}" />
            <Button x:Name="JumpToLatestTranscriptButton"
                    Classes="transcript-jump-latest"
                    Content="↓"
                    Click="JumpToLatestTranscript_OnClick"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="35,0,0,18"
                    ToolTip.Tip="Jump to latest"
                    IsVisible="False" />
          </Grid>

          <Border Grid.Row="2"
                  Classes="subsession-actions"
                  IsVisible="{Binding IsCompactLayout}">
            <Grid ColumnDefinitions="*,Auto">
              <Button Grid.Column="1"
                      Classes="secondary-action compact-action"
                      Content="Back"
                      Command="{Binding BackToSubsessionsListCommand}"
                      IsVisible="{Binding IsCompactLayout}" />
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
