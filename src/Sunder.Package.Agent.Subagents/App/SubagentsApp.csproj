<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Sunder.Package.Agent.Subagents.App</AssemblyName>
    <SunderPackageFamilyId>sunder.package.agent.subagents</SunderPackageFamilyId>
    <SunderPackageRole>app</SunderPackageRole>
    <SunderPackageProject>true</SunderPackageProject>
    <SunderSdkAvaloniaReference>true</SunderSdkAvaloniaReference>
    <SunderSdkStacksReference>true</SunderSdkStacksReference>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <SunderAgentSharedTranscript>true</SunderAgentSharedTranscript>
    <SunderPackageAssetsDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\Assets'))</SunderPackageAssetsDirectory>
    <DefineConstants>$(DefineConstants);SUNDER_SUBAGENTS_APP</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Controls.ItemsRepeater" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="LiveMarkdown.Avalonia" />
    <ProjectReference Include="..\..\Sunder.Package.Agent.Contracts\Sunder.Package.Agent.Contracts.csproj" />
    <ProjectReference Include="..\Protocol\SubagentsProtocol.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\PackageMetadata.cs" Link="PackageMetadata.cs" />
    <Compile Include="..\Properties\AssemblyInfo.cs" Link="Properties\AssemblyInfo.cs" />
    <Compile Include="..\PackageViews\**\*.cs" Link="PackageViews\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Runtime\SubagentOwnerRpc.cs" Link="Runtime\SubagentOwnerRpc.cs" />
    <Compile Include="..\Runtime\SubagentRuntimeBridge.cs" Link="Runtime\SubagentRuntimeBridge.cs" />
    <Compile Include="..\Services\SubagentConstants.cs" Link="Services\SubagentConstants.cs" />
    <AvaloniaXaml Include="..\PackageViews\**\*.axaml" Link="PackageViews\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <SunderContractBundle Include="..\Protocol\Contracts\subagents-owner.rpc.json"
                          ContractId="sunder.package.agent.subagents.owner"
                            Version="1.0.0"
                          DescriptorPath="contracts/subagents-owner.rpc.json"
                          Exposure="package" />
    <SunderUsesContract Include="sunder.package.agent.subagents.owner"
                        Role="app"
                          ContractVersion="1.0.0"
                        Required="true"
                        Actions="discover;invoke;subscribe" />
  </ItemGroup>

  <Import Project="..\..\Sunder.Package.Agent.Shared\Sunder.Package.Agent.Shared.props" />

</Project>
