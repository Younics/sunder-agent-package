    <SunderPackageRole>protocol</SunderPackageRole>
    <SunderPackageProject>false</SunderPackageProject>
    <AssemblyName>Sunder.Package.Agent.Provider.Gemini.Protocol</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <SunderRpcBinding Include="Contracts\credential-settings.rpc.json"
