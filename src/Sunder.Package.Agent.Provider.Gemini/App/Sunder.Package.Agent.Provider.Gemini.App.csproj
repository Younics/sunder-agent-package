<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <SunderPackageFamilyId>sunder.package.agent.provider.gemini</SunderPackageFamilyId>
    <SunderPackageRole>app</SunderPackageRole>
    <SunderPackageProject>true</SunderPackageProject>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <SunderPackageAssetsDirectory>$(MSBuildProjectDirectory)\..\Assets</SunderPackageAssetsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <ProjectReference Include="..\..\Sunder.Package.Agent.Contracts\Sunder.Package.Agent.Contracts.csproj" />
    <ProjectReference Include="..\Protocol\Sunder.Package.Agent.Provider.Gemini.Protocol.csproj" />
    <Compile Include="..\GeminiModelCatalog.cs" Link="GeminiModelCatalog.cs" />
    <Compile Include="..\GeminiProviderConfiguration.cs" Link="GeminiProviderConfiguration.cs" />
    <Compile Include="..\PackageMetadata.cs" Link="PackageMetadata.cs" />
    <Compile Include="..\Properties\AssemblyInfo.cs" Link="Properties\AssemblyInfo.cs" />
    <Compile Include="..\..\Sunder.Package.Agent.Provider.Shared\ApiKeySettingsState.cs" Link="Provider.Shared\ApiKeySettingsState.cs" />
    <Compile Include="..\..\Sunder.Package.Agent.Provider.Shared\ApiKeyUtilitySettingsState.cs" Link="Provider.Shared\ApiKeyUtilitySettingsState.cs" />
    <Compile Include="..\..\Sunder.Package.Agent.Provider.Shared\ProviderConfigurationSections.cs" Link="Provider.Shared\ProviderConfigurationSections.cs" />
    <Compile Include="..\..\Sunder.Package.Agent.Provider.Shared\ProviderModelCatalog.cs" Link="Provider.Shared\ProviderModelCatalog.cs" />
    <Compile Include="..\..\Sunder.Package.Agent.Provider.Shared\ProviderModelId.cs" Link="Provider.Shared\ProviderModelId.cs" />
    <Compile Include="..\..\Sunder.Package.Agent.Provider.Shared\ProviderUtilityModelSelection.cs" Link="Provider.Shared\ProviderUtilityModelSelection.cs" />
    <Compile Include="..\..\Sunder.Package.Agent.Provider.Shared\UtilityModelSettingsState.cs" Link="Provider.Shared\UtilityModelSettingsState.cs" />
    <Compile Include="..\..\Sunder.Package.Agent.Shared\PackageViews\SunderComboBox.cs" Link="PackageViews\SunderComboBox.cs" />
    <Compile Include="..\..\Sunder.Package.Agent.Shared\Presentation\CapabilitySelectionState.cs" Link="Presentation\CapabilitySelectionState.cs" />
    <Compile Include="..\..\Sunder.Package.Agent.Shared\Presentation\ModelBindingEditorState.cs" Link="Presentation\ModelBindingEditorState.cs" />
    <Compile Include="..\..\Sunder.Package.Agent.Shared\Presentation\OperationState.cs" Link="Presentation\OperationState.cs" />
    <Compile Include="..\..\Sunder.Package.Agent.Shared\Presentation\PresentationDispatcher.cs" Link="Presentation\PresentationDispatcher.cs" />
    <Compile Include="..\..\Sunder.Package.Agent.Shared\Presentation\PresentationExceptionPolicy.cs" Link="Presentation\PresentationExceptionPolicy.cs" />
    <Compile Include="..\..\Sunder.Package.Agent.Shared\Presentation\PresentationTaskScope.cs" Link="Presentation\PresentationTaskScope.cs" />
    <Compile Include="..\..\Sunder.Package.Agent.Shared\Presentation\ProviderModelLoader.cs" Link="Presentation\ProviderModelLoader.cs" />
    <Compile Include="..\..\Sunder.Package.Agent.Shared\Presentation\TimedStatusController.cs" Link="Presentation\TimedStatusController.cs" />
    <AvaloniaResource Include="..\..\Sunder.Package.Agent.Shared\Presentation\PresentationStyles.axaml" Link="Presentation\PresentationStyles.axaml" />
    <AvaloniaResource Include="..\..\Sunder.Package.Agent.Provider.Shared\ProviderSettingsStyles.axaml" Link="Provider.Shared\ProviderSettingsStyles.axaml" />
  </ItemGroup>

  <ItemGroup>
    <SunderContractBundle Include="..\Protocol\Contracts\credential-settings.rpc.json"
                          ContractId="sunder.package.agent.provider.gemini.credentials"
                            Version="1.0.0"
                          DescriptorPath="contracts/credential-settings.rpc.json"
                          Exposure="package" />
    <SunderUsesContract Include="sunder.package.agent.provider.gemini.credentials"
                        Role="app"
                          ContractVersion="1.0.0"
                        Required="true"
                        Actions="discover;invoke" />
  </ItemGroup>

</Project>
