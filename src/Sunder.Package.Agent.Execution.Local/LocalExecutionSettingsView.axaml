<UserControl xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vm="using:Sunder.Package.Agent.Execution.Local"
              xmlns:shared="using:Sunder.Package.Agent.Shared.PackageViews"
              x:Class="Sunder.Package.Agent.Execution.Local.LocalExecutionSettingsView"
              x:DataType="vm:LocalExecutionSettingsViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="16">
      <StackPanel Spacing="6">
        <TextBlock Text="Local Execution Shells"
                   FontSize="24"
                   FontWeight="SemiBold" />
        <TextBlock Text="Manage shells available to local workspaces. Add a shell when you need a non-standard executable."
                   TextWrapping="Wrap" />
      </StackPanel>

      <Border Padding="14"
              IsVisible="{Binding IsLoading}">
        <TextBlock Text="Loading local execution settings..."
                   TextWrapping="Wrap" />
      </Border>

      <Border Padding="14"
              IsVisible="{Binding IsError}">
        <StackPanel Spacing="8">
          <TextBlock Text="Local execution settings could not be loaded."
                     FontWeight="SemiBold" />
          <TextBlock Text="{Binding StatusText}"
                     TextWrapping="Wrap" />
          <Button Content="Retry"
                  HorizontalAlignment="Left"
                  Command="{Binding RetryInitializationCommand}" />
        </StackPanel>
      </Border>

      <Border Padding="14"
              IsVisible="{Binding IsReady}"
              IsEnabled="{Binding CanMutate}">
        <StackPanel Spacing="8">
          <TextBlock Text="Detected Shells"
                     FontWeight="SemiBold" />
          <TextBlock Text="Detected shells are read-only and refreshed from this host."
                     TextWrapping="Wrap" />
          <ListBox ItemsSource="{Binding DetectedShells}"
                   SelectedItem="{Binding SelectedShell, Mode=TwoWay}"
                   MinHeight="80">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:LocalShellRowViewModel">
                <Grid ColumnDefinitions="2*,3*,Auto"
                      ColumnSpacing="10"
                      Margin="0,4">
                  <TextBlock Text="{Binding DisplayName}" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding ExecutablePath}"
                             TextWrapping="Wrap" />
                  <TextBlock Grid.Column="2"
                             Text="{Binding SelectedSyntax.DisplayName}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="Custom Shells"
                     FontWeight="SemiBold"
                     Margin="0,8,0,0" />
          <Button Content="Add Shell"
                   HorizontalAlignment="Left"
                   Command="{Binding AddShellCommand}" />
          <Grid ColumnDefinitions="2*,3*,Auto,Auto"
                ColumnSpacing="10"
                Margin="0,4,0,0">
            <TextBlock Text="Name"
                       FontWeight="SemiBold" />
            <TextBlock Grid.Column="1"
                       Text="Executable Path"
                       FontWeight="SemiBold" />
             <TextBlock Grid.Column="2"
                        Text="Syntax"
                        FontWeight="SemiBold" />
            <TextBlock Grid.Column="3"
                       Text="Path"
                       FontWeight="SemiBold" />
          </Grid>
          <ListBox ItemsSource="{Binding CustomShells}"
                   SelectedItem="{Binding SelectedShell, Mode=TwoWay}"
                   MinHeight="160">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:LocalShellRowViewModel">
                <Grid ColumnDefinitions="2*,3*,Auto,Auto"
                      ColumnSpacing="10"
                      Margin="0,4">
                  <TextBox Text="{Binding DisplayName, Mode=TwoWay}"
                           IsReadOnly="{Binding IsDetected}"
                           PlaceholderText="Display name" />
                   <TextBox Grid.Column="1"
                            Text="{Binding ExecutablePath}"
                            IsReadOnly="True"
                            PlaceholderText="Executable path" />
                  <shared:SunderComboBox Grid.Column="2"
                                         ItemsSource="{Binding SyntaxOptions}"
                                         IsEnabled="{Binding CanEdit}"
                                         SelectedItem="{Binding SelectedSyntax, Mode=TwoWay}">
                    <shared:SunderComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ShellSyntaxOption">
                        <TextBlock Text="{Binding DisplayName}" />
                      </DataTemplate>
                    </shared:SunderComboBox.ItemTemplate>
                   </shared:SunderComboBox>
                  <Button Grid.Column="3"
                          Content="Choose..."
                          IsVisible="{Binding CanEdit}"
                          Click="OnChooseShellExecutableClicked" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Orientation="Horizontal"
                      Spacing="8">
            <Button Content="Delete Selected"
                    Command="{Binding DeleteSelectedShellCommand}" />
            <Button Content="Save Shells"
                    Command="{Binding SaveShellsCommand}" />
          </StackPanel>
          <TextBlock Text="{Binding StatusText}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Padding="14"
              IsVisible="{Binding IsReady}"
              IsEnabled="{Binding CanMutate}">
        <StackPanel Spacing="8">
          <TextBlock Text="Execution"
                     FontWeight="SemiBold" />
          <TextBlock Text="Default timeout in seconds for local shell commands when a request does not specify one."
                     TextWrapping="Wrap" />
          <TextBox Text="{Binding TimeoutSeconds, Mode=TwoWay}"
                   PlaceholderText="300" />
          <Button Content="Save Execution Settings"
                  HorizontalAlignment="Left"
                  Command="{Binding SaveExecutionSettingsCommand}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
