<UserControl xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vm="using:Sunder.Package.Agent.Execution.Local"
              xmlns:p="using:Sunder.Package.Agent.Shared.Presentation"
              xmlns:shared="using:Sunder.Package.Agent.Shared.PackageViews"
              x:Class="Sunder.Package.Agent.Execution.Local.LocalExecutionSettingsView"
              x:DataType="vm:LocalExecutionSettingsViewModel" Classes="agent-page">
  <UserControl.Styles><StyleInclude Source="/Presentation/PresentationStyles.axaml" /></UserControl.Styles>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="{DynamicResource Sunder.Spacing.Large}" Margin="{DynamicResource Sunder.Padding.Panel}">
      <StackPanel Spacing="6">
        <p:SectionHeader Title="Local execution" IsPageTitle="True" HelpText="Detected shells come from this host. Add a custom executable when it is not detected automatically, then select the shell in a workspace." />
      </StackPanel>

      <Border Padding="14"
              IsVisible="{Binding IsLoading}">
        <TextBlock Text="Loading local execution settings..."
                   TextWrapping="Wrap" />
      </Border>

      <Border Padding="14"
              IsVisible="{Binding IsError}">
        <StackPanel Spacing="8">
          <TextBlock Text="Local execution settings could not be loaded."
                     FontWeight="SemiBold" />
          <TextBlock Text="{Binding StatusText}"
                     TextWrapping="Wrap" />
          <Button Content="Retry" Classes="secondary-action"
                  HorizontalAlignment="Left"
                  Command="{Binding RetryInitializationCommand}" />
        </StackPanel>
      </Border>

        <Border Classes="card-surface" IsVisible="{Binding IsReady}" IsEnabled="{Binding CanMutate}">
        <StackPanel Spacing="{DynamicResource Sunder.Spacing.Medium}">
          <p:SectionHeader Title="Detected shells" HelpText="Detected shells are read-only and refreshed from this host." />
          <ListBox ItemsSource="{Binding DetectedShells}"
                   SelectedItem="{Binding SelectedShell, Mode=TwoWay}"
                   MinHeight="80">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:LocalShellRowViewModel">
                <p:ResponsiveGrid ColumnDefinitions="2*,3*,Auto"
                      ColumnSpacing="10"
                      Margin="0,4">
                  <TextBlock Text="{Binding DisplayName}" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding ExecutablePath}"
                             TextWrapping="Wrap" />
                  <TextBlock Grid.Column="2"
                             Text="{Binding SelectedSyntax.DisplayName}" />
                </p:ResponsiveGrid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <p:SectionHeader Title="Custom shells" HelpText="Add a shell executable, choose its syntax, then save. Detected shells above cannot be edited." />
          <Button Content="Add shell" Classes="secondary-action"
                   HorizontalAlignment="Left"
                   Command="{Binding AddShellCommand}" />
          <ListBox ItemsSource="{Binding CustomShells}"
                   SelectedItem="{Binding SelectedShell, Mode=TwoWay}"
                   MinHeight="160">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:LocalShellRowViewModel">
                <p:ResponsiveGrid ColumnDefinitions="2*,3*,Auto,Auto"
                       ColumnSpacing="10"
                       RowSpacing="{DynamicResource Sunder.Spacing.Small}"
                      Margin="0,4">
                  <TextBox Text="{Binding DisplayName, Mode=TwoWay}"
                           IsReadOnly="{Binding IsDetected}"
                           PlaceholderText="Name" AutomationProperties.Name="Shell name" />
                   <TextBox Grid.Column="1"
                            Text="{Binding ExecutablePath}"
                            IsReadOnly="True"
                            PlaceholderText="Executable path" AutomationProperties.Name="Shell executable" />
                  <shared:SunderComboBox Grid.Column="2"
                                         ItemsSource="{Binding SyntaxOptions}"
                                         IsEnabled="{Binding CanEdit}"
                                         SelectedItem="{Binding SelectedSyntax, Mode=TwoWay}" AutomationProperties.Name="Shell syntax">
                    <shared:SunderComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ShellSyntaxOption">
                        <TextBlock Text="{Binding DisplayName}" />
                      </DataTemplate>
                    </shared:SunderComboBox.ItemTemplate>
                   </shared:SunderComboBox>
                  <Button Grid.Column="3"
                           Content="Choose…" Classes="secondary-action"
                          IsVisible="{Binding CanEdit}"
                          Click="OnChooseShellExecutableClicked" />
                </p:ResponsiveGrid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <WrapPanel ItemSpacing="{DynamicResource Sunder.Spacing.Small}" LineSpacing="{DynamicResource Sunder.Spacing.Small}">
            <Button Content="Delete" Classes="secondary-action danger-action"
                    Command="{Binding DeleteSelectedShellCommand}" />
            <Button Content="Save shells" Classes="primary-action"
                    Command="{Binding SaveShellsCommand}" />
          </WrapPanel>
          <TextBlock Text="{Binding StatusText}"
                     TextWrapping="Wrap" />
        </StackPanel>
        </Border>

        <Border Classes="card-surface" IsVisible="{Binding IsReady}" IsEnabled="{Binding CanMutate}">
        <StackPanel Spacing="{DynamicResource Sunder.Spacing.Medium}">
          <p:SectionHeader Title="Timeout (seconds)" HelpText="Default timeout for local shell commands when a request does not specify a limit." />
          <TextBox Text="{Binding TimeoutSeconds, Mode=TwoWay}"
                   PlaceholderText="300" />
          <Button Content="Save" Classes="primary-action"
                  HorizontalAlignment="Left"
                  Command="{Binding SaveExecutionSettingsCommand}" />
        </StackPanel>
        </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
