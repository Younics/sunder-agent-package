{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "descriptorVersion": 2,
  "schemaProfile": "sunder.rpc.values.v1",
  "contractId": "sunder.package.agent.execution.local.presentation",
  "version": "1.0.0",
  "errors": {},
  "services": {
    "presentation": {
      "methods": {
        "execute": {
          "kind": "unary",
          "idempotency": "none",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/LocalExecutionOperationRequest"
          },
          "responseSchema": {
            "$ref": "#/$defs/LocalExecutionOperationResponse"
          }
        }
      }
    }
  },
  "$defs": {
    "LocalOperation": {
      "type": "string",
      "enum": [
        "get-settings",
        "save-settings",
        "save-shells"
      ]
    },
    "TimeoutText": {
      "type": "string"
    },
    "ShellId": {
      "type": "string",
      "minLength": 1
    },
    "DisplayName": {
      "type": "string"
    },
    "ExecutablePath": {
      "type": "string"
    },
    "ShellSyntax": {
      "type": "string",
      "minLength": 1
    },
    "OperationMessage": {
      "type": "string",
      "minLength": 1
    },
    "DiagnosticCode": {
      "type": "string",
      "minLength": 1
    },
    "CatalogRevision": {
      "type": "integer",
      "minimum": 0
    },
    "LocalShellDefinition": {
      "type": "object",
      "properties": {
        "shellId": {
          "$ref": "#/$defs/ShellId"
        },
        "displayName": {
          "$ref": "#/$defs/DisplayName"
        },
        "executablePath": {
          "$ref": "#/$defs/ExecutablePath"
        },
        "syntaxKind": {
          "$ref": "#/$defs/ShellSyntax"
        },
        "isDetected": {
          "type": "boolean"
        }
      },
      "required": [
        "shellId",
        "displayName",
        "executablePath",
        "syntaxKind",
        "isDetected"
      ],
      "additionalProperties": false
    },
    "ShellCatalog": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/LocalShellDefinition"
      }
    },
    "LocalExecutionOperationError": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/DiagnosticCode"
        },
        "message": {
          "$ref": "#/$defs/OperationMessage"
        },
        "isTransient": {
          "type": "boolean"
        },
        "correlationId": {
          "$ref": "#/$defs/DiagnosticCode"
        }
      },
      "required": [
        "code",
        "message",
        "isTransient"
      ],
      "additionalProperties": false
    },
    "LocalExecutionOperationRequest": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/LocalOperation"
        },
        "timeoutSeconds": {
          "$ref": "#/$defs/TimeoutText"
        },
        "shells": {
          "$ref": "#/$defs/ShellCatalog"
        },
        "expectedShellCatalogRevision": {
          "$ref": "#/$defs/CatalogRevision"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "LocalExecutionOperationResponse": {
      "type": "object",
      "properties": {
        "timeoutSeconds": {
          "$ref": "#/$defs/TimeoutText"
        },
        "detectedShells": {
          "$ref": "#/$defs/ShellCatalog"
        },
        "customShells": {
          "$ref": "#/$defs/ShellCatalog"
        },
        "shellCatalogRevision": {
          "$ref": "#/$defs/CatalogRevision"
        },
        "message": {
          "$ref": "#/$defs/OperationMessage"
        },
        "success": {
          "type": "boolean"
        },
        "error": {
          "$ref": "#/$defs/LocalExecutionOperationError"
        }
      },
      "required": [
        "success"
      ],
      "additionalProperties": false
    }
  }
}
