{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "descriptorVersion": 2,
  "contractId": "sunder.package.agent.execution.local.presentation",
  "version": "2.0.0",
  "errors": {},
  "services": {
    "presentation": {
      "methods": {
        "execute": {
          "kind": "unary",
          "idempotency": "none",
          "errors": [],
          "requestSchema": {
            "$ref": "#/$defs/LocalExecutionOperationRequest"
          },
          "responseSchema": {
            "$ref": "#/$defs/LocalExecutionOperationResponse"
          }
        }
      }
    }
  },
  "$defs": {
    "OperationKind": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2,
      "enum": [0, 1, 2]
    },
    "Timeout": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16
    },
    "ShellId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "DisplayName": {
      "type": "string",
      "minLength": 0,
      "maxLength": 256
    },
    "Path": {
      "type": "string",
      "minLength": 0,
      "maxLength": 1024
    },
    "SyntaxKind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "Message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "Token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "Revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "LocalShellDefinition": {
      "type": "object",
      "properties": {
        "shellId": { "$ref": "#/$defs/ShellId" },
        "displayName": { "$ref": "#/$defs/DisplayName" },
        "executablePath": { "$ref": "#/$defs/Path" },
        "syntaxKind": { "$ref": "#/$defs/SyntaxKind" },
        "isDetected": { "type": "boolean" }
      },
      "required": ["shellId", "displayName", "executablePath", "syntaxKind", "isDetected"],
      "additionalProperties": false
    },
    "ShellList": {
      "type": "array",
      "items": { "$ref": "#/$defs/LocalShellDefinition" },
      "minItems": 0,
      "maxItems": 32
    },
    "LocalExecutionOperationError": {
      "type": "object",
      "properties": {
        "code": { "$ref": "#/$defs/Token" },
        "message": { "$ref": "#/$defs/Message" },
        "isTransient": { "type": "boolean" },
        "correlationId": { "$ref": "#/$defs/Token" }
      },
      "required": ["code", "message", "isTransient"],
      "additionalProperties": false
    },
    "LocalExecutionOperationRequest": {
      "type": "object",
      "properties": {
        "kind": { "$ref": "#/$defs/OperationKind" },
        "timeoutSeconds": { "$ref": "#/$defs/Timeout" },
        "shells": { "$ref": "#/$defs/ShellList" },
        "expectedShellCatalogRevision": { "$ref": "#/$defs/Revision" }
      },
      "required": ["kind"],
      "additionalProperties": false
    },
    "LocalExecutionOperationResponse": {
      "type": "object",
      "properties": {
        "timeoutSeconds": { "$ref": "#/$defs/Timeout" },
        "detectedShells": { "$ref": "#/$defs/ShellList" },
        "customShells": { "$ref": "#/$defs/ShellList" },
        "shellCatalogRevision": { "$ref": "#/$defs/Revision" },
        "message": { "$ref": "#/$defs/Message" },
        "success": { "type": "boolean" },
        "error": { "$ref": "#/$defs/LocalExecutionOperationError" }
      },
      "required": ["success"],
      "additionalProperties": false
    }
  }
}
