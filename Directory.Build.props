<Project>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <!-- Restore must see test analyzer references before NuGet's test props exist. -->
        <IsTestProject Condition="$(MSBuildProjectName.EndsWith('.Tests'))">true</IsTestProject>
        <LangVersion>14.0</LangVersion>
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' or '$(GITHUB_ACTIONS)' == 'true' or '$(CIRCLECI)' == 'true'">true</ContinuousIntegrationBuild>
        <!-- Release provenance records the commit. Lock-only commits must not
             change unchanged package payloads or their selected API identities. -->
        <IncludeSourceRevisionInInformationalVersion Condition="'$(ContinuousIntegrationBuild)' == 'true'">false</IncludeSourceRevisionInInformationalVersion>
        <EnableSourceLink Condition="'$(ContinuousIntegrationBuild)' == 'true'">false</EnableSourceLink>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisLevel>latest</AnalysisLevel>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <VersionPrefix>2.0.0</VersionPrefix>
        <!-- Canonical packages author Version in their own project. This is the
             default for support/test projects, not a family release version. -->
        <Version>$(VersionPrefix)</Version>
        <Authors>Younics</Authors>
        <Company>Younics</Company>
        <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
        <PackageTags>sunder;agent;ai</PackageTags>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/Younics/sunder-agent-package</RepositoryUrl>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <NuGetLockFilePath>$(MSBuildProjectDirectory)/packages.release.lock.json</NuGetLockFilePath>
        <RestoreLockedMode Condition="'$(CI)' == 'true' or '$(GITHUB_ACTIONS)' == 'true' or '$(CIRCLECI)' == 'true'">true</RestoreLockedMode>
    </PropertyGroup>
</Project>
