<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SunderSdkReference>true</SunderSdkReference>
    <SunderTestOwner>younics.ai.agent.subagents</SunderTestOwner>
    <SunderTestCategory>Component</SunderTestCategory>
    <SunderTestCapabilities>Filesystem;Worker</SunderTestCapabilities>
    <SunderTestOS>Any</SunderTestOS>
    <SunderTestSize>Medium</SunderTestSize>
    <SunderTestSourceMode>true</SunderTestSourceMode>
    <SunderTestPackageMode>true</SunderTestPackageMode>
    <SunderTestLanes>PackageCompatibility</SunderTestLanes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sunder.Package.Agent.Subagents\Sunder.Package.Agent.Subagents.csproj"
                      Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=worker" Aliases="global,SubagentsWorker" />
    <ProjectReference Include="..\Sunder.Package.Agent.TestSupport\Sunder.Package.Agent.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Sunder.Package.Agent.Tests\AgentPackageRepositoryInventory.cs"
             Link="TestSupport\AgentPackageRepositoryInventory.cs" />
    <Compile Include="..\Sunder.Package.Agent.Tests\TestPackageStorageFakes.cs"
             Link="TestSupport\TestPackageStorageFakes.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
