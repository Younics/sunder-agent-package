<Project>
  <!-- Descriptor-only helpers also serve suites without an Agent binary reference. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Sunder.Package.Agent.Tests/RegressionTestRpcDescriptors.cs;
                      $(MSBuildThisFileDirectory)Sunder.Package.Agent.Tests/CurrentContractInventory.cs;
                      $(MSBuildThisFileDirectory)Sunder.Package.Agent.Tests/CurrentContractRecords.cs"
             Link="TestSupport/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
