<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SunderSdkReference>true</SunderSdkReference>
    <SunderTestOwner>younics.ai.agent.memory.semantic</SunderTestOwner>
    <SunderTestCategory>Component</SunderTestCategory>
    <SunderTestCapabilities>Filesystem;SQLite;Worker</SunderTestCapabilities>
    <SunderTestOS>Any</SunderTestOS>
    <SunderTestSize>Medium</SunderTestSize>
    <SunderTestSourceMode>true</SunderTestSourceMode>
    <SunderTestPackageMode>true</SunderTestPackageMode>
    <SunderTestLanes>PackageCompatibility</SunderTestLanes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sunder.Package.Agent\Sunder.Package.Agent.csproj"
                      Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=worker" Aliases="global,AgentWorker" />
    <ProjectReference Include="..\..\src\Sunder.Package.Agent.Memory.Semantic\Sunder.Package.Agent.Memory.Semantic.csproj"
                      Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=worker" Aliases="MemoryWorker" />
    <ProjectReference Include="..\..\src\Sunder.Package.Agent.Memory.Semantic\Sunder.Package.Agent.Memory.Semantic.csproj"
                      Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=app" Aliases="MemoryApp" />
    <ProjectReference Include="..\Sunder.Package.Agent.TestSupport\Sunder.Package.Agent.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Sunder.Package.Agent.Tests\MemoryLocalStorePersistenceTests.cs" Link="MemoryLocalStorePersistenceTests.cs" />
    <Compile Include="..\Sunder.Package.Agent.Tests\AgentPackageRepositoryInventory.cs" Link="AgentPackageRepositoryInventory.cs" />
    <Compile Include="..\Sunder.Package.Agent.Tests\RegressionTestPackageContext.cs" Link="RegressionTestPackageContext.cs" />
    <Compile Include="..\Sunder.Package.Agent.Tests\RegressionTestPackageScope.cs" Link="RegressionTestPackageScope.cs" />
    <Compile Include="..\Sunder.Package.Agent.Tests\RegressionTestFamilyConsumers.Memory.cs" Link="RegressionTestFamilyConsumers.Memory.cs" />
    <Compile Include="..\Sunder.Package.Agent.Tests\SemanticMemoryIndexingReliabilityTests.cs" Link="SemanticMemoryIndexingReliabilityTests.cs" />
    <Compile Include="..\Sunder.Package.Agent.Tests\TestPackageStorageFakes.cs" Link="TestPackageStorageFakes.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <Import Project="../RegressionTestHarness.props" />
</Project>
