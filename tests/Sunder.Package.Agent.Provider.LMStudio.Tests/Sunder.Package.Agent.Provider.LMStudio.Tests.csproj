<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SunderTestOwner>sunder.package.agent.provider.lmstudio</SunderTestOwner>
    <SunderTestCategory>Conformance</SunderTestCategory>
    <SunderTestCapabilities>HTTP;Worker</SunderTestCapabilities>
    <SunderTestOS>Any</SunderTestOS>
    <SunderTestSize>Medium</SunderTestSize>
    <SunderTestSourceMode>true</SunderTestSourceMode>
    <SunderTestPackageMode>true</SunderTestPackageMode>
    <SunderTestLanes>PackageCompatibility</SunderTestLanes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sunder.Package.Agent.Provider.LMStudio\Sunder.Package.Agent.Provider.LMStudio.csproj"
                      Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=worker" Aliases="global,LMStudioWorker" />
    <ProjectReference Include="..\..\src\Sunder.Package.Agent.Provider.LMStudio\Sunder.Package.Agent.Provider.LMStudio.csproj"
                      Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=app" Aliases="LMStudioApp" />
    <ProjectReference Include="..\Sunder.Package.Agent.Provider.TestSupport\Sunder.Package.Agent.Provider.TestSupport.csproj" />
    <ProjectReference Include="..\Sunder.Package.Agent.TestSupport\Sunder.Package.Agent.TestSupport.csproj" />
    <ProjectReference Include="..\Sunder.Package.Agent.TestSupport.Avalonia\Sunder.Package.Agent.TestSupport.Avalonia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
