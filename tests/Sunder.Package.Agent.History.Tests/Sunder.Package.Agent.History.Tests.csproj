<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SunderSdkReference>true</SunderSdkReference>
    <SunderSdkAvaloniaReference>true</SunderSdkAvaloniaReference>
    <SunderTestOwner>younics.ai.agent</SunderTestOwner>
    <SunderTestCategory>Component</SunderTestCategory>
    <SunderTestCapabilities>Filesystem;SQLite;Worker</SunderTestCapabilities>
    <SunderTestOS>Any</SunderTestOS>
    <SunderTestSize>Large</SunderTestSize>
    <SunderTestSourceMode>true</SunderTestSourceMode>
    <SunderTestPackageMode>true</SunderTestPackageMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Sunder.Package.Agent/Sunder.Package.Agent.csproj"
                      Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=worker" Aliases="global,AgentWorker" />
    <ProjectReference Include="../../src/Sunder.Package.Agent/Sunder.Package.Agent.csproj"
                      Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=app" Aliases="AgentCore,AgentApp" />
    <ProjectReference Include="../../src/Sunder.Package.Agent.Subagents/Sunder.Package.Agent.Subagents.csproj"
                      Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=worker" Aliases="SubagentsWorker" />
    <ProjectReference Include="../Sunder.Package.Agent.TestSupport/Sunder.Package.Agent.TestSupport.csproj" />
    <Compile Include="../Shared/Presentation/RegressionTestRuntime.cs;../Shared/Consumers/RegressionTestFamilyConsumers.Subagents.cs"
             Link="TestSupport/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <Import Project="../RegressionTestHarness.props" />
  <Import Project="../PackageContextFixtures.props" />
</Project>
