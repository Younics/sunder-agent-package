<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SunderPackageFamilyId>younics.ai.agent</SunderPackageFamilyId>
    <SunderPackageRole>test</SunderPackageRole>
    <SunderSdkAvaloniaReference>true</SunderSdkAvaloniaReference>
    <OutputType>Exe</OutputType>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <SunderTestOwner>agent-family</SunderTestOwner>
    <SunderTestCategory>UI</SunderTestCategory>
    <SunderTestCapabilities>AvaloniaHeadless;Filesystem;Worker</SunderTestCapabilities>
    <SunderTestOS>Any</SunderTestOS>
    <SunderTestSize>Large</SunderTestSize>
    <SunderTestSourceMode>true</SunderTestSourceMode>
    <SunderTestPackageMode>true</SunderTestPackageMode>
    <SunderTestSourceOnlyTests>Sunder.Package.Agent.Presentation.Tests.CrossRepositoryCandidatePreparationTests.SelectedAgentChat_RecoversWhenCandidateOwnerProviderBecomesLeaseReady</SunderTestSourceOnlyTests>
    <SunderTestSourceOnlyTests>$(SunderTestSourceOnlyTests);Sunder.Package.Agent.Presentation.Tests.BuilderJobCompositionTests.RealQueueCancellationWhileWaitingForBuilderGateReturnsConfirmedNoDispatch;Sunder.Package.Agent.Presentation.Tests.BuilderJobCompositionTests.FailedJobThenQueuedSuccessorSettlesWithItsOwnJournalAndDispatcherAuthority</SunderTestSourceOnlyTests>
    <SunderTestSourceOnlyTests>$(SunderTestSourceOnlyTests);Sunder.Package.Agent.Presentation.Tests.GeneratedSettingsLayoutTests.RealPackageSchemasUseSpacedSectionsInlineHelpAndEdgeToEdgeScrollingWithoutReplacingDrafts;Sunder.Package.Agent.Presentation.Tests.SettingsLayoutTests.HostedSettingsKeepGuttersInsideScrollingContentAtEveryPaneWidth;Sunder.Package.Agent.Presentation.Tests.ProviderSettingsRenderedTests.ProviderSettings_ResizeWithoutOverflowOrReplacingCredentialDraft</SunderTestSourceOnlyTests>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Controls.ItemsRepeater" />
    <PackageReference Include="AvaloniaEdit.TextMate" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="LiveMarkdown.Avalonia" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sunder.Package.Agent\Sunder.Package.Agent.csproj"
                      Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=worker" Aliases="global,AgentWorker" />
    <ProjectReference Include="..\..\src\Sunder.Package.Agent\Sunder.Package.Agent.csproj"
                      Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=app" Aliases="AgentApp" />
    <ProjectReference Include="..\..\src\Sunder.Package.Agent.Builder\Sunder.Package.Agent.Builder.csproj"
                      Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=worker" Aliases="BuilderWorker" />
    <ProjectReference Include="..\..\src\Sunder.Package.Agent.Builder\Sunder.Package.Agent.Builder.csproj"
                      Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=app" Aliases="BuilderApp" />
    <ProjectReference Include="..\..\src\Sunder.Package.Agent.Execution.Docker\Sunder.Package.Agent.Execution.Docker.csproj"
                      Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=worker" Aliases="DockerWorker" />
    <ProjectReference Include="..\..\src\Sunder.Package.Agent.Execution.Docker\Sunder.Package.Agent.Execution.Docker.csproj"
                      Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=app" Aliases="DockerApp" />
    <ProjectReference Include="..\..\src\Sunder.Package.Agent.Execution.Local\Sunder.Package.Agent.Execution.Local.csproj"
                      Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=worker" Aliases="LocalWorker" />
    <ProjectReference Include="..\..\src\Sunder.Package.Agent.Execution.Local\Sunder.Package.Agent.Execution.Local.csproj"
                      Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=app" Aliases="LocalApp" />
    <ProjectReference Include="..\..\src\Sunder.Package.Agent.Mcp\Sunder.Package.Agent.Mcp.csproj"
                      Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=worker" Aliases="McpWorker" />
    <ProjectReference Include="..\..\src\Sunder.Package.Agent.Mcp\Sunder.Package.Agent.Mcp.csproj"
                      Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=app" Aliases="McpApp" />
    <ProjectReference Include="..\..\src\Sunder.Package.Agent.Memory.Semantic\Sunder.Package.Agent.Memory.Semantic.csproj"
                      Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=worker" Aliases="MemoryWorker" />
    <ProjectReference Include="..\..\src\Sunder.Package.Agent.Memory.Semantic\Sunder.Package.Agent.Memory.Semantic.csproj"
                      Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=app" Aliases="MemoryApp" />
    <ProjectReference Include="..\..\src\Sunder.Package.Agent.Provider.Anthropic\Sunder.Package.Agent.Provider.Anthropic.csproj"
                      Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=worker" Aliases="AnthropicWorker" />
    <ProjectReference Include="..\..\src\Sunder.Package.Agent.Provider.Anthropic\Sunder.Package.Agent.Provider.Anthropic.csproj"
                      Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=app" Aliases="AnthropicApp" />
    <ProjectReference Include="..\..\src\Sunder.Package.Agent.Provider.Gemini\Sunder.Package.Agent.Provider.Gemini.csproj"
                      Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=worker" Aliases="GeminiWorker" />
    <ProjectReference Include="..\..\src\Sunder.Package.Agent.Provider.Gemini\Sunder.Package.Agent.Provider.Gemini.csproj"
                      Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=app" Aliases="GeminiApp" />
    <ProjectReference Include="..\..\src\Sunder.Package.Agent.Provider.LMStudio\Sunder.Package.Agent.Provider.LMStudio.csproj"
                      Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=worker" Aliases="LMStudioWorker" />
    <ProjectReference Include="..\..\src\Sunder.Package.Agent.Provider.LMStudio\Sunder.Package.Agent.Provider.LMStudio.csproj"
                      Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=app" Aliases="LMStudioApp" />
    <ProjectReference Include="..\..\src\Sunder.Package.Agent.Provider.OpenAI\Sunder.Package.Agent.Provider.OpenAI.csproj"
                      Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=worker" Aliases="OpenAiWorker" />
    <ProjectReference Include="..\..\src\Sunder.Package.Agent.Provider.OpenAI\Sunder.Package.Agent.Provider.OpenAI.csproj"
                      Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=app" Aliases="OpenAiApp" />
    <ProjectReference Include="..\..\src\Sunder.Package.Agent.Skills\Sunder.Package.Agent.Skills.csproj"
                      Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=worker" Aliases="SkillsWorker" />
    <ProjectReference Include="..\..\src\Sunder.Package.Agent.Skills\Sunder.Package.Agent.Skills.csproj"
                      Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=app" Aliases="SkillsApp" />
    <ProjectReference Include="..\..\src\Sunder.Package.Agent.Subagents\Sunder.Package.Agent.Subagents.csproj"
                      Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=worker" Aliases="SubagentsWorker" />
    <ProjectReference Include="..\..\src\Sunder.Package.Agent.Subagents\Sunder.Package.Agent.Subagents.csproj"
                      Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=app" Aliases="SubagentsApp" />
    <ProjectReference Include="..\Sunder.Package.Agent.TestSupport\Sunder.Package.Agent.TestSupport.csproj" />
    <ProjectReference Include="..\Sunder.Package.Agent.TestSupport.Avalonia\Sunder.Package.Agent.TestSupport.Avalonia.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(SunderPublishedAppDirectory)' != ''">
    <Reference Include="$(SunderPublishedAppDirectory)/Sunder.*.dll"
               Exclude="$(SunderPublishedAppDirectory)/Sunder.Sdk*.dll" />
    <Reference Include="$(SunderPublishedAppDirectory)/Avalonia.Controls.WebView.dll" />
    <Reference Include="$(SunderPublishedAppDirectory)/Velopack.dll" />
  </ItemGroup>
  <ItemGroup Condition="'$(SunderPublishedAppDirectory)' == ''">
    <!-- Keep Agent-only headless development independent of the desktop install.
         The shared CI lane requires the published App tests. -->
    <Compile Remove="CrossRepositoryCandidatePreparationTests.cs" />
    <Compile Remove="BuilderJobCompositionTests.cs;GeneratedSettingsLayoutTests.cs" />
    <Compile Remove="HostedSettingsWindow.cs;SettingsLayoutTests.Hosted.cs;ProviderSettingsRenderedTests.Hosted.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Sunder.Package.Agent.Tools.Web\WebToolsConfiguration.cs" Link="TestSupport\WebToolsConfiguration.cs" />
    <Compile Include="../Shared/Rendered/*.cs;../Shared/Presentation/*.cs;../Shared/Consumers/*.cs"
             Exclude="../Shared/Consumers/SubagentsWorkerAliases.cs" Link="TestSupport/%(Filename)%(Extension)" />
  </ItemGroup>
  <Import Project="../RegressionTestHarness.props" />
  <Import Project="../PackageContextFixtures.props" />
  <Target Name="RequirePublishedAppForHostedTests" BeforeTargets="ResolveReferences">
    <Error Condition="'$(SunderRequirePublishedApp)' == 'true' and ('$(SunderPublishedAppDirectory)' == '' or !Exists('$(SunderPublishedAppDirectory)/Sunder.App.dll'))"
           Text="Prepare the published App distribution to run the hosted Agent tests." />
  </Target>
</Project>
