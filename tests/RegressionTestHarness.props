<Project>
  <Import Project="CurrentContractFixtures.props" />
  <!-- Shared RPC helpers use these APIs directly. Role assembly references are
       assembly-only, so their canonical projects cannot supply transitive inputs. -->
  <PropertyGroup>
    <SunderSdkWorkerReference>true</SunderSdkWorkerReference>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
  </ItemGroup>
  <!-- Role-specific assertions compile against each suite's generated type identities
       and xUnit version. Framework-neutral helpers belong in TestSupport instead. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Shared/Rpc/**/*.cs"
             Link="TestSupport/Rpc/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
