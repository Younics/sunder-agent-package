<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SunderSdkAvaloniaReference>true</SunderSdkAvaloniaReference>
    <SunderSdkReference>true</SunderSdkReference>
    <SunderSdkStacksReference>true</SunderSdkStacksReference>
    <SunderBuildToolingReference>true</SunderBuildToolingReference>
    <SunderTestOwner>agent-family</SunderTestOwner>
    <SunderTestCategory>Conformance</SunderTestCategory>
    <SunderTestCapabilities>Filesystem;HTTP;PackageArchive;Process;SQLite;Worker</SunderTestCapabilities>
    <SunderTestOS>Any</SunderTestOS>
    <SunderTestSize>Large</SunderTestSize>
    <SunderTestSourceMode>true</SunderTestSourceMode>
    <SunderTestPackageMode>false</SunderTestPackageMode>
  </PropertyGroup>
  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../Shared/Repository/*.cs;../Shared/Canonical/*.cs;../Shared/Composition/*.cs;../Shared/Presentation/*.cs;../Shared/Consumers/*.cs;../Shared/Platform/*.cs;../Shared/Execution/GeneratedToolSourceProbe.cs;../Shared/Execution/AgentRoleRunControls.cs"
             Link="TestSupport/%(Filename)%(Extension)" />
    <ProjectReference Include="../../src/Sunder.Package.Agent/Sunder.Package.Agent.csproj" Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=worker" Aliases="global,AgentWorker" />
    <ProjectReference Include="../../src/Sunder.Package.Agent/Sunder.Package.Agent.csproj" Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=app" Aliases="AgentCore,AgentApp" />
    <ProjectReference Include="../../src/Sunder.Package.Agent.Builder/Sunder.Package.Agent.Builder.csproj" Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=worker" Aliases="BuilderWorker" />
    <ProjectReference Include="../../src/Sunder.Package.Agent.Builder/Sunder.Package.Agent.Builder.csproj" Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=app" Aliases="BuilderApp" />
    <ProjectReference Include="../../src/Sunder.Package.Agent.Execution.Docker/Sunder.Package.Agent.Execution.Docker.csproj" Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=worker" Aliases="DockerWorker" />
    <ProjectReference Include="../../src/Sunder.Package.Agent.Execution.Docker/Sunder.Package.Agent.Execution.Docker.csproj" Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=app" Aliases="DockerApp" />
    <ProjectReference Include="../../src/Sunder.Package.Agent.Execution.Local/Sunder.Package.Agent.Execution.Local.csproj" Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=worker" Aliases="LocalWorker" />
    <ProjectReference Include="../../src/Sunder.Package.Agent.Execution.Local/Sunder.Package.Agent.Execution.Local.csproj" Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=app" Aliases="LocalApp" />
    <ProjectReference Include="../../src/Sunder.Package.Agent.Tools.Files/Sunder.Package.Agent.Tools.Files.csproj" Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=worker" Aliases="FilesWorker" />
    <ProjectReference Include="../../src/Sunder.Package.Agent.Tools.Shell/Sunder.Package.Agent.Tools.Shell.csproj" Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=worker" Aliases="ShellWorker" />
    <ProjectReference Include="../../src/Sunder.Package.Agent.Tools.Web/Sunder.Package.Agent.Tools.Web.csproj" Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=worker" Aliases="WebWorker" />
    <ProjectReference Include="../../src/Sunder.Package.Agent.Memory.Semantic/Sunder.Package.Agent.Memory.Semantic.csproj" Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=worker" Aliases="MemoryWorker" />
    <ProjectReference Include="../../src/Sunder.Package.Agent.Memory.Semantic/Sunder.Package.Agent.Memory.Semantic.csproj" Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=app" Aliases="MemoryApp" />
    <ProjectReference Include="../../src/Sunder.Package.Agent.Mcp/Sunder.Package.Agent.Mcp.csproj" Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=worker" Aliases="McpWorker" />
    <ProjectReference Include="../../src/Sunder.Package.Agent.Mcp/Sunder.Package.Agent.Mcp.csproj" Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=app" Aliases="McpApp" />
    <ProjectReference Include="../../src/Sunder.Package.Agent.Skills/Sunder.Package.Agent.Skills.csproj" Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=worker" Aliases="SkillsWorker" />
    <ProjectReference Include="../../src/Sunder.Package.Agent.Skills/Sunder.Package.Agent.Skills.csproj" Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=app" Aliases="SkillsApp" />
    <ProjectReference Include="../../src/Sunder.Package.Agent.Subagents/Sunder.Package.Agent.Subagents.csproj" Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=worker" Aliases="SubagentsWorker" />
    <ProjectReference Include="../../src/Sunder.Package.Agent.Subagents/Sunder.Package.Agent.Subagents.csproj" Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=app" Aliases="SubagentsPackage,SubagentsApp" />
    <ProjectReference Include="../../src/Sunder.Package.Agent.Provider.Anthropic/Sunder.Package.Agent.Provider.Anthropic.csproj" Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=worker" Aliases="AnthropicWorker" />
    <ProjectReference Include="../../src/Sunder.Package.Agent.Provider.Anthropic/Sunder.Package.Agent.Provider.Anthropic.csproj" Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=app" Aliases="AnthropicApp" />
    <ProjectReference Include="../../src/Sunder.Package.Agent.Provider.Gemini/Sunder.Package.Agent.Provider.Gemini.csproj" Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=worker" Aliases="GeminiWorker" />
    <ProjectReference Include="../../src/Sunder.Package.Agent.Provider.Gemini/Sunder.Package.Agent.Provider.Gemini.csproj" Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=app" Aliases="GeminiApp" />
    <ProjectReference Include="../../src/Sunder.Package.Agent.Provider.LMStudio/Sunder.Package.Agent.Provider.LMStudio.csproj" Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=worker" Aliases="LMStudioWorker" />
    <ProjectReference Include="../../src/Sunder.Package.Agent.Provider.LMStudio/Sunder.Package.Agent.Provider.LMStudio.csproj" Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=app" Aliases="LMStudioApp" />
    <ProjectReference Include="../../src/Sunder.Package.Agent.Provider.OpenAI/Sunder.Package.Agent.Provider.OpenAI.csproj" Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=worker" Aliases="OpenAiWorker" />
    <ProjectReference Include="../../src/Sunder.Package.Agent.Provider.OpenAI/Sunder.Package.Agent.Provider.OpenAI.csproj" Targets="GetSunderPackageRoleReference" AdditionalProperties="SunderPackageReferenceRole=app" Aliases="OpenAiApp" />
    <ProjectReference Include="../Sunder.Package.Agent.TestSupport/Sunder.Package.Agent.TestSupport.csproj" />
    <ProjectReference Include="../Sunder.Package.Agent.TestSupport.Avalonia/Sunder.Package.Agent.TestSupport.Avalonia.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Anthropic" />
    <PackageReference Include="Google.GenAI" />
    <PackageReference Include="OpenAI" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <Reference Include="Sunder.Package.Format" HintPath="$(PkgSunder_Package_Build)/tasks/net10.0/Sunder.Package.Format.dll" />
  </ItemGroup>
  <Import Project="../RegressionTestHarness.props" />
  <Import Project="../PackageContextFixtures.props" />
  <Target Name="RecordFixtureToolLocation" AfterTargets="Build">
    <WriteLinesToFile File="$(TargetDir)sunder-build-task-path.txt"
                      Lines="$(PkgSunder_Package_Build)/tasks/net10.0/Sunder.Package.Build.dll"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
