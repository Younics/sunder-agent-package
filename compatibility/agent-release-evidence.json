  "decisions": [
    {
      "id": "B1",
      "surface": "workspace-path-migrator",
      "decision": "retain",
      "reason": "Released in Agent 1.0.5 through 1.0.7 and still required to migrate target-owned durable workspace paths."
    },
    {
      "id": "B2",
      "surface": "legacy-file-search",
      "decision": "remove",
      "reason": "Product-approved Phase 2 clean break. The facet was absent from every inspected released Contracts DLL, had no durable selector, and Local and Docker already implement structured-file-search."
    },
    {
      "id": "B3",
      "surface": "working-summary",
      "decision": "retain",
      "reason": "AgentWorkingSummaryRecord is present in every released Contracts DLL and is backed by durable session projection state."
    },
    {
      "id": "B4.local-shell-array",
      "surface": "Local bare shell array",
      "decision": "retain-reader",
      "reason": "A public predecessor wrote the durable array; current writes use the versioned document."
    },
    {
      "id": "B4.subagent-array",
      "surface": "Subagent top-level array",
      "decision": "retain-reader",
      "reason": "A public predecessor wrote the durable array; current writes use the versioned document."
    },
    {
      "id": "B4.selected-session",
      "surface": "Global selected-session key",
      "decision": "reset",
      "reason": "Released state is cleared or ignored and can never select a session in the workspace-scoped model."
    },
    {
      "id": "B4.unassigned-workspace",
      "surface": "Unassigned Sessions sentinel",
      "decision": "retain-reader",
      "reason": "Released durable Agent databases can contain the sentinel and must not appear silently empty."
    },
    {
      "id": "B4.lifecycle-ordering",
      "surface": "Legacy lifecycle ordering keys",
      "decision": "retain-reader",
      "reason": "Released durable outbox events can carry predecessor ordering keys; replay barriers retain deterministic handling."
    },
    {
      "id": "B4.docker-catalog",
      "surface": "Docker legacy catalog, tagless, and needs-attention state",
      "decision": "retain-reader",
      "reason": "Released Docker state is preserved and surfaced for explicit remediation rather than silently replaced."
    },
    {
      "id": "B4.checkpoint-enum",
      "surface": "Legacy checkpoint enum values",
      "decision": "retain-reader",
      "reason": "Released durable checkpoints remain readable through the current projection policy."
    },
    {
      "id": "B4.fast-model-id",
      "surface": "Provider -fast model IDs",
      "decision": "normalize",
      "reason": "Released profile/configuration records can persist predecessor model IDs."
    },
    {
      "id": "B4.mcp-name-id",
      "surface": "MCP name-based tool IDs",
      "decision": "retain-unambiguous-reader",
      "reason": "Released sessions/tool state can contain name-based IDs; ambiguous aliases reject."
    },
    {
      "id": "B4.child-suspension-backend",
      "surface": "BackendId-only child suspension",
      "decision": "retain-reader",
      "reason": "Released durable child suspension records can contain only BackendId."
    },
    {
      "id": "B5",
      "surface": "Current unmanaged package source adoption",
      "decision": "retain-explicit-current-source-adoption",
      "reason": "The explicit Registry operation remains available for current unmanaged packages. Agent does not infer provenance, scan historical roots, or adopt pre-V1 package records."
    }
  ]
}
